<!--/* In the name of God, the Merciful, the Compassionate */-->
@using Microsoft.AspNetCore.Components
@using SQLTriage.Data
@using SQLTriage.Data.Services
@inject ToastService ToastService
@implements IDisposable

<div class="toast-container">
    @* pages-r1-07 (honesty hunt, 2026-08-28): the flood mute suppressed EVERY alert toast for
       five minutes, criticals included, and a repo-wide grep for IsMuted/MutedUntil found no
       render site anywhere in the tree - the state was invisible, and the nav bell renders an
       unrelated flag. This badge is that render site. It is inside the toast container so it sits
       exactly where the suppressed toasts would have been. *@
    @* NO CONTROL ON THIS BADGE, deliberately. It shipped for one gate round with a close button
       wired to the toast service's un-mute method. That service is AddSingleton
       (Data/ServiceCollectionExtensions.cs), this container is in the ALWAYS-RENDERED shell
       (MainLayout), and the button sat outside every ShellGate - so an ungated control on every
       route, AccessDenied pages included, cleared the flood mute and zeroed the withheld count for
       every open circuit. RbacShellBoundaryCensusTests named it. The badge is a disclosure, not a
       switch: it states what is being withheld, and it clears itself when the mute lapses. *@
    @if (ToastService.IsMuted)
    {
        <div class="toast toast-warning show" role="status">
            <i class="toast-icon fa-solid fa-bell-slash"></i>
            <div class="toast-content">
                <div class="toast-title">Alert toasts muted</div>
                <div class="toast-message">@MuteBadgeMessage()</div>
            </div>
        </div>
    }

    @* Toast stack — renders bottom-up via flex-direction:column-reverse *@
    @foreach (var toast in _toasts)
    {
        <div class="toast toast-@toast.Type.ToString().ToLower() @(toast.IsVisible ? "show" : "") @(toast.IsAlert ? "toast-alert-size" : "")"
             @key="toast.Id">
            <i class="toast-icon @GetIcon(toast.Type)"></i>
            <div class="toast-content">
                <div class="toast-title">@toast.Title</div>
                @if (!string.IsNullOrEmpty(toast.Message))
                {
                    <div class="toast-message">@toast.Message</div>
                }
            </div>
            <button class="toast-close" @onclick="() => RemoveToast(toast.Id)">&times;</button>
        </div>
    }
</div>

@* Floating bottom-right status badges removed 2026-05-29 (CLIPPY redesign):
   the red No-Pants FAB and the mute badge were distracting clutter. No-Pants
   state is shown by its nav switch; notifications now have a dedicated nav
   switch (NavMenu → bottom toggle group). Flood-muting still works silently;
   it just no longer paints a floating badge. *@

@code {
    private List<ToastNotification> _toasts = new();

    // Flood detection: track how many alert toasts arrived in the last 5 seconds
    private readonly System.Collections.Generic.Queue<DateTime> _recentAlerts = new();
    private const int FloodThreshold = 5;
    private const int FloodWindowSeconds = 5;
    private const int MuteMinutes = 5;

    /// <summary>
    /// The badge's text. Names how many alerts the mute has actually swallowed, so the operator
    /// can see the size of what they are not being shown rather than only that something is off.
    ///
    /// <para>Read at render time, which is why <see cref="ToastService.MuteStateChanged"/> exists.
    /// A suppressed alert returns from <c>ToastService.Show</c> BEFORE <c>OnShow</c> is raised, so
    /// nothing here re-rendered while the flood was being dropped: the badge painted "No alerts
    /// have been withheld yet." for the whole five minutes it was withholding them. The service now
    /// announces every count change and this component repaints on it.</para>
    /// </summary>
    private string MuteBadgeMessage()
    {
        var remaining = ToastService.MutedUntil - DateTime.UtcNow;
        var mins = Math.Max(0, (int)Math.Ceiling(remaining.TotalMinutes));
        var suppressed = ToastService.SuppressedAlertCount;

        var withheld = suppressed == 0
            ? "No alerts have been withheld yet."
            : suppressed == 1
                ? "1 alert has been withheld so far."
                : $"{suppressed} alerts have been withheld so far.";

        return $"An alert flood paused alert toasts, criticals included, for about {mins} more "
             + $"minute(s). {withheld} Alerts keep firing: see the Alerts page and any configured "
             + "email or Teams notifications.";
    }

    /// <summary>
    /// Repaints the badge whenever the service's mute state or withheld count moves. This is the
    /// only thing that keeps <see cref="MuteBadgeMessage"/> honest DURING a flood: the alerts being
    /// dropped never reach OnShow, so without this the count freezes at whatever it was when the
    /// badge last rendered - which is zero.
    /// </summary>
    private void OnMuteStateChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Re-renders when the mute lapses so the badge clears itself. Same Task.Delay idiom this
    /// component already uses to retire a toast.
    /// </summary>
    private void ScheduleMuteExpiryRender()
    {
        var delay = ToastService.MutedUntil - DateTime.UtcNow;
        if (delay <= TimeSpan.Zero) return;

        _ = Task.Delay(delay + TimeSpan.FromSeconds(1))
            .ContinueWith(_ => InvokeAsync(StateHasChanged));
    }

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
        ToastService.MuteStateChanged += OnMuteStateChanged;
    }

    private void ShowToast(ToastNotification toast)
    {
        InvokeAsync(() =>
        {
            if (toast.IsAlert)
            {
                // Flood detection
                var now = DateTime.UtcNow;
                _recentAlerts.Enqueue(now);
                while (_recentAlerts.Count > 0 && (now - _recentAlerts.Peek()).TotalSeconds > FloodWindowSeconds)
                    _recentAlerts.Dequeue();

                if (_recentAlerts.Count >= FloodThreshold && !ToastService.IsMuted)
                {
                    // Toast storm - mute alerts for MuteMinutes. pages-r1-07: this used to be
                    // SILENT. It now announces itself through a channel the mute cannot swallow,
                    // paints the badge above for as long as it lasts, and schedules a re-render at
                    // expiry so the badge clears itself.
                    ToastService.MuteFor(MuteMinutes);
                    ToastService.ShowSuppressionNotice(
                        "Alert toasts muted",
                        $"{FloodThreshold} or more alerts arrived within {FloodWindowSeconds} seconds. "
                        + $"Alert toasts are paused for {MuteMinutes} minutes, criticals included. "
                        + "Alerts keep firing: see the Alerts page, and any email or Teams "
                        + "notifications configured for them.");

                    ScheduleMuteExpiryRender();
                    StateHasChanged();
                    return; // don't show this toast — already muted
                }
            }

            _toasts.Add(toast);
            toast.IsVisible = true;
            StateHasChanged();

            _ = Task.Delay(toast.Duration).ContinueWith(_ =>
                InvokeAsync(() => RemoveToast(toast.Id)));
        });
    }

    private void RemoveToast(string id)
    {
        var toast = _toasts.FirstOrDefault(t => t.Id == id);
        if (toast != null)
        {
            toast.IsVisible = false;
            StateHasChanged();
            _ = Task.Delay(300).ContinueWith(_ =>
                InvokeAsync(() =>
                {
                    _toasts.Remove(toast);
                    StateHasChanged();
                }));
        }
    }

    private static string GetIcon(ToastType type) => type switch
    {
        ToastType.Success => "fa-solid fa-check",
        ToastType.Error   => "fa-solid fa-xmark",
        ToastType.Warning => "fa-solid fa-triangle-exclamation",
        ToastType.Info    => "fa-solid fa-circle-info",
        _                 => "fa-solid fa-circle-info"
    };

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
        ToastService.MuteStateChanged -= OnMuteStateChanged;
    }
}
