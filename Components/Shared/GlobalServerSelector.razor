<!--/* In the name of God, the Merciful, the Compassionate */-->
@using SQLTriage.Data
@using SQLTriage.Data.Services
@using System.Linq
@implements IDisposable
@inject IServerContextService ServerContext
@inject ServerConnectionManager ConnectionManager
@inject AppUserState UserState
@inject NavigationManager Navigation

@if (_servers.Count > 0)
{
    <div class="global-server-selector" style="display:flex; align-items:center; gap:8px;">
        <div class="gss-label" style="font-size:11px; font-weight:700; color:var(--text-muted); letter-spacing:0.05em; text-transform:uppercase;">Connected to:</div>
        @* RULED 2026-08-02 (round 6). This selector is rendered by MainLayout, so it is on EVERY
           route including the AccessDenied pages, and the "current server" it sets is PROCESS-WIDE
           (ServerContextService writes ServerConnectionManager.CurrentServer, a singleton). One
           circuit's dropdown therefore re-points the instance the NEXT operator's run will hit.
           Same permission and same argument as the DashboardToolbar instance dropdown:
           execute_checks — whoever may run a check may choose its target; whoever may run nothing
           may not retarget it. A denied caller still SEES which server is current. *@
        <ShellGate Permission="execute_checks">
            <select value="@SelectedServer" @onchange="OnServerChanged" class="gss-dropdown" style="background:transparent; border:none; color:var(--text-primary); font-weight:600; font-size:14px; cursor:pointer; outline:none;">
                <option value="">(Select a server)</option>
                @foreach (var srv in _servers)
                {
                    <option value="@srv.Id">@srv.ServerNames</option>
                }
            </select>
        </ShellGate>
        @if (!MaySelectInstance)
        {
            <span style="color:var(--text-primary); font-weight:600; font-size:14px;">@CurrentServerName</span>
        }
        @if (!string.IsNullOrEmpty(SelectedServer))
        {
            <span style="color:var(--text-secondary); font-size:14px; font-weight:600;">(@ServerContext.CurrentDatabase)</span>
        }
        <button class="nav-arrow-btn" title="Manage Servers" @onclick='() => Navigation.NavigateTo("/servers")' style="background:transparent; border:none; color:var(--text-secondary); cursor:pointer; margin-left: 8px;">
            <i class="fa-solid fa-server"></i>
        </button>
    </div>
}

@code {
    /// <summary>Retargets the PROCESS-WIDE current instance — see the note beside the dropdown.</summary>
    private bool MaySelectInstance => UserState != null && UserState.IsAuthorized("execute_checks");

    private List<SQLTriage.Data.Models.ServerConnection> _servers = new();

    private string? SelectedServer => ServerContext.CurrentServerId;

    /// <summary>What a denied caller sees instead of the picker: the current server, read-only.</summary>
    private string CurrentServerName =>
        _servers.FirstOrDefault(s => s.Id == ServerContext.CurrentServerId)?.ServerNames
        ?? "(none selected)";

    private async Task OnServerChanged(ChangeEventArgs e)
    {
        if (!MaySelectInstance) return;
        var val = e.Value?.ToString();
        await ServerContext.SetServerAsync(
            string.IsNullOrEmpty(val) ? null : val,
            ConnectionRetargetGrant.ForCaller(UserState, "execute_checks"));
    }

    protected override void OnInitialized()
    {
        _servers = ConnectionManager.GetConnections();
        ServerContext.OnServerChanged += RefreshState;
        ServerContext.OnDatabaseChanged += RefreshState;

        // Default to the first configured server instead of (None) — showing some data beats none.
        // "Only when nothing has been selected yet" used to be tested against CurrentServerId,
        // which is this SCOPED service's own field: in a second tab it is always empty, so the
        // bootstrap fired and moved the PROCESS-WIDE connection onto _servers[0] for everybody.
        // ConnectionRetargetGrant.Establish moves that test to the manager, which holds the value
        // that actually decides, and SetServerAsync then adopts whatever holds.
        if (string.IsNullOrEmpty(ServerContext.CurrentServerId) && _servers.Count > 0)
            _ = ServerContext.SetServerAsync(_servers[0].Id, ConnectionRetargetGrant.Establish);
    }

    private void RefreshState()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ServerContext.OnServerChanged -= RefreshState;
        ServerContext.OnDatabaseChanged -= RefreshState;
    }
}
