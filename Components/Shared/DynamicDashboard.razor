    /// <summary>Returns true when a SqlException is caused by query cancellation (navigation away),
    /// not a real SQL error. Suppresses false ERR log entries on dashboard navigation.</summary>
    private static bool IsCancellationException(Exception ex, CancellationToken ct)
    {
        if (ct.IsCancellationRequested) return true;
        // SqlException wraps "Operation cancelled by user" as error number 0 / severity >= 20
        if (ex is Microsoft.Data.SqlClient.SqlException sqlEx)
        {
            var msg = sqlEx.Message;
            return msg.Contains("Operation cancelled", StringComparison.OrdinalIgnoreCase)
                || msg.Contains("cancelled by user", StringComparison.OrdinalIgnoreCase)
                || msg.Contains("severe error", StringComparison.OrdinalIgnoreCase);
        }
        return ex.InnerException != null && IsCancellationException(ex.InnerException, ct);
    }

    /// <summary>Guards InvokeAsync(StateHasChanged) calls — no-ops after disposal to prevent
    /// WebView2 "removeChild on null" / render-batch-sequence errors.</summary>
    private Task SafeStateHasChanged()
    {
        if (_disposed) return Task.CompletedTask;
        try { return InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { return Task.CompletedTask; }
        catch (InvalidOperationException) { return Task.CompletedTask; }
    }

    public void Dispose()
    {
        _disposed = true;
        Logger.LogInformation("[DynamicDashboard:{DashboardId}] Starting disposal", DashboardId);
        LocalLogger.LogInfo($"[DynamicDashboard:{DashboardId}] Starting disposal");
        
        // Dispose DataTables to prevent memory leaks
        var gridCount = _gridResults.Count;
        foreach (var dt in _gridResults.Values)
        {
            dt?.Dispose();
        }
        _gridResults.Clear();
        
        // Clear all data dictionaries to free memory
        var tsCount = _timeSeriesResults.Count;
        var statCount = _statResults.Count;
        var bgCount = _barGaugeResults.Count;
        var checkCount = _checkResults.Count;
        var errorCount = _panelErrors.Count;
        
        _timeSeriesResults.Clear();
        _statResults.Clear();
        _barGaugeResults.Clear();
        _checkResults.Clear();
        _panelErrors.Clear();
        
        // Cancel and dispose any in-flight query load
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;

        // Unsubscribe from events without stopping RefreshService (affects all dashboards)
        RefreshService.OnRefresh -= OnAutoRefresh;
        ConfigService.OnConfigChanged -= OnConfigChanged;
        InstanceSelector.OnInstanceChanged -= OnGlobalInstanceChanged;
        UserSettings.OnNoPantsModeChanged -= OnNoPantsModeChanged;
        
        Logger.LogInformation("[DynamicDashboard:{DashboardId}] Disposed successfully - Cleared: {GridCount} grids, {TsCount} timeseries, {StatCount} stats, {BgCount} bargauges, {CheckCount} checks, {ErrorCount} errors", 
            DashboardId, gridCount, tsCount, statCount, bgCount, checkCount, errorCount);
        LocalLogger.LogInfo($"[DynamicDashboard:{DashboardId}] Disposed - Memory freed");
        System.Diagnostics.Debug.WriteLine($"[DynamicDashboard] Disposed dashboard '{DashboardId}'. Memory freed.");
    }

    /// <summary>
    /// Resolves the display colour for a numeric panel value.
    /// Prefers the panel's inline ColorThresholds list; falls back to the
    /// named ThresholdConfig entry (StatThresholdKey / BarGaugeThresholdKey).
    /// </summary>
    private static string ResolveColor(PanelDefinition panel, double value)
    {
        if (panel.ColorThresholds?.Count > 0)
            return panel.GetThresholdColor(value);
        var key = panel.StatThresholdKey ?? panel.BarGaugeThresholdKey ?? "";
        return ThresholdConfig.GetColor(key, value);
    }

    private static TimeSeriesPoint MapTimeSeriesPoint(IDataReader reader) => new()
    {
        Time = reader["Time"] as DateTime? ?? DateTime.MinValue,
        Series = reader["Series"]?.ToString() ?? "",
        Value = reader["Value"] != DBNull.Value ? Convert.ToDouble(reader["Value"]) : 0.0
    };

    // ── Baseline Comparison ──

    private async Task LoadBaselineDataAsync(DashboardFilter currentFilter)
    {
        var baselineResults = new ConcurrentDictionary<string, List<TimeSeriesPoint>>();
        var shift = TimeSpan.FromDays(7);
        var instanceKey = CachingQueryExecutor.BuildInstanceKey(currentFilter);

        var tsPanels = _enabledPanelsCache?.Where(p => p.PanelType == "TimeSeries") ?? Enumerable.Empty<PanelDefinition>();

        foreach (var panel in tsPanels)
        {
            try
            {
                var baselineFrom = currentFilter.TimeFrom - shift;
                var baselineTo = currentFilter.TimeTo - shift;
                var cached = await CacheStore.GetTimeSeriesAsync(panel.Id, instanceKey, baselineFrom, baselineTo);

                if (cached.Count > 0)
                {
                    // Shift timestamps forward by 7 days to align with current range
                    var shifted = cached.Select(p => new TimeSeriesPoint
                    {
                        Time = p.Time + shift,
                        Series = p.Series,
                        Value = p.Value
                    }).ToList();
                    baselineResults[panel.Id] = shifted;
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Failed to load baseline for panel {PanelId}", panel.Id);
            }
        }

        _baselineResults = baselineResults;
        await SafeStateHasChanged();
    }

    private void ToggleBaseline()
    {
        _showBaseline = !_showBaseline;
        if (!_showBaseline)
        {
            _baselineResults.Clear();
            StateHasChanged();
        }
        else
        {
            // Trigger baseline load with current filter
            var filter = BuildFilter();
            _ = Task.Run(async () =>
            {
                try
                {
                    await LoadBaselineDataAsync(filter);
                }
                catch (Exception ex) { Logger.LogDebug(ex, "Baseline toggle load failed"); }
            });
        }
    }

}

