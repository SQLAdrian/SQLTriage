    private async void OnAutoRefresh()
    {
        if (!AutoRefresh) 
        {
            Logger.LogDebug("[DynamicDashboard:{DashboardId}] Auto-refresh triggered but disabled, skipping", DashboardId);
            return;
        }
        
        Logger.LogDebug("[DynamicDashboard:{DashboardId}] Auto-refresh triggered", DashboardId);
        try
        {
            using var cts = new System.Threading.CancellationTokenSource();
            cts.CancelAfter(TimeSpan.FromSeconds(30));
            await InvokeAsync(async () => await LoadData(cts.Token));
            Logger.LogDebug("[DynamicDashboard:{DashboardId}] Auto-refresh completed successfully", DashboardId);
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("[DynamicDashboard:{DashboardId}] Auto-refresh cancelled due to timeout", DashboardId);
            LocalLogger.LogWarning($"[DynamicDashboard:{DashboardId}] Auto-refresh timeout");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DynamicDashboard:{DashboardId}] Auto-refresh failed: {ErrorMessage}", DashboardId, ex.Message);
            LocalLogger.LogError($"[DynamicDashboard:{DashboardId}] AutoRefresh error: {ex.Message}", ex);
            System.Diagnostics.Debug.WriteLine($"[DynamicDashboard:{DashboardId}] AutoRefresh error: {ex}");
        }
    }

    private async void OnConfigChanged()
    {
        Dashboard = ConfigService.Config.Dashboards.FirstOrDefault(d => string.Equals(d.Id, DashboardId, StringComparison.OrdinalIgnoreCase));
        RefreshPanelCaches();
        await InvokeAsync(() => LoadData());
    }

    /// <summary>Returns true when a SqlException is caused by query cancellation (navigation away),
    /// not a real SQL error. Suppresses false ERR log entries on dashboard navigation.</summary>
    private static bool IsCancellationException(Exception ex, CancellationToken ct)
    {
        if (ct.IsCancellationRequested) return true;
        // A SqlException is a cancellation only for SqlClient's own cancel messages. The former
        // "severe error" match was removed: that phrase is SQL Server's KILL/abort message, so a
        // genuine server-side KILL was being swallowed as a user cancel (no error, no banner). See
        // CancellationClassifier for the full reasoning and the exhaustive test.
        if (ex is Microsoft.Data.SqlClient.SqlException sqlEx)
            return CancellationClassifier.IsCancellationMessage(sqlEx.Message);
        return ex.InnerException != null && IsCancellationException(ex.InnerException, ct);
    }

    /// <summary>Guards InvokeAsync(StateHasChanged) calls — no-ops after disposal to prevent
    /// WebView2 "removeChild on null" / render-batch-sequence errors.</summary>
    private Task SafeStateHasChanged()
    {
        if (_disposed) return Task.CompletedTask;
        try { return InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { return Task.CompletedTask; }
        catch (InvalidOperationException) { return Task.CompletedTask; }
    }

    public void Dispose()
    {
        _disposed = true;
        Logger.LogInformation("[DynamicDashboard:{DashboardId}] Starting disposal", DashboardId);
        LocalLogger.LogInfo($"[DynamicDashboard:{DashboardId}] Starting disposal");
        
        // Dispose DataTables to prevent memory leaks
        var gridCount = _gridResults.Count;
        foreach (var dt in _gridResults.Values)
        {
            dt?.Dispose();
        }
        _gridResults.Clear();
        
        // Clear all data dictionaries to free memory
        var tsCount = _timeSeriesResults.Count;
        var statCount = _statResults.Count;
        var bgCount = _barGaugeResults.Count;
        var checkCount = _checkResults.Count;
        var errorCount = _panelErrors.Count;
        
        _timeSeriesResults.Clear();
        _statResults.Clear();
        _barGaugeResults.Clear();
        _checkResults.Clear();
        _panelErrors.Clear();
        
        // Cancel and dispose any in-flight query load
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;

        // Unsubscribe from events without stopping RefreshService (affects all dashboards)
        RefreshService.OnRefresh -= OnAutoRefresh;
        ConfigService.OnConfigChanged -= OnConfigChanged;
        InstanceSelector.OnInstanceChanged -= OnGlobalInstanceChanged;
        UserSettings.OnNoPantsModeChanged -= OnNoPantsModeChanged;
        
        Logger.LogInformation("[DynamicDashboard:{DashboardId}] Disposed successfully - Cleared: {GridCount} grids, {TsCount} timeseries, {StatCount} stats, {BgCount} bargauges, {CheckCount} checks, {ErrorCount} errors", 
            DashboardId, gridCount, tsCount, statCount, bgCount, checkCount, errorCount);
        LocalLogger.LogInfo($"[DynamicDashboard:{DashboardId}] Disposed - Memory freed");
        System.Diagnostics.Debug.WriteLine($"[DynamicDashboard] Disposed dashboard '{DashboardId}'. Memory freed.");
    }

    /// <summary>
    /// Resolves the display colour for a numeric panel value.
    /// Prefers the panel's inline ColorThresholds list; falls back to the
    /// named ThresholdConfig entry (StatThresholdKey / BarGaugeThresholdKey).
    /// </summary>
    private static string ResolveColor(PanelDefinition panel, double value)
    {
        if (panel.ColorThresholds?.Count > 0)
            return panel.GetThresholdColor(value);
        var key = panel.StatThresholdKey ?? panel.BarGaugeThresholdKey ?? "";
        return ThresholdConfig.GetColor(key, value);
    }

    private static TimeSeriesPoint MapTimeSeriesPoint(IDataReader reader) => new()
    {
        Time = reader["Time"] as DateTime? ?? DateTime.MinValue,
        Series = reader["Series"]?.ToString() ?? "",
        // A NULL measurement becomes NaN (an unmeasured instant), never a fabricated 0. The
        // caching layer drops NaN points before storing/serving, so the series shows a gap.
        Value = TimeSeriesValueMapper.MapValue(reader["Value"])
    };

    // ── Baseline Comparison ──

    private async Task LoadBaselineDataAsync(DashboardFilter currentFilter)
    {
        var baselineResults = new ConcurrentDictionary<string, List<TimeSeriesPoint>>();
        var shift = TimeSpan.FromDays(7);
        var instanceKey = CachingQueryExecutor.BuildInstanceKey(currentFilter);

        // THE WINDOW THE BASELINE ACTUALLY READS, hoisted so every measurement below is taken against
        // it and never against the toolbar's window. Measuring the toolbar window described a window
        // the baseline never opened: with retention at 8 days, a "Last 7 days" baseline reads from 14
        // days ago, so it can never cover more than a seventh of what it was asked for, and the gate
        // proved it rendering 23 hours of a 7-day comparison with every honesty surface silent.
        var baselineFrom = currentFilter.TimeFrom - shift;
        var baselineTo = currentFilter.TimeTo - shift;

        var tsPanels = (_enabledPanelsCache?.Where(p => p.PanelType == "TimeSeries") ?? Enumerable.Empty<PanelDefinition>()).ToList();

        var retainedPanelCount = 0;
        DateTime? earliestRetained = null;
        var shortPanels = new List<string>();
        var stoppedPanels = new List<string>();
        var gapPanels = new List<string>();
        var sampledPanels = new List<string>();
        var liveSourcedPanels = new List<string>();

        foreach (var panel in tsPanels)
        {
            try
            {
                var retains = CachingExecutor.RetainsHistory(panel.Id);
                if (retains) retainedPanelCount++;

                // Retained history is the source a real baseline comes from — it is the only store that
                // survives the window trim, the 24-hour eviction sweep and a restart. The live cache is
                // still consulted after it, because a panel with no retention may happen to hold part of
                // the window. Only part: CachingQueryExecutor trims cache_timeseries to filter.TimeFrom
                // after every fresh fetch, and the longest toolbar range is 7 days, so the shifted window
                // ends where the trimmed cache begins. Whatever it answers with is disclosed as coming
                // from the cache rather than passed off as a record of 7 days ago.
                var source = await CacheStore.GetMetricHistoryAsync(panel.Id, instanceKey, baselineFrom, baselineTo);
                var fromLiveCache = false;
                if (source.Count == 0)
                {
                    source = await CacheStore.GetTimeSeriesAsync(panel.Id, instanceKey, baselineFrom, baselineTo);
                    fromLiveCache = source.Count > 0;
                }

                // What this panel's comparison line spans, measured off the points that will be drawn.
                // Retained-history extents only: a live-cache extent is reported separately, because it
                // is not evidence about retention and must not be dressed up as any.
                DateTime? drawnFrom = source.Count > 0 && !fromLiveCache ? source.Min(p => p.Time) : null;
                DateTime? drawnTo = source.Count > 0 && !fromLiveCache ? source.Max(p => p.Time) : null;

                if (retains)
                {
                    var coverage = await CachingExecutor.GetRetentionCoverageAsync(
                        panel.Id, currentFilter, baselineFrom, baselineTo);
                    if (coverage.EarliestRetainedLocal is DateTime e && (earliestRetained is null || e < earliestRetained))
                        earliestRetained = e;

                    // Three separate shortfalls, because a row count and one boundary date cannot tell
                    // them apart: history that starts too late, history that STOPPED, and a window that
                    // fell in a hole with history on both sides. Measuring only the front of the window
                    // left the last two rendering in silence, which the probe proved before this line
                    // existed.
                    var shortfall = DescribeBaselineShortfall(
                        panel.Title, coverage, baselineFrom, baselineTo, drawnFrom, drawnTo);
                    if (shortfall != null) shortPanels.Add(shortfall);

                    var stoppage = DescribeBaselineStoppage(
                        panel.Title, coverage, baselineFrom, baselineTo, drawnFrom, drawnTo);
                    if (stoppage != null) stoppedPanels.Add(stoppage);

                    var gap = DescribeBaselineGap(panel.Title, coverage, baselineFrom, baselineTo);
                    if (gap != null) gapPanels.Add(gap);

                    if (coverage.IsDownsampled)
                    {
                        sampledPanels.Add(
                            $"{panel.Title} ({coverage.RowCount} retained points against a "
                            + $"{coverage.PointCap}-point chart limit)");
                    }
                }

                if (fromLiveCache)
                {
                    liveSourcedPanels.Add(
                        $"{panel.Title} (drawn {source.Min(p => p.Time):d MMM yyyy HH:mm} to "
                        + $"{source.Max(p => p.Time):d MMM yyyy HH:mm})");
                }

                if (source.Count > 0)
                {
                    // Shift timestamps forward by 7 days to align with current range
                    var shifted = source.Select(p => new TimeSeriesPoint
                    {
                        Time = p.Time + shift,
                        Series = p.Series,
                        Value = p.Value
                    }).ToList();
                    baselineResults[panel.Id] = shifted;
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Failed to load baseline for panel {PanelId}", panel.Id);
            }
        }

        _baselineResults = baselineResults;
        _baselineNotice = _showBaseline
            ? BuildBaselineNotice(
                baselineResults.IsEmpty, tsPanels.Count, retainedPanelCount, earliestRetained, DateTime.Now,
                new BaselineWindowCoverage(
                    baselineFrom, baselineTo, shortPanels, sampledPanels, liveSourcedPanels,
                    stoppedPanels, gapPanels))
            : "";
        await SafeStateHasChanged();
    }

    /// <summary>
    /// What the Baseline overlay drew, measured against the window it was asked for. The window is the
    /// SHIFTED one (7 days before the toolbar range), because that is the only window the baseline read
    /// and so the only one an honest notice can describe. Lists are per-panel and empty means whole.
    /// </summary>
    internal readonly record struct BaselineWindowCoverage(
        DateTime WindowFrom,
        DateTime WindowTo,
        IReadOnlyList<string> ShortPanels,
        IReadOnlyList<string> SampledPanels,
        IReadOnlyList<string> LiveCachePanels,
        IReadOnlyList<string>? StoppedPanels = null,
        IReadOnlyList<string>? GapPanels = null)
    {
        /// <summary>Whole coverage: a baseline with nothing to disclose.</summary>
        public static BaselineWindowCoverage Whole(DateTime windowFrom, DateTime windowTo)
            => new(windowFrom, windowTo, Array.Empty<string>(), Array.Empty<string>(), Array.Empty<string>());

        /// <summary>Panels whose retained history stopped before the window closed. Never null to a
        /// reader, so a caller that measured only the front of the window reads as "none", which is
        /// what it in fact knows.</summary>
        public IReadOnlyList<string> Stopped => StoppedPanels ?? Array.Empty<string>();

        /// <summary>Panels whose window fell in a hole in their retained history.</summary>
        public IReadOnlyList<string> Gapped => GapPanels ?? Array.Empty<string>();
    }

    /// <summary>
    /// One panel's baseline shortfall, or null when its retained history reaches the start of the
    /// shifted window. The predicate is retention's own <see cref="RetentionCoverage.IsShortOfWindow"/>:
    /// history that BEGINS after the window opened cannot have recorded the earlier part of it, whatever
    /// the chart looks like. Two stored dates decide it, with no tolerance and no threshold, so the
    /// notice cannot drift into an opinion about how thin is too thin.
    /// </summary>
    internal static string? DescribeBaselineShortfall(
        string title, RetentionCoverage coverage, DateTime windowFrom, DateTime windowTo,
        DateTime? drawnFrom, DateTime? drawnTo)
    {
        if (!coverage.IsShortOfWindow(windowFrom)) return null;

        if (drawnFrom is null || drawnTo is null)
            return $"{title} (nothing retained for that window)";

        return $"{title} ({DescribeSpan(drawnTo.Value - drawnFrom.Value)} of the "
             + $"{DescribeSpan(windowTo - windowFrom)} asked for, from {drawnFrom.Value:d MMM yyyy HH:mm})";
    }

    /// <summary>
    /// One panel's baseline shortfall at the OTHER end, or null when its retained history runs past the
    /// close of the shifted window. The mirror of <see cref="DescribeBaselineShortfall"/> and a fact it
    /// cannot see: a panel whose collector went quiet has history reaching well past the start of the
    /// window and none at the end of it, so the start predicate reports nothing while the comparison
    /// line stops halfway across the chart.
    ///
    /// <para>Proved live before it was written, through the production store and these builders: with
    /// the retention window widened past the shift, which <c>MetricRetention:WindowDays</c> already
    /// allows, a panel that stopped recording 7.4 days ago drew 14 hours 10 minutes of a 24-hour
    /// comparison and every honesty surface stayed silent. That is the same bar ruling 4 set.</para>
    ///
    /// <para>It cannot over-fire, by arithmetic rather than by tuning: the baseline window always
    /// closes at least 7 days in the past, so a running collector's newest sample is always later than
    /// it. The predicate fires only for a panel that recorded nothing across those 7 days or more.</para>
    /// </summary>
    internal static string? DescribeBaselineStoppage(
        string title, RetentionCoverage coverage, DateTime windowFrom, DateTime windowTo,
        DateTime? drawnFrom, DateTime? drawnTo)
    {
        // The front of the window comes first and owns the whole panel: a panel that has nothing until
        // after the window opened has one problem, not two, and naming it twice would read as two.
        if (coverage.IsShortOfWindow(windowFrom)) return null;
        if (!coverage.EndsBeforeWindowCloses(windowTo)) return null;

        var stopped = coverage.LatestRetainedLocal!.Value;

        if (drawnFrom is null || drawnTo is null)
            return $"{title} (nothing retained after {stopped:d MMM yyyy HH:mm})";

        return $"{title} ({DescribeSpan(drawnTo.Value - drawnFrom.Value)} of the "
             + $"{DescribeSpan(windowTo - windowFrom)} asked for, recording stopped "
             + $"{stopped:d MMM yyyy HH:mm})";
    }

    /// <summary>
    /// One panel whose baseline window fell in a hole in the retained history, or null. History reaches
    /// past both ends of the window and there is nothing inside it, so neither boundary predicate can
    /// see it and the panel simply draws no comparison line at all. Zero rows decides it, with no
    /// tolerance and no threshold.
    ///
    /// <para>Also proved live before it was written: a 3-day recording gap that swallowed the whole
    /// baseline window left one panel drawing no line, next to another panel's full line, and the
    /// notice said nothing. A missing line is the largest shortfall there is, so silence about it was
    /// the worst arm of the defect rather than the smallest.</para>
    /// </summary>
    internal static string? DescribeBaselineGap(
        string title, RetentionCoverage coverage, DateTime windowFrom, DateTime windowTo)
    {
        if (!coverage.WindowFallsInAGap(windowFrom, windowTo)) return null;

        return $"{title} (no retained samples inside that window, though history for it runs from "
             + $"{coverage.EarliestRetainedLocal!.Value:d MMM yyyy HH:mm} to "
             + $"{coverage.LatestRetainedLocal!.Value:d MMM yyyy HH:mm})";
    }

    /// <summary>A duration an operator reads at a glance. Two units at most, never a raw TimeSpan.</summary>
    private static string DescribeSpan(TimeSpan span)
    {
        if (span <= TimeSpan.Zero) return "no time at all";

        if (span.TotalDays >= 1)
            return span.Hours == 0 ? Plural(span.Days, "day") : $"{Plural(span.Days, "day")} {Plural(span.Hours, "hour")}";

        if (span.TotalHours >= 1)
            return span.Minutes == 0 ? Plural(span.Hours, "hour") : $"{Plural(span.Hours, "hour")} {Plural(span.Minutes, "minute")}";

        var minutes = (int)span.TotalMinutes;
        return minutes >= 1 ? Plural(minutes, "minute") : "less than a minute";
    }

    private static string Plural(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    /// <summary>
    /// The Baseline honesty text. Distinct facts, never blurred into one apology: no panel here retains
    /// history so there can never be a baseline; retention is running and the 7-day-ago window is not
    /// old enough yet, with the date it becomes real; or a baseline WAS drawn and covers only part of
    /// the window it was asked for.
    ///
    /// <para>That last branch is the one ruling 4 names directly, and it used to be silence: any
    /// non-empty baseline returned "" however thin it was. The gate proved what that hides. At the
    /// shipped 8-day retention window a "Last 7 days" baseline reads from 14 days ago, so it is
    /// arithmetically incapable of covering more than a seventh of its window, in the steady state,
    /// permanently. It rendered 23 hours 50 minutes of a 7-day comparison and said nothing. A partial
    /// baseline is now measured against the window it actually read, and says so.</para>
    ///
    /// <para>Silence still means the comparison is whole, which is the only reason the notice is worth
    /// reading. Static and pure so a test can assert each branch without a rendered dashboard.</para>
    /// </summary>
    internal static string BuildBaselineNotice(
        bool baselineEmpty, int tsPanelCount, int retainedPanelCount, DateTime? earliestRetained, DateTime now,
        BaselineWindowCoverage coverage)
    {
        if (tsPanelCount == 0) return "";

        if (!baselineEmpty) return BuildPartialBaselineNotice(coverage);

        if (retainedPanelCount == 0)
        {
            return "No data from 7 days ago is available for the selected time range, and no panel on this "
                 + "dashboard retains history. The live cache holds only the current window, so a baseline "
                 + "needs retained history that nothing here is recording.";
        }

        if (earliestRetained is null)
        {
            return "No data from 7 days ago is available yet. This dashboard retains history for "
                 + $"{retainedPanelCount} panel(s), but nothing has been recorded so far. A 7-day baseline "
                 + "becomes available 7 days after the first sample is retained.";
        }

        var available = earliestRetained.Value + TimeSpan.FromDays(7);
        var wait = available - now;
        var waitText = wait <= TimeSpan.Zero
            ? "for ranges that fall inside the retained history"
            : $"on {available:d MMM yyyy HH:mm}";

        return "No data from 7 days ago is available for the selected time range. Retained history for this "
             + $"dashboard starts at {earliestRetained.Value:d MMM yyyy HH:mm}, which is less than 7 days "
             + $"before the selected range. A baseline becomes available {waitText}. Retention records from "
             + "now on; it does not fill in the past.";
    }

    /// <summary>
    /// The text for a baseline that WAS drawn and is less than it looks. Five separate ways that
    /// happens, none of them the same fact. Short of window: retained history does not reach the start
    /// of the shifted window, so the earlier part of the comparison was never recorded. Stopped:
    /// history reaches the start but not the end, because that panel's collector went quiet. Gapped:
    /// history reaches past both ends and there is nothing inside, so the panel draws no line at all.
    /// Sampled: history reaches all the way and the chart draws a subset of it. Live-sourced: the
    /// comparison came from the volatile cache instead of retained history, and that cache is trimmed
    /// to the current window after every fresh fetch, so it is not a record of 7 days ago.
    ///
    /// <para>The first round of this fix measured only the front of the window, and a probe against
    /// these builders proved what the other two arms cost: a panel drawing 14 hours 10 minutes of a
    /// 24-hour comparison, and a panel drawing no line at all beside a full one, both in silence.</para>
    ///
    /// <para>Empty lists produce "", which is how silence keeps meaning whole.</para>
    /// </summary>
    private static string BuildPartialBaselineNotice(BaselineWindowCoverage coverage)
    {
        var parts = new List<string>();

        if (coverage.ShortPanels.Count > 0)
        {
            parts.Add(
                $"The baseline reads the same range 7 days earlier, {coverage.WindowFrom:d MMM yyyy HH:mm} to "
                + $"{coverage.WindowTo:d MMM yyyy HH:mm}. Retained history does not reach the start of that "
                + $"window for: {string.Join("; ", coverage.ShortPanels)}. The rest of those comparison lines "
                + "is not a quiet period, it was never recorded. Retention records from now on; it does not "
                + "fill in the past.");
        }

        if (coverage.Stopped.Count > 0)
        {
            parts.Add(
                $"The baseline reads the same range 7 days earlier, {coverage.WindowFrom:d MMM yyyy HH:mm} to "
                + $"{coverage.WindowTo:d MMM yyyy HH:mm}. Retained history stops before the END of that "
                + $"window for: {string.Join("; ", coverage.Stopped)}. Nothing was recorded for the rest of "
                + "it, so those comparison lines stop where the recording did.");
        }

        if (coverage.Gapped.Count > 0)
        {
            parts.Add(
                $"Nothing at all was retained inside {coverage.WindowFrom:d MMM yyyy HH:mm} to "
                + $"{coverage.WindowTo:d MMM yyyy HH:mm} for: {string.Join("; ", coverage.Gapped)}. Those "
                + "panels have no comparison line on this chart. The collector wrote nothing for that "
                + "period, either because it could not reach the server or because the query returned no "
                + "rows, and the two are not distinguishable after the fact.");
        }

        if (coverage.SampledPanels.Count > 0)
        {
            parts.Add(
                $"The baseline window holds more retained points than the chart draws for: "
                + $"{string.Join("; ", coverage.SampledPanels)}. Those comparison lines are drawn from a "
                + "subset of the retained points, spread across the whole window. Every point on them is a "
                + "real measurement, and a short spike between two of them is not on the chart.");
        }

        if (coverage.LiveCachePanels.Count > 0)
        {
            parts.Add(
                $"The baseline for {string.Join("; ", coverage.LiveCachePanels)} comes from the live cache "
                + "rather than retained history. That cache is trimmed to the current window after every "
                + "fresh fetch, so it is not a record of 7 days ago and holds only what survived the trim.");
        }

        return string.Join(" ", parts);
    }

    /// <summary>
    /// Builds the per-load retention notice for panels whose retained history starts inside the
    /// selected range — the honesty bar the retention ruling set. A retained panel with full coverage
    /// says nothing, which is how the operator can tell the difference.
    /// </summary>
    private async Task UpdateRetentionNoticeAsync(DashboardFilter filter, IEnumerable<PanelDefinition> panels)
    {
        var retainedPanels = panels.Where(p => p.PanelType == "TimeSeries" && CachingExecutor.RetainsHistory(p.Id)).ToList();
        if (retainedPanels.Count == 0)
        {
            _retentionNotice = "";
            await SafeStateHasChanged();
            return;
        }

        // History is recorded PER SERVER, so a combined multi-instance view has no history of its own
        // and never will. Saying "nothing retained yet" there would be false: the samples exist, filed
        // under each server. See MetricHistoryCollectorService.ResolveInstanceNames.
        if ((filter.Instances?.Length ?? 0) > 1)
        {
            _retentionNotice = "Retained history is recorded for one server at a time, so the combined "
                + "view has none of its own. Select a single instance to see the retained trend.";
            await SafeStateHasChanged();
            return;
        }

        var shortPanels = new List<string>();
        var sampledPanels = new List<string>();
        foreach (var panel in retainedPanels)
        {
            var coverage = await CachingExecutor.GetRetentionCoverageAsync(panel.Id, filter);

            if (coverage.IsShortOfWindow(filter.TimeFrom))
            {
                shortPanels.Add(coverage.EarliestRetainedLocal is DateTime e
                    ? $"{panel.Title} (retained from {e:d MMM yyyy HH:mm})"
                    : $"{panel.Title} (nothing retained yet)");
            }

            if (coverage.IsDownsampled)
            {
                sampledPanels.Add(
                    $"{panel.Title} ({coverage.RowCount} retained points against a "
                    + $"{coverage.PointCap}-point chart limit)");
            }
        }

        _retentionNotice = BuildRetentionNotice(shortPanels, sampledPanels);
        await SafeStateHasChanged();
    }

    /// <summary>
    /// The retention honesty text, from the two distinct ways a retained line can be less than it
    /// looks. Short of window means history does not reach back far enough and the early part of the
    /// line was never recorded. Sampled means history reaches all the way and the chart is drawing a
    /// subset of it. A panel can be both. Silence still means the line is whole, which is the only
    /// reason the notice is worth reading. Static and pure so a test can assert each branch without a
    /// rendered dashboard.
    /// </summary>
    internal static string BuildRetentionNotice(
        IReadOnlyList<string> shortPanels, IReadOnlyList<string> sampledPanels)
    {
        var parts = new List<string>();

        if (shortPanels.Count > 0)
        {
            parts.Add(
                $"Retained history does not cover the whole selected range for: {string.Join("; ", shortPanels)}. "
                + "The earlier part of those lines is not missing data, it was never recorded. Retention "
                + "started with this version and records from now on.");
        }

        if (sampledPanels.Count > 0)
        {
            parts.Add(
                $"This range holds more retained points than the chart draws for: {string.Join("; ", sampledPanels)}. "
                + "Those lines are drawn from a subset of the retained points, spread across the whole "
                + "range. Every point on them is a real measurement, and a short spike between two of "
                + "them is not on the chart. Select a shorter range to see every retained point.");
        }

        return string.Join(" ", parts);
    }

    private void ToggleBaseline()
    {
        _showBaseline = !_showBaseline;
        if (!_showBaseline)
        {
            _baselineResults.Clear();
            _baselineNotice = "";
            StateHasChanged();
        }
        else
        {
            // Trigger baseline load with current filter
            var filter = BuildFilter();
            _ = Task.Run(async () =>
            {
                try
                {
                    await LoadBaselineDataAsync(filter);
                }
                catch (Exception ex) { Logger.LogDebug(ex, "Baseline toggle load failed"); }
            });
        }
    }

}

