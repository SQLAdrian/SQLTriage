<!--/* In the name of God, the Merciful, the Compassionate */-->
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SQLTriage.Data.UserSettingsService UserSettings
@inject SQLTriage.Data.ToastService Toast
@inject ServerConnectionManager ConnectionManager
@inject SQLTriage.Data.Services.ConnectionHealthService HealthService
@inject SQLTriage.Data.Services.AppUserState UserState
@inject SQLTriage.Data.Services.DdlJournal Journal
@using SQLTriage.Data.Services
@using Microsoft.Data.SqlClient

@if (IsVisible)
{
    <div class="panel-maximize-overlay" @onclick="Close">
        <div class="query-plan-modal-content" @onclick:stopPropagation>
            <div class="panel-maximize-header">
                <span class="panel-maximize-title">Query Execution Plan</span>
                <div style="display:flex;gap:8px;align-items:center;">
                    <button class="panel-maximize-btn" style="position:static;opacity:1;"
                            @onclick="ToggleSummary" title="@(_showSummary ? "Hide Summary" : "Show Summary")">
                        <i class="fa-solid fa-chart-bar"></i>
                    </button>
                    <button class="panel-maximize-btn" style="position:static;opacity:1;"
                            @onclick="ToggleCompact" title="@(_compactView ? "Detailed View" : "Compact View")">
                        <i class="fa-solid fa-compress"></i>
                    </button>
                    <button class="panel-maximize-btn" style="position:static;opacity:1;"
                            @onclick="DownloadSqlplan" title="Download as .sqlplan (open in SSMS)">
                        <i class="fa-solid fa-file-code"></i>
                    </button>
                    <button class="panel-maximize-btn" style="position:static;opacity:1;"
                            @onclick="OpenInPlanExplorer" title="Open in Plan Explorer">
                        <i class="fa-solid fa-magnifying-glass-chart"></i>
                    </button>
                    <button class="panel-maximize-btn" style="position:static;opacity:1;"
                            @onclick="ShowOptimizationTips" title="Show Optimization Tips">
                        <i class="fa-solid fa-lightbulb"></i>
                    </button>
                    <button class="panel-maximize-btn" style="position:static;opacity:1;"
                            @onclick="SavePlan" title="Save Plan for Comparison">
                        <i class="fa-solid fa-save"></i>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(QueryText))
                    {
                        <button class="panel-maximize-btn" style="position:static;opacity:1;"
                                @onclick="ToggleQueryText" title="@(_showQueryText ? "Hide Query" : "Show Query")">
                            SQL
                        </button>
                    }
                    <button class="panel-maximize-close" @onclick="Close" title="Close"><i class="fa-solid fa-xmark"></i></button>
                </div>
            </div>

            @if (_showQueryText && !string.IsNullOrWhiteSpace(QueryText))
            {
                <div class="query-plan-sql-box">
                    <pre>@QueryText</pre>
                </div>
            }

            <!-- Search/Filter Controls -->
            <div class="plan-controls" style="display:flex;gap:8px;padding:8px;border-bottom:1px solid var(--border);">
                <input type="text" placeholder="Search operators… (highlights matching nodes)"
                       value="@_searchTerm" @oninput="OnSearchInput" style="flex:1;" />
                <button class="settings-btn" @onclick="ClearSearch" disabled="@(string.IsNullOrEmpty(_searchTerm))">Clear</button>
            </div>
            
            @* Index execution options — only shown when No-Pants mode is on *@
            @if (UserSettings.GetNoPantsMode())
            {
                <div style="display:flex;align-items:center;gap:6px;padding:4px 12px;border-bottom:1px solid var(--border);background:rgba(239,68,68,0.04);">
                    <button type="button" @onclick="() => _showNoPantsPanel = !_showNoPantsPanel"
                            title="@(_showNoPantsPanel ? "Hide index options" : "Show index options")"
                            style="background:none;border:none;cursor:pointer;padding:2px 4px;font-size:14px;color:@(_showNoPantsPanel ? "#ef4444" : "var(--text-muted)");line-height:1;">
                        <i class="fa-solid fa-person-pants-burst"></i>
                    </button>
                    <span style="font-size:11px;color:var(--text-muted);">Index options</span>
                </div>
            }
            @if (UserSettings.GetNoPantsMode() && _showNoPantsPanel)
            {
                <div class="plan-options-panel" style="display:flex;gap:12px;padding:6px 12px;border-bottom:1px solid var(--border);align-items:center;flex-wrap:wrap;background:rgba(239,68,68,0.05);">
                    <span style="font-size:11px;font-weight:600;color:var(--red);opacity:0.8;">NO-PANTS</span>
                    @* @bind:after on every option: the sidebar/copy preview is rendered from
                       ApplyIndexOptions, so a changed checkbox has to re-render it or the preview
                       goes stale against the string execution would send. *@
                    <div style="display:flex;align-items:center;gap:4px;" title="@(CanUseOnline ? "Build the index without taking the table offline" : $"ONLINE not supported on this edition (Enterprise/Developer only). Detected: {_serverEdition ?? "unknown"}")">
                        <input type="checkbox" id="idx-opt-online" @bind="_indexOptionOnline" @bind:after="RefreshOptionPreviews" disabled="@(!CanUseOnline)" />
                        <label for="idx-opt-online" style="margin:0;font-size:12px;@(CanUseOnline ? "" : "opacity:0.4;")">ONLINE</label>
                    </div>
                    <div style="display:flex;align-items:center;gap:4px;">
                        <input type="checkbox" id="idx-opt-sorttemp" @bind="_indexOptionSortInTempDb" @bind:after="RefreshOptionPreviews" />
                        <label for="idx-opt-sorttemp" style="margin:0;font-size:12px;">SORT_IN_TEMPDB</label>
                    </div>
                    <div style="display:flex;align-items:center;gap:4px;" title="@(CanUseResumable ? "Pause/resume during long index builds" : $"RESUMABLE requires Enterprise + SQL 2017+ AND ONLINE = ON. Detected: v{_serverVersion?.ToString() ?? "?"} {_serverEdition ?? "edition unknown"}")">
                        <input type="checkbox" id="idx-opt-resumable" @bind="_indexOptionResumable" @bind:after="RefreshOptionPreviews" disabled="@(!CanUseResumable)" />
                        <label for="idx-opt-resumable" style="margin:0;font-size:12px;@(CanUseResumable ? "" : "opacity:0.4;")">RESUMABLE</label>
                    </div>
                    <div style="display:flex;align-items:center;gap:4px;">
                        <label style="margin:0;font-size:12px;">MAXDOP:</label>
                        <input type="number" min="1" max="64" style="width:46px;font-size:12px;" @bind="_indexMaxDop" @bind:after="RefreshOptionPreviews" />
                    </div>
                    <div style="display:flex;align-items:center;gap:4px;">
                        <label style="margin:0;font-size:12px;">COMPRESSION:</label>
                        <select @bind="_indexCompression" @bind:after="RefreshOptionPreviews" style="width:90px;font-size:12px;">
                            <option value="NONE">NONE</option>
                            <option value="ROW">ROW</option>
                            <option value="PAGE">PAGE</option>
                        </select>
                    </div>
                    @if (_indexIsExecuting)
                    {
                        <button class="btn btn-danger btn-sm" @onclick="CancelIndexCreation">Cancel</button>
                        <span style="font-size:12px;opacity:0.8;">@_indexExecutionStatus</span>
                    }
                </div>
            }

            <div class="query-plan-modal-body" style="height: 100%; background: var(--bg-surface);">
                @* Column body: [injected statement tab bar] then this canvas+sidebar row *@
                <div class="qp-body-row">
                    <div id="qp-container" style="flex: 1; overflow: auto; position: relative;"></div>
                    <div id="qp-sidebar" style="width: 360px; flex-shrink: 0; border-left: 1px solid var(--border); overflow-y: auto; background: var(--bg-surface); padding: 0; display: none;"></div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? PlanXml    { get; set; }
    [Parameter] public string? QueryText  { get; set; }
    [Parameter] public string? ConnectionId { get; set; }
    [Parameter] public string? DatabaseName { get; set; }
    /// <summary>The specific instance the plan came from — a multi-server connection
    /// must execute index DDL on THIS server, not whichever is first in the list.</summary>
    [Parameter] public string? ServerName { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // Resolved from ConnectionHealthService when the modal opens. Used to
    // gate ONLINE / RESUMABLE checkboxes:
    //   ONLINE     — Enterprise / Developer / Evaluation only
    //   RESUMABLE  — Enterprise-class AND SQL Server 2017+ (major version >= 14)
    private int? _serverVersion;
    private string? _serverEdition;
    private bool _serverIsEnterpriseClass;
    private bool CanUseOnline    => _serverIsEnterpriseClass;
    // RESUMABLE additionally requires ONLINE = ON — SQL Server rejects the combination otherwise.
    private bool CanUseResumable => _serverIsEnterpriseClass && (_serverVersion ?? 0) >= 14 && _indexOptionOnline;

    public bool IsVisible { get; private set; }

    private bool _showQueryText = false;
    private bool _showSummary = true;
    private bool _compactView = false;
    private string _searchTerm = "";
    
    // No-pants panel visibility (collapsed by default)
    private bool _showNoPantsPanel = false;

    // Index generation options
    private bool _indexOptionOnline = true;
    private bool _indexOptionSortInTempDb = true;
    private bool _indexOptionResumable = true;
    private int _indexMaxDop = 8;
    private string _indexCompression = "NONE";
    private bool _indexOptionOptimizeForSequential = false;

    private CancellationTokenSource? _indexExecutionCts;
    private bool _indexIsExecuting;
    private string? _indexExecutionStatus;

    // ── ROLLBACK FLAG ────────────────────────────────────────────────────────
    // Set to false to instantly revert to the legacy JS-only renderer.
    private const bool UseV2Renderer = true;

    private DotNetObjectReference<QueryPlanModal>? _dotNetRef;

    public async Task ShowAsync(string xml, string? queryText = null)
    {
        PlanXml       = xml;
        QueryText     = queryText;
        _showQueryText = false;
        IsVisible     = true;

        // Resolve server capabilities from the live health-check cache so
        // we can gate ONLINE/RESUMABLE checkboxes appropriately. Falls back
        // to "unknown" (everything disabled) if the server hasn't been
        // probed yet — better than silently emitting invalid index DDL.
        ResolveServerCapabilities();

        StateHasChanged();
        await Task.Delay(50); // allow DOM to render

        if (UseV2Renderer)
        {
            try
            {
                // Apply icon set preference before rendering (guard: older published versions may not have this method)
                try { await JS.InvokeVoidAsync("queryPlanInteropV2.setUseV2Icons", UserSettings.GetUseV2PlanIcons()); } catch { }

                // Register the .NET reference UNCONDITIONALLY since 2026-09-01 (F-B). It used to be
                // gated on No-Pants mode because its only job was index EXECUTION. It now also
                // serves PreviewIndexDdl, which every reader of the plan sidebar needs — the
                // preview and copy strings are computed by the same C# method execution uses, and
                // without the ref the JS side has nothing to compute them with. Exposing the ref
                // is not exposing execution: ExecuteIndexFromOperator re-checks No-Pants mode, the
                // connection id, the run_scripts permission and then the statement shape on every
                // call — in that order, so an unauthorized caller cannot even reach a journal write.
                _dotNetRef ??= DotNetObjectReference.Create(this);
                try { await JS.InvokeVoidAsync("queryPlanInteropV2.setDotNetRef", _dotNetRef); } catch { }

                Serilog.Log.Debug("Parsing execution plan for modal: {XmlLength} chars", xml?.Length ?? 0);
                var json = ExecutionPlanParser.ParseToJson(xml ?? string.Empty);
                await JS.InvokeVoidAsync("queryPlanInteropV2.showPlan", "qp-container", json, xml);
                return;
            }
            catch (Exception ex)
            {
                Serilog.Log.Error(ex, "Failed to render execution plan in modal");
                Toast.ShowError($"Plan parsing failed: {ex.Message}");
                
                // Surface parse errors in the container instead of silently falling back
                try
                {
                    await JS.InvokeVoidAsync("queryPlanInteropV2.showParseError", "qp-container", ex.Message);
                    return;
                }
                catch
                {
                    // JS not available — fall through to legacy renderer
                }
            }
        }

        // Legacy renderer (always available as rollback)
        await JS.InvokeVoidAsync("queryPlanInterop.showPlan", "qp-container", xml);
    }

    public async Task CloseAsync()
    {
        IsVisible = false;
        PlanXml   = null;
        QueryText = null;
        _indexIsExecuting = false;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("queryPlanInteropV2.setDotNetRef", (object?)null); } catch { }
        var clearFn = UseV2Renderer ? "queryPlanInteropV2.clearPlan" : "queryPlanInterop.clearPlan";
        await JS.InvokeVoidAsync(clearFn, "qp-container");
    }

    /// <summary>
    /// F-B (ruled 2026-09-01): the ONE substitution. The sidebar's suggested-index block, the
    /// pane copy, the Copy DDL button and the recommendations banner all render through this, so
    /// the string an operator reads or pastes is byte-for-byte the string
    /// <see cref="ExecuteSingleIndex"/> sends — because it is produced by the same call.
    ///
    /// <para>WHAT WAS WRONG. queryPlanV2.js substituteDefaultOptions() carried its own hardcoded
    /// literals (ONLINE→OFF, SORT_IN_TEMPDB→ON, MAXDOP→0, DATA_COMPRESSION→NONE, RESUMABLE and
    /// OPTIMIZE_FOR_SEQUENTIAL_KEY dropped) while ApplyIndexOptions substituted the live checkbox
    /// state. The defaults are ONLINE ON / SORT_IN_TEMPDB ON / MAXDOP 8, so the preview disagreed
    /// with the executed statement on a FRESH modal with nothing touched — always-on divergence,
    /// not a corner case. Two implementations of one rule is the defect; deleting one is the fix.</para>
    ///
    /// <para>Display-only and safe to expose: it substitutes text and returns it. It opens no
    /// connection and sends nothing to a server.</para>
    /// </summary>
    [JSInvokable]
    public string PreviewIndexDdl(string? ddl) => ApplyIndexOptions(ddl ?? string.Empty);

    /// <summary>
    /// Re-renders every preview the JS layer is holding after an option changes. Without this the
    /// preview would be correct only until the operator ticked a box — which is the same class of
    /// defect F-B fixed, arriving a second later.
    /// </summary>
    private async Task RefreshOptionPreviews()
    {
        try { await JS.InvokeVoidAsync("queryPlanInteropV2.refreshOptionPreviews"); }
        catch { /* renderer not mounted, or an older published queryPlanV2.js */ }
    }

    [JSInvokable]
    public async Task ExecuteIndexFromOperator(string ddl)
    {
        if (!UserSettings.GetNoPantsMode() || string.IsNullOrEmpty(ConnectionId)) return;

        // AUTHORIZATION BEFORE ANY JOURNAL WRITE (ruled 2026-09-01; found by this lane's cold gate).
        //
        // WHAT WAS WRONG. The run_scripts check lived only inside ExecuteSingleIndex, below the two
        // statement-shape refusals. So a caller in No-Pants mode with a ConnectionId but WITHOUT
        // run_scripts could not execute anything — that stayed fail-closed — but it could reach both
        // RecordBlocked calls, each of which writes the caller's statement text, IN FULL, into the
        // tamper-evident audit chain. An unauthorized caller choosing what gets appended to the
        // audit chain is a ledger-spam vector: the chain's value is that its contents were written
        // by authorized acts, and unbounded attacker-chosen text destroys that whether or not any
        // DDL ran.
        //
        // Plain refusal, no denial record. That matches this surface's sibling — DynamicDashboard's
        // ExecuteActionSqlAsync returns "Not permitted" and journals nothing for a permission
        // refusal — and journaling the denial would reintroduce the same vector at a smaller
        // amplitude (one row per call, still caller-triggered). The shape refusals BELOW keep their
        // full journaling: by the time control reaches them the caller is authorized, so the text in
        // the chain came from someone entitled to send it.
        if (!MayCreateIndex)
        {
            Toast.ShowError("Not permitted: creating an index on a connected server requires Operator or Admin.");
            return;
        }

        // Trust boundary: this string arrives from the JS layer, which builds it from the
        // audited server's plan XML. Accept a SINGLE CREATE NONCLUSTERED INDEX statement only.
        if (string.IsNullOrWhiteSpace(ddl) ||
            !ddl.TrimStart().StartsWith("CREATE NONCLUSTERED INDEX", StringComparison.OrdinalIgnoreCase))
        {
            Toast.ShowError("Rejected: only CREATE NONCLUSTERED INDEX statements can be executed from the plan viewer.");
            Journal.RecordBlocked(
                SQLTriage.Data.AuditLogService.DdlSurfaces.IndexCreate,
                "create-index", ServerName ?? ConnectionId ?? "unknown-server", ddl ?? string.Empty,
                "Not a single CREATE NONCLUSTERED INDEX statement.");
            return;
        }
        // Backstop against DDL injection via a crafted object name (a ']' that escaped its
        // brackets could smuggle a second statement): reject any statement separator or
        // batch/comment marker beyond a single optional trailing semicolon. QUOTENAME
        // escaping in queryPlanV2.js is the primary guard; this is defense-in-depth.
        var body = ddl.Trim().TrimEnd(';');
        if (body.Contains(';') ||
            body.Contains("--") || body.Contains("/*") ||
            System.Text.RegularExpressions.Regex.IsMatch(body, @"\bGO\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
        {
            Toast.ShowError("Rejected: the generated index statement contains an unexpected statement separator or comment.");
            Serilog.Log.Warning("[QueryPlanModal] Blocked suspicious index DDL from operator: {Ddl}", ddl);
            // A refusal is the only trace that something tried, so it goes in the tamper-evident
            // chain in full — not only into a rolling Serilog file.
            Journal.RecordBlocked(
                SQLTriage.Data.AuditLogService.DdlSurfaces.IndexCreate,
                "create-index", ServerName ?? ConnectionId ?? "unknown-server", ddl,
                "Statement carried a separator, comment marker, or GO beyond one trailing semicolon.");
            return;
        }
        await ExecuteSingleIndex(ddl);
    }

    private async Task Close()
    {
        await CloseAsync();
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private void ToggleQueryText()
    {
        _showQueryText = !_showQueryText;
    }

    private async Task ToggleSummary()
    {
        _showSummary = !_showSummary;
        try
        {
            await JS.InvokeVoidAsync("eval",
                $"document.querySelector('.qp-v2-summary').style.display = '{(_showSummary ? "" : "none")}'");
        }
        catch { /* summary may not exist for this plan */ }
    }

    private async Task ToggleCompact()
    {
        _compactView = !_compactView;
        try
        {
            await JS.InvokeVoidAsync("queryPlanInteropV2.setCompactView", _compactView);
        }
        catch { /* JS not available */ }
    }

    private void ShowOptimizationTips()
    {
        var tips = new List<string>
        {
            "Consider adding missing indexes for high-impact queries.",
            "Review statistics on tables with row estimate mismatches.",
            "Avoid implicit conversions by matching data types in predicates.",
            "Use query hints sparingly; focus on schema optimization first.",
            "Monitor for spills (sort/hash) indicating memory pressure.",
            "Consider partitioning large tables for better performance."
        };

        // Could display in a modal or toast
        Toast.ShowInfo(string.Join("\n", tips), "Optimization Tips");
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        try { await JS.InvokeVoidAsync("queryPlanInteropV2.setSearchTerm", _searchTerm); }
        catch { /* JS not available */ }
    }

    private async Task ClearSearch()
    {
        _searchTerm = "";
        try { await JS.InvokeVoidAsync("queryPlanInteropV2.setSearchTerm", ""); }
        catch { /* JS not available */ }
    }

    private async Task DownloadSqlplan()
    {
        try { await JS.InvokeVoidAsync("queryPlanInteropV2.downloadSqlplan", PlanXml); }
        catch { Toast.ShowError("Download failed", "Could not save .sqlplan file"); }
    }

    private void OpenInPlanExplorer()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(PlanXml))
            {
                Toast.ShowWarning("No plan available", "Load a query plan first");
                return;
            }
            var tmpDir = Path.GetTempPath();
            var filePath = Path.Combine(tmpDir, $"SQLTriage_Plan_{DateTime.Now:yyyyMMdd_HHmmss}.sqlplan");
            File.WriteAllText(filePath, PlanXml);
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = filePath,
                UseShellExecute = true
            });
            Toast.ShowSuccess("Plan opened", "Plan Explorer should launch with the execution plan");
        }
        catch (Exception ex)
        {
            Toast.ShowError("Failed to open Plan Explorer", ex.Message);
        }
    }

    private async Task SavePlan()
    {
        if (string.IsNullOrEmpty(PlanXml)) return;

        try
        {
            // Save to local storage with timestamp
            var key = $"plan_{DateTime.Now.ToString("yyyyMMdd_HHmmss")}";
            await JS.InvokeVoidAsync("localStorage.setItem", key, PlanXml);
            Toast.ShowSuccess("Plan saved for comparison");
        }
        catch { /* JS not available */ }
    }

    // PERMISSION, component-level. Found by the round-4 COMPONENT census - a class the page census
    // is structurally blind to, because it enumerates @page routes and a shared component has no
    // route. Not in the round-4 brief and NOT driven live: found by reading the scan output, and
    // gated because of what the call is.
    // ExecuteSingleIndex runs CREATE INDEX DDL (SqlCommand.ExecuteNonQueryAsync, CommandTimeout 300)
    // against the instance the plan came from. That is run_scripts by round 3's rule - acting on a
    // connected server - and it is the same act /remediation is gated on.
    private bool MayCreateIndex => UserState.IsAuthorized("run_scripts");

    private async Task ExecuteSingleIndex(string rawDdl)
    {
        if (!MayCreateIndex) return;
        if (_indexIsExecuting) return; // prevent double-fire

        _indexIsExecuting = true;
        _indexExecutionStatus = "Creating index...";
        _indexExecutionCts = new CancellationTokenSource();
        await InvokeAsync(StateHasChanged);

        // Held outside the try so the catch blocks can journal the exact text and target that were
        // in play. Empty means the failure happened before a statement existed (no connection
        // resolved), and JournalOutcome stays silent for that — there was nothing to execute, so
        // there is no execution to record.
        var journaledDdl    = string.Empty;
        var journaledServer = string.Empty;

        try
        {
            var serverConn = ConnectionManager.GetEnabledConnections()
                .FirstOrDefault(c => c.Id == ConnectionId || c.ServerNames == ConnectionId);
            if (serverConn == null)
            {
                Toast.ShowError("Could not find server connection. Re-open the plan from a live query result.");
                return;
            }

            // Target the instance the plan came from when the host page told us;
            // fall back to the connection's first server otherwise.
            var servers = serverConn.GetServerList();
            var server  = servers.FirstOrDefault(s => !string.IsNullOrEmpty(ServerName)
                              && s.Equals(ServerName, StringComparison.OrdinalIgnoreCase))
                          ?? servers.FirstOrDefault() ?? "";
            var connStr = serverConn.GetConnectionString(server, DatabaseName ?? "master");
            var ddl     = ApplyIndexOptions(rawDdl);
            journaledDdl    = ddl;
            journaledServer = server;

            // F-A / ruling R1 (2026-09-01): journal BEFORE the statement is sent. RecordAttempt
            // flushes, so the exact text is on disk before the server sees it. Until this lane the
            // surface created indexes on client instances and wrote no record to either register.
            Journal.RecordAttempt(
                SQLTriage.Data.AuditLogService.DdlSurfaces.IndexCreate,
                "create-index", server, ddl,
                $"Database={DatabaseName ?? "master"}; ConnectionId={ConnectionId}");

            using var sqlConn = new SqlConnection(connStr);
            await sqlConn.OpenAsync(_indexExecutionCts.Token);
            using var cmd = new SqlCommand(ddl, sqlConn);
            // F-C (ruled 2026-09-01): was 0 — unbounded, so a build that never finished held this
            // circuit's operation open with no ceiling and no way back except the Cancel button.
            // 300s matches this surface's own sibling (DynamicDashboard's action path). PROVISIONAL:
            // the real number is the queued PerCheckTimeout lane's to set, not this lane's. Cancel
            // still works and is the right tool for a legitimately long online build.
            cmd.CommandTimeout = 300;
            await cmd.ExecuteNonQueryAsync(_indexExecutionCts.Token);

            await JournalOutcome(SQLTriage.Data.AuditLogService.DdlOutcomes.Succeeded, journaledServer, journaledDdl);
            _indexExecutionStatus = "Done";
            Toast.ShowSuccess("Index created successfully");
        }
        catch (OperationCanceledException)
        {
            // Cancelled, not failed: CREATE INDEX may have been part-way through on the server, so
            // the journal says the server-side effect is unknown rather than claiming nothing ran.
            await JournalOutcome(SQLTriage.Data.AuditLogService.DdlOutcomes.Cancelled, journaledServer, journaledDdl);
            _indexExecutionStatus = "Cancelled";
            Toast.ShowWarning("Index creation cancelled");
        }
        catch (Exception ex)
        {
            await JournalOutcome(SQLTriage.Data.AuditLogService.DdlOutcomes.Failed, journaledServer, journaledDdl, ex.Message);
            _indexExecutionStatus = "Failed";
            Serilog.Log.Error(ex, "Failed to create index from operator");
            Toast.ShowError($"Index creation failed: {ex.Message}");
        }
        finally
        {
            _indexIsExecuting = false;
            _indexExecutionCts?.Dispose();
            _indexExecutionCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Writes the terminal state for an index-create attempt. Silent when no statement was ever
    /// built — journaling a phantom execution would be worse than journaling nothing.
    /// </summary>
    private async Task JournalOutcome(string outcome, string server, string ddl, string? error = null)
    {
        if (string.IsNullOrEmpty(ddl)) return;
        await Journal.RecordOutcomeAsync(
            SQLTriage.Data.AuditLogService.DdlSurfaces.IndexCreate,
            "create-index", server, ddl, outcome, error);
    }

    /// <summary>
    /// The option substitution, for BOTH the preview and the execution — they are the same call.
    /// The rule itself lives in <see cref="SQLTriage.Data.IndexOptionSubstitution"/> so it can be
    /// exercised across every option combination without rendering Blazor; this method's only job
    /// is to hand it the current checkbox state.
    /// </summary>
    private string ApplyIndexOptions(string ddl) =>
        SQLTriage.Data.IndexOptionSubstitution.Apply(ddl, CurrentIndexOptions);

    /// <summary>The live panel state, as the substitution's input record.</summary>
    private SQLTriage.Data.IndexOptions CurrentIndexOptions => new(
        Online: _indexOptionOnline,
        SortInTempDb: _indexOptionSortInTempDb,
        Resumable: _indexOptionResumable,
        MaxDop: _indexMaxDop,
        Compression: _indexCompression,
        OptimizeForSequentialKey: _indexOptionOptimizeForSequential);

    private void CancelIndexCreation()
    {
        _indexExecutionCts?.Cancel();
    }

    private void ResolveServerCapabilities()
    {
        _serverVersion = null;
        _serverEdition = null;
        _serverIsEnterpriseClass = false;

        if (string.IsNullOrEmpty(ConnectionId)) return;
        var conn = ConnectionManager.GetConnection(ConnectionId);
        if (conn == null) return;

        // ServerNames is a newline-joined LIST; the health service keys per-server.
        // Probe the SAME instance ExecuteSingleIndex will target: the plan's
        // ServerName when the host page supplied it, else the first server.
        // 2026-07-21: was Split(','), which described ServerNames as "comma-separated" and so
        // split "host\instance,port" into a host and a port — the capability probe then read
        // capabilities for a server that does not exist. See ServerAddress.SplitList.
        var serverList = SQLTriage.Data.Services.ServerAddress.SplitList(conn.ServerNames);
        var firstServer = serverList.FirstOrDefault(s => !string.IsNullOrEmpty(ServerName)
                              && s.Equals(ServerName, StringComparison.OrdinalIgnoreCase))
                          ?? serverList.FirstOrDefault();
        if (string.IsNullOrEmpty(firstServer)) return;

        var caps = HealthService.GetCapabilities(firstServer);
        if (caps == null) return;
        _serverVersion = caps.MajorVersion > 0 ? caps.MajorVersion : null;
        _serverEdition = caps.Edition;
        _serverIsEnterpriseClass = caps.IsEnterpriseClass;

        // Force-clear flags whose checkbox is now disabled, so the generated
        // DDL doesn't carry over a stale "ON" from a previous server with
        // different capabilities. The user can re-enable manually if the
        // checkbox is available.
        if (!CanUseOnline)    _indexOptionOnline    = false;
        if (!CanUseResumable) _indexOptionResumable = false;
    }

    public async ValueTask DisposeAsync()
    {
        _indexExecutionCts?.Cancel();
        _indexExecutionCts?.Dispose();
        try { await JS.InvokeVoidAsync("queryPlanInteropV2.setDotNetRef", (object?)null); } catch { }
        _dotNetRef?.Dispose();
    }
}
