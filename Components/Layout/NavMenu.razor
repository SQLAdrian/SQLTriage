            <div class="nav-bottom-toggles" style="border-top:1px solid var(--border); padding-top: 8px;">
                @* ── Executive Health Badge — aggregate 0-100 across all connected servers ── *@
                @{
                    var healthAll    = ConnectionHealth.AllStatuses;
                    var healthOnline  = ConnectionHealth.OnlineCount;
                    var healthOffline = ConnectionHealth.OfflineCount;
                }
                @if (healthAll.Count > 0)
                {
                    <div class="nav-link-text" style="padding:8px 12px 4px; display:flex; gap:6px; flex-wrap:wrap;">
                        <SQLTriage.Components.Shared.HealthBadge />
                        <SQLTriage.Components.Shared.RateLimitBadge />
                    </div>
                }
                @* ── Per-server health strip ──
                     Scales to large estates (50+ instances): healthy servers collapse into the
                     green count; only offline/unknown servers get individual rows (capped), with
                     click-to-expand for the full list. *@
                @if (healthAll.Count > 0)
                {
                    var unhealthy = healthAll.Where(k => k.Value.Status != SQLTriage.Data.Services.ConnectionHealthService.ServerStatus.Online).ToList();
                    var healthRows = _healthExpanded
                        ? healthAll.ToList()
                        : unhealthy.Take(HealthStripMaxRows).ToList();
                    var healthHiddenCount = _healthExpanded ? 0 : Math.Max(0, unhealthy.Count - HealthStripMaxRows);
                    <div class="nav-health-strip" style="padding:6px 12px 4px; border-bottom:1px solid var(--border);">
                        <div class="nav-link-text" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px; cursor:pointer;"
                             title="@(_healthExpanded ? "Collapse to problem servers only" : "Show all servers")"
                             @onclick="() => _healthExpanded = !_healthExpanded">
                            <span style="font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Server Health <i class="fa-solid @(_healthExpanded ? "fa-chevron-up" : "fa-chevron-down")" style="font-size:8px; opacity:0.7;"></i></span>
                            <span style="font-size:10px; color:var(--text-muted);">
                                @if (healthOffline > 0)
                                {
                                    <span style="color:var(--red); font-weight:700;">@healthOffline offline</span>
                                    @if (healthOnline > 0) { <span> · </span> }
                                }
                                @if (healthOnline > 0)
                                {
                                    <span style="color:var(--green);">@healthOnline online</span>
                                }
                            </span>
                        </div>
                        @foreach (var kvp in healthRows)
                        {
                            var dot = kvp.Value.Status switch
                            {
                                SQLTriage.Data.Services.ConnectionHealthService.ServerStatus.Online  => "var(--green)",
                                SQLTriage.Data.Services.ConnectionHealthService.ServerStatus.Offline => "var(--red)",
                                _ => "var(--text-muted)"
                            };
                            var tip = kvp.Value.Status == SQLTriage.Data.Services.ConnectionHealthService.ServerStatus.Offline && kvp.Value.Error != null
                                ? kvp.Value.Error
                                : kvp.Value.Status.ToString();
                            <div style="display:flex; align-items:center; gap:5px; padding:1px 0;" title="@tip">
                                <span style="width:7px; height:7px; border-radius:50%; background:@dot; flex-shrink:0; @(kvp.Value.Status == SQLTriage.Data.Services.ConnectionHealthService.ServerStatus.Offline ? "box-shadow:0 0 4px var(--red); opacity:0.4;" : "")"></span>
                                <span class="nav-link-text" style="font-size:10px; color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@(string.IsNullOrWhiteSpace(kvp.Key) || kvp.Key == "." ? "(local)" : kvp.Key)</span>
                            </div>
                        }
                        @if (healthHiddenCount > 0)
                        {
                            <div class="nav-link-text" style="font-size:10px; color:var(--red); padding:1px 0 1px 12px; cursor:pointer;"
                                 title="Show all servers" @onclick="() => _healthExpanded = true">+@healthHiddenCount more offline</div>
                        }
                    </div>
                }

                @* ── Install-wide preference switches ─────────────────────────────────────
                   NOT RENDERED to a caller who may not change settings. Every one of these four
                   writes UserSettingsService — a SINGLETON holding the INSTALL's settings,
                   persisted to disk and forwarded from the WPF container — and three of them
                   broadcast the change into every live circuit. The nav menu renders on every
                   route, AccessDenied included, so before this gate an unauthenticated LAN caller
                   sitting on a denial page could flip four install settings for everybody. Proven
                   2026-08-01: one click on Experimental wrote %APPDATA%\SQLTriage\user-settings.json.
                   Rounds 4 and 5 both RECORDED these as "not ruled on"; this round rules. *@
                <ShellGate Permission="settings">
                <div class="nav-toggle-row" title="Color-Blind Mode: swap red/green to a colorblind-safe palette">
                    <span class="colorblind-icon @(_colorBlindMode ? "colorblind-active" : "")" aria-hidden="true"><i class="fa-solid fa-eye" style="font-size:13px;"></i></span>
                    <span class="nav-toggle-label nav-link-text">Color-Blind</span>
                    <div class="nav-toggle-spacer nav-link-text"></div>
                    <ToggleSwitch Value="@_colorBlindMode" ValueChanged="ToggleColorBlindMode" />
                </div>
                <div class="nav-toggle-row" title="Narration: a senior-DBA plain-language read of your estate on the dashboard">
                    <span class="colorblind-icon @(_narrationMode ? "colorblind-active" : "")" aria-hidden="true"><i class="fa-solid fa-comment-dots" style="font-size:13px;"></i></span>
                    <span class="nav-toggle-label nav-link-text">Narration</span>
                    <div class="nav-toggle-spacer nav-link-text"></div>
                    <ToggleSwitch Value="@_narrationMode" ValueChanged="ToggleNarrationMode" />
                </div>
                <div class="nav-toggle-row" title="Notifications: show or silence toast pop-ups">
                    <span class="colorblind-icon @(_notificationsEnabled ? "colorblind-active" : "")" aria-hidden="true"><i class="fa-solid @(_notificationsEnabled ? "fa-bell" : "fa-bell-slash")" style="font-size:13px;"></i></span>
                    <span class="nav-toggle-label nav-link-text">Notifications</span>
                    <div class="nav-toggle-spacer nav-link-text"></div>
                    <ToggleSwitch Value="@_notificationsEnabled" ValueChanged="ToggleNotifications" />
                </div>
                @* No-Pants Mode switch relocated to Settings > Modes (2026-07-16, #77c):
                   the main app surface no longer carries a dangerous-mode switch. This
                   sidebar only reflects the mode (via _noPantsMode) for nav gating. *@
                <div class="nav-toggle-row" title="Experimental Mode: show preview features">
                    <span class="experimental-icon @(_experimentalMode ? "experimental-active" : "")"><i class="fa-solid fa-flask" style="font-size:13px;"></i></span>
                    <span class="nav-toggle-label nav-link-text">Experimental</span>
                    <div class="nav-toggle-spacer nav-link-text"></div>
                    <ToggleSwitch Value="@_experimentalMode" ValueChanged="ToggleExperimentalMode" ActiveColor="#f59e0b" />
                </div>
                </ShellGate>
            </div>
        </div>
    }
</div>

@* No-Pants disclaimer modal relocated to Settings > Modes (2026-07-16, #77c). *@



@code {
    /// <summary>
    /// May this circuit write the INSTALL's settings? Guards the four preference switches at the
    /// bottom of the nav — see the comment beside them. Plain <c>IsAuthorized</c>: round 1 scoped
    /// break-glass to Settings and Onboarding, and the break-glass call above is the Settings
    /// shortcut, which is that scope.
    /// </summary>
    private bool MayChangeInstallSettings => UserState != null && UserState.IsAuthorized("settings");

    private string _activeCategory = "Governance";

    private void SetCategory(string category)
    {
        _activeCategory = category;
        if (_collapsed) _collapsed = false; // Auto-expand when picking a category
    }

    private bool _performanceMonitorExists = false;
    private bool _SQLWATCHExists = false;

    /// <summary>
    /// Live presence, per DISTINCT <c>requiresDatabase</c> value, of every master-group dashboard
    /// (<c>NavCategory == "Dashboards"</c>, <c>DefaultDatabase == "master"</c>) that carries one —
    /// e.g. Replication's "distribution". Resolved once per <see cref="RefreshDbFlags"/> cycle
    /// alongside <see cref="_SQLWATCHExists"/>/<see cref="_performanceMonitorExists"/>, never per
    /// render: the master group previously rendered every enabled dashboard unconditionally, so a
    /// dashboard whose required database was absent (e.g. Replication with no 'distribution' on the
    /// connected server) still got a nav link that opened to a zero-panel page.
    /// </summary>
    private Dictionary<string, bool> _masterGroupDbPresence = new(StringComparer.OrdinalIgnoreCase);

    // ── Bundle tier badge ────────────────────────────────────────────────
    private SQLTriage.Data.Services.Licensing.Tier _bundleTier = SQLTriage.Data.Services.Licensing.Tier.Free;
    private bool _bundleUnlocked = false;
    private bool _consolidationUnlocked = false;

    private string _badgeClass =>
        !_bundleUnlocked                                                           ? "not-activated"
        : _bundleTier == SQLTriage.Data.Services.Licensing.Tier.Full              ? "full"
        :                                                                            "free";

    private string _badgeText =>
        !_bundleUnlocked                                                           ? "Not Activated"
        : _bundleTier == SQLTriage.Data.Services.Licensing.Tier.Full              ? "Full"
        :                                                                            "Free";

    private string _badgeTitle =>
        !_bundleUnlocked
            ? "Bundle failed to load — check app log. Click for Settings."
            : _bundleTier == SQLTriage.Data.Services.Licensing.Tier.Full
                ? "Full Audit active — click to manage"
                : "Free tier — click for Settings";

    // The badge reads "Not Activated" / "Free" / "Full", so every reason to click it is a licence
    // reason. It lands on the tab where the licence lives, and where a failed unlock says why.
    private void GoToTierSettings() => Navigation.NavigateTo(SQLTriage.Pages.Settings.FullAuditTabUrl);

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    // ── Sidebar collapse ─────────────────────────────────────────────────
    private bool _collapsed = false;
    private bool _showAdvanced = false;
    private bool _showConfigure = false;
    private void ToggleCollapse() => _collapsed = !_collapsed;

    // Dev-tools visibility is build-time now (BuildModules.DevTools) — the old
    // MachineName=="MSI"/UserName=="afsul" gate is replaced by build-absence:
    // community builds compile those pages out entirely (buildprofile.targets).

    // ── No-Pants Mode ────────────────────────────────────────────────────
    // The switch + disclaimer modal now live in Settings > Modes (#77c). This
    // component only mirrors the persisted flag so it can gate nav entries
    // (Apply category, Check Validator, Scheduled Tasks). It stays in sync via
    // UserSettings.OnNoPantsModeChanged (subscribed in OnInitializedAsync).
    private bool _noPantsMode = false;

    private void OnNoPantsModeChanged(bool enabled)
    {
        _noPantsMode = enabled;
        // Don't strand the Apply pane when the mode is turned off elsewhere.
        if (!enabled && _activeCategory == "Apply") _activeCategory = "Governance";
        InvokeAsync(StateHasChanged);
    }

    // ── Report / Feedback popover ────────────────────────────────────────
    // Feedback moved to the bottom status bar (StatusBar.razor).

    // ── Experimental Mode ─────────────────────────────────────────────────
    private bool _experimentalMode = false;
    private bool _showMaturityRoadmap = false;

    // The four toggles below each write an INSTALL-wide persisted setting. The render gate keeps
    // them off a denied caller's screen; these guards make the METHOD refuse as well, because a
    // control that is only absent from markup is one refactor from present.
    private void ToggleExperimentalMode(bool v)
    {
        if (!MayChangeInstallSettings) return;
        _experimentalMode = v;
        UserSettings.SetExperimentalMode(_experimentalMode);
    }

    // ── Server-health strip ───────────────────────────────────────────────
    // Collapsed by default: healthy servers live in the count line only; individual
    // rows are for offline/unknown servers, capped so a 50-instance estate cannot
    // push the toggles below off-screen. Header click expands the full list.
    private bool _healthExpanded = false;
    private const int HealthStripMaxRows = 8;

    // ── Color-Blind Mode ──────────────────────────────────────────────────
    private bool _colorBlindMode = false;

    private async Task ToggleColorBlindMode(bool v)
    {
        if (!MayChangeInstallSettings) return;
        _colorBlindMode = v;
        UserSettings.SetColorBlindMode(_colorBlindMode);
        await ApplyColorBlindBodyClass();
    }

    private async Task ApplyColorBlindBodyClass()
    {
        try
        {
            await JS.InvokeVoidAsync("document.body.classList.toggle", "colorblind-mode", _colorBlindMode);
        }
        catch { /* JS not ready on first navigation — harmless */ }
    }

    // ── Narration (progressive disclosure: opinionated estate read on demand) ──
    private bool _narrationMode = false;

    private void ToggleNarrationMode(bool v)
    {
        if (!MayChangeInstallSettings) return;
        _narrationMode = v;
        UserSettings.SetNarrationMode(_narrationMode);
    }

    // ── Notifications ─────────────────────────────────────────────────────
    private bool _notificationsEnabled = true;

    private void ToggleNotifications(bool v)
    {
        if (!MayChangeInstallSettings) return;
        _notificationsEnabled = v;
        UserSettings.SetNotificationsEnabled(_notificationsEnabled);
        ToastService.Enabled = _notificationsEnabled;
    }

    protected override async Task OnInitializedAsync()
    {
        await UserState.InitAsync();
        
        _noPantsMode         = UserSettings.GetNoPantsMode();
        _experimentalMode    = UserSettings.GetExperimentalMode();
        _showMaturityRoadmap = UserSettings.GetShowMaturityRoadmap();
        _colorBlindMode      = UserSettings.GetColorBlindMode();
        _narrationMode       = UserSettings.GetNarrationMode();
        _notificationsEnabled = UserSettings.GetNotificationsEnabled();
        ToastService.Enabled  = _notificationsEnabled;   // sync service to persisted setting on startup
        _bundleTier          = Bundle.Tier;
        _bundleUnlocked      = Bundle.IsUnlocked;
        _consolidationUnlocked = ConsolidationModel.IsUnlocked;
        Bundle.BundleStateChanged                      += OnBundleStateChanged;
        FeatureGate.Changed                            += OnFeatureGateChanged;
        ConnectionManager.OnConnectionChanged          += OnServerChanged;
        ConnectionHealth.OnStatusChanged               += OnHealthChanged;
        UserSettings.OnShowMaturityRoadmapChanged      += OnMaturityRoadmapChanged;
        UserSettings.OnNoPantsModeChanged              += OnNoPantsModeChanged;
        InstanceSelector.OnInstanceChanged             += OnInstanceChanged;
        
        QuickCheckState.StateChanged                   += OnStateChanged;
        FullAuditState.StateChanged                    += OnStateChanged;
        VaState.StateChanged                           += OnStateChanged;

        await RefreshDbFlags();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _colorBlindMode)
        {
            await ApplyColorBlindBodyClass();
        }
    }

    private void OnMaturityRoadmapChanged(bool enabled)
    {
        _showMaturityRoadmap = enabled;
        InvokeAsync(StateHasChanged);
    }

    private void OnHealthChanged() => InvokeAsync(StateHasChanged);

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnFeatureGateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnBundleStateChanged(object? sender, EventArgs e)
    {
        _bundleTier     = Bundle.Tier;
        _bundleUnlocked = Bundle.IsUnlocked;
        _consolidationUnlocked = ConsolidationModel.IsUnlocked;
        InvokeAsync(StateHasChanged);
    }

    private void OnServerChanged()
    {
        DbAvailability.InvalidateCache();
        _ = InvokeAsync(async () =>
        {
            await RefreshDbFlags();
            StateHasChanged();
        });
    }

    private void OnInstanceChanged(string instanceName)
    {
        DbAvailability.InvalidateCache();
        _ = InvokeAsync(async () =>
        {
            await RefreshDbFlags();
            StateHasChanged();
        });
    }

    private async Task RefreshDbFlags()
    {
        var pmTask = DbAvailability.DatabaseExistsAsync("PerformanceMonitor");
        var swTask = DbAvailability.DatabaseExistsAsync("SQLWATCH");

        // Master-group dashboards can each carry their own requiresDatabase (currently only
        // Replication → "distribution", written generically here). Collect the DISTINCT values
        // once and resolve them alongside the two flags above — DatabaseAvailabilityService caches
        // per database name for the cycle, so this adds at most one round-trip per distinct value,
        // never one per render.
        var masterGroupDbNames = DashboardConfig.Config.Dashboards
            .Where(d => d.NavCategory == "Dashboards" && d.DefaultDatabase == "master" && !string.IsNullOrEmpty(d.RequiresDatabase))
            .Select(d => d.RequiresDatabase!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var masterGroupTasks = masterGroupDbNames
            .ToDictionary(name => name, name => DbAvailability.DatabaseExistsAsync(name), StringComparer.OrdinalIgnoreCase);

        await Task.WhenAll(new[] { pmTask, swTask }.Concat(masterGroupTasks.Values));
        _performanceMonitorExists = pmTask.Result;
        _SQLWATCHExists = swTask.Result;
        _masterGroupDbPresence = masterGroupTasks.ToDictionary(kv => kv.Key, kv => kv.Value.Result, StringComparer.OrdinalIgnoreCase);
    }

    private RenderFragment NavIcon(string? icon) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "nav-icon");
        if (icon?.StartsWith("fa-") == true)
        {
            builder.OpenElement(2, "i");
            builder.AddAttribute(3, "class", icon);
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(2, icon);
        }
        builder.CloseElement();
    };

    /// <summary>
    /// Per-dashboard nav-visibility test — see <see cref="NavDashboardVisibilityResolver"/> for the
    /// decision itself and the defect it closes. <paramref name="requiredDbPresent"/> is whichever
    /// of the two existing live flags (<see cref="_SQLWATCHExists"/>, <see cref="_performanceMonitorExists"/>)
    /// matches the section this dashboard's <c>DefaultDatabase</c> puts it in; the discovery of those
    /// flags (RefreshDbFlags/DatabaseExistsAsync) is unchanged — only what they gate is finer-grained.
    /// </summary>
    private static bool IsDashboardNavVisible(DashboardDefinition dashboard, bool requiredDbPresent) =>
        NavDashboardVisibilityResolver.IsVisible(
            dashboard.RequiresDatabase,
            dashboard.AllPanels().Select(p => p.RequiresDatabase),
            requiredDbPresent);

    /// <summary>
    /// The live-presence answer <see cref="IsDashboardNavVisible"/> needs for a master-group
    /// dashboard, read from the cache <see cref="RefreshDbFlags"/> populated this cycle — see
    /// <see cref="NavDashboardVisibilityResolver.DbPresentFromCache"/> for the decision itself.
    /// </summary>
    private bool MasterGroupDbPresent(DashboardDefinition dashboard) =>
        NavDashboardVisibilityResolver.DbPresentFromCache(dashboard.RequiresDatabase, _masterGroupDbPresence);

    /// <summary>
    /// The nav-visible, ordered dashboards for one <c>DefaultDatabase</c> section (grouping is
    /// unchanged; only per-dashboard membership now runs through <see cref="IsDashboardNavVisible"/>
    /// instead of gating the whole section on <paramref name="requiredDbPresent"/> alone).
    /// </summary>
    private List<DashboardDefinition> VisibleDashboards(string defaultDatabase, bool requiredDbPresent) =>
        DashboardConfig.Config.Dashboards
            .Where(d => d.Enabled && d.DefaultDatabase == defaultDatabase)
            .Where(d => IsDashboardNavVisible(d, requiredDbPresent))
            .OrderBy(d => d.NavOrder)
            .ToList();

    private (string Tier, string Tooltip)? GetDashboardLoadInfo(DashboardDefinition dash)
    {
        var panels = dash.Tabs != null && dash.Tabs.Count > 0
            ? dash.Tabs[0].Panels
            : dash.Panels;
        if (panels == null || panels.Count == 0) return null;

        double maxMs = 0;
        foreach (var panel in panels)
        {
            var m = PanelMetrics.GetMetric(panel.Id);
            if (m != null && m.P95Ms > 0)
            {
                if (m.P95Ms > maxMs) maxMs = m.P95Ms;
            }
            else if (panel.ExpectedLoadMs is double exp && exp > 0)
            {
                if (exp > maxMs) maxMs = exp;
            }
        }
        if (maxMs <= 0) return null;

        var label = maxMs < 1000 ? $"~{maxMs:F0}ms" : $"~{maxMs / 1000.0:F1}s";
        var tier = maxMs < 500 ? "fast" : (maxMs < 1000 ? "med" : "slow");
        return (tier, $"Expected load (p95): {label}");
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Bundle.BundleStateChanged                  -= OnBundleStateChanged;
        FeatureGate.Changed                        -= OnFeatureGateChanged;
        ConnectionManager.OnConnectionChanged      -= OnServerChanged;
        ConnectionHealth.OnStatusChanged           -= OnHealthChanged;
        UserSettings.OnShowMaturityRoadmapChanged  -= OnMaturityRoadmapChanged;
        UserSettings.OnNoPantsModeChanged          -= OnNoPantsModeChanged;
        InstanceSelector.OnInstanceChanged         -= OnInstanceChanged;
        
        QuickCheckState.StateChanged               -= OnStateChanged;
        FullAuditState.StateChanged                -= OnStateChanged;
        VaState.StateChanged                       -= OnStateChanged;

        await ValueTask.CompletedTask;
    }
}

