<!--/* In the name of God, the Merciful, the Compassionate */-->
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using SQLTriage.Components.Shared
@using SQLTriage.Data
@using Microsoft.Extensions.Logging
@using Radzen.Blazor
@inject SQLTriage.Data.Services.KeyboardShortcutService ShortcutSvc
@inject SQLTriage.Data.UserSettingsService UserSettings
@inject SQLTriage.Data.ServerConnectionManager ConnectionManager
@inject SQLTriage.Data.AutoUpdateService AutoUpdate
@inject SQLTriage.Data.Services.NotificationChannelService ChannelService
@inject SQLTriage.Data.Services.WelcomeTourService Tour
@implements IDisposable

@inject SQLTriage.Data.CorrelationIdAccessor CorrelationAccessor
@inject SQLTriage.Data.Services.AppUserState UserState

<!-- Skip link for screen readers -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="print-header" aria-hidden="true">
    <span class="print-header-brand"><img src="images/sqltriage-mark.png" alt="" style="height:12px;width:auto;vertical-align:middle;" /> SQLTriage</span>
    <span class="print-header-date" id="print-header-date"></span>
</div>
<div class="print-footer" aria-hidden="true">
    <span class="print-footer-label">SQLTriage — Internal Use Only</span>
    <span class="print-footer-page">Page <span class="print-page-num"></span></span>
</div>

@if (_afterFirstRender)
{
    <ErrorBoundary>
        <ChildContent>
            <RadzenComponents />
            <CommandPalette />
        </ChildContent>
        <ErrorContent Context="ex">
            @{ TrackError(ex); }
        </ErrorContent>
    </ErrorBoundary>
}

<div class="app-container" tabindex="0" role="application" aria-label="SQLTriage Application" @onkeydown="HandleKeyDown">
    <ToastContainer />
    <ShortcutsDialog IsVisible="@showShortcuts" OnClose="@(() => showShortcuts = false)" />
    @* ── First-run overlays: NOT RENDERED to a caller who may not write install settings ──
       Every one of these three dismisses itself by writing UserSettingsService — an INSTALL-wide,
       persisted, cross-circuit write (OnboardingComplete, HasSeenWelcomeTour, LastSeenVersion,
       ShowReleaseNotesOnUpdate). They were rendered to everybody, on every route, including the
       AccessDenied pages: an unauthenticated LAN caller could write four install flags by
       clicking "Skip for now". Gating at the RENDER rather than only at the handler is what makes
       that impossible AND avoids the trap a handler-only gate would create — a modal a denied
       caller can see but can never dismiss. *@
    @if (_showOnboarding && !OnServerManagementPage)
    {
        @* Suppressed on /servers deliberately: that page opens its own Add Server dialog when no
           server is configured, and this wizard rendered ON TOP of it — two modals at once, text
           overlapping and unreadable (measured 2026-08-02, server mode, 127.0.0.1:5187/servers).
           The wizard's only job is to send the caller to /servers; once they are there it is in
           the way. *@
        <ShellGate Permission="settings">
            <OnboardingWizard IsVisible="true" OnComplete="OnOnboardingComplete" />
        </ShellGate>
    }
    @if (_showReleaseNotes)
    {
        <ShellGate Permission="settings">
            <ReleaseNotesModal IsVisible="true" OnClose="OnReleaseNotesClosed" />
        </ShellGate>
    }
    <WelcomeTourOverlay />

    @* ── First-launch welcome-tour CTA ── *@
    @if (_showWelcomeTourCta)
    {
        <ShellGate Permission="settings">
        <div class="welcome-tour-cta" role="dialog" aria-labelledby="welcome-tour-cta-title">
            <h4 id="welcome-tour-cta-title" class="welcome-tour-cta-title">
                <i class="fa-solid fa-compass"></i> New here?
            </h4>
            <p class="welcome-tour-cta-body">
                Take a 60-second guided tour of the 7 surfaces you'll use most. You can skip or pause at any time.
            </p>
            <div class="welcome-tour-cta-controls">
                <button class="welcome-tour-btn welcome-tour-btn-ghost" @onclick="DismissWelcomeTourCta">
                    No thanks
                </button>
                <button class="welcome-tour-btn welcome-tour-btn-primary" @onclick="StartWelcomeTour">
                    Take the tour
                </button>
            </div>
        </div>
        </ShellGate>
    }

    @* ── Update available banner ── *@
    @if (_updateAvailable && _updateInfo != null)
    {
        <div style="position:fixed;top:0;left:0;right:0;z-index:2000;background:var(--accent);color:var(--text-primary);
                    display:flex;align-items:center;justify-content:center;gap:12px;
                    padding:7px 16px;font-size:13px;box-shadow:0 2px 6px rgba(0,0,0,0.3);">
            <i class="fa-solid fa-circle-arrow-up"></i>
            <span>Update available: <strong>v@(_updateInfo.Version)</strong></span>
            <a href="@RouteConstants.Settings" style="color:var(--text-primary);font-weight:600;text-decoration:underline;"
               @onclick="() => _updateAvailable = false">Go to Settings to update</a>
            <button @onclick="() => _updateAvailable = false"
                    style="background:transparent;border:none;color:var(--text-primary);cursor:pointer;margin-left:8px;font-size:16px;line-height:1;"
                    title="Dismiss">&#x2715;</button>
        </div>
        <div style="height:36px;"></div>  @* spacer so content isn't hidden under the banner *@
    }

    @* ── Maintenance mode banner ── *@
    @if (_maintenanceActive)
    {
        <div style="position:fixed;top:@(_updateAvailable && _updateInfo != null ? "36px" : "0");left:0;right:0;z-index:1999;
                    background:#7c5a00;color:#ffe082;
                    display:flex;align-items:center;justify-content:center;gap:12px;
                    padding:7px 16px;font-size:13px;box-shadow:0 2px 6px rgba(0,0,0,0.3);">
            <i class="fa-solid fa-wrench"></i>
            <span><strong>Maintenance mode active</strong>@(_maintenanceUntilText)</span>
            <a href="@RouteConstants.AlertingConfig" style="color:#ffe082;font-weight:600;text-decoration:underline;">
                End early →
            </a>
        </div>
        <div style="height:36px;"></div>
    }

    <Router AppAssembly="@typeof(MainLayout).Assembly">
    <Found Context="routeData">
        <div class="app-layout" role="main" aria-label="Main content area">
            <NavMenu />
            <div class="app-content" id="main-content" role="content" aria-label="Page content">
                @* Global Server Selector *@
                <div class="global-toolbar" style="display:flex; justify-content:space-between; align-items:center;">
                    <div style="display:flex; align-items:center; gap:12px; margin-left: 16px;">
                        <button class="nav-arrow-btn" @onclick="GoBack" title="Go Back" style="background:transparent; border:none; color:var(--text-secondary); cursor:pointer;"><i class="fa-solid fa-arrow-left"></i></button>
                        <button class="nav-arrow-btn" @onclick="GoForward" title="Go Forward" style="background:transparent; border:none; color:var(--text-secondary); cursor:pointer;"><i class="fa-solid fa-arrow-right"></i></button>
                        <GlobalServerSelector />
                    </div>
                    
                    <div class="global-user-actions" style="display:flex; align-items:center; gap:16px; margin-right:24px;">
                        @* Theme toggle moved to the bottom status bar (StatusBar.razor). *@
                        @* Settings shortcut: gated on the permission the target page enforces,
                           not on a raw role. Break-glass scope so the console route into Settings
                           survives a bad RBAC config. *@
                        <ShellGate Permission="settings" BreakGlass="true">
                            <button class="theme-toggle-btn" @onclick='() => Navigation.NavigateTo("/settings")' title="Settings" style="background:transparent; border:none; color:var(--text-secondary); cursor:pointer;">
                                <i class="fa-solid fa-gear"></i>
                            </button>
                        </ShellGate>
                        <button class="user-profile-btn" @onclick='() => Navigation.NavigateTo("/settings")' title="Settings" style="display:flex; align-items:center; gap:8px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); padding:4px 12px; border-radius:20px; cursor:pointer; color:var(--text-primary); transition: background 0.2s;">
                            <div style="width:24px; height:24px; border-radius:50%; background:var(--accent); display:flex; align-items:center; justify-content:center; color:white; font-size:12px;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <span style="font-size:13px; font-weight:600;">@(UserState?.Role ?? "Admin")</span>
                        </button>
                    </div>
                </div>

                @* Bundle-state banner — shows the orange "Not Activated" warning on every
                   page when both Full + Free bundle decryption failed at boot, OR the yellow
                   "Free tier" nag when running on Free. Hidden when Full is active. *@
                <FreeStateBanner />
                <ErrorBoundary @ref="_pageErrorBoundary">
                    <ChildContent>
                        <div class="page-fade-in" @key="Navigation.Uri">
                            <RouteView RouteData="@routeData" />
                        </div>
                    </ChildContent>
                    <ErrorContent Context="ex">
                        @{
                            var corrId = TrackError(ex);
                        }
                        <div class="error-boundary" role="alert" aria-live="assertive" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:50vh;padding:48px 24px;text-align:center;">
                            <i class="fa-solid fa-triangle-exclamation" style="font-size:48px;color:var(--red);margin-bottom:20px;"></i>
                            <h2 style="font-size:22px;font-weight:700;color:var(--text-primary);margin:0 0 8px;">Something went wrong</h2>
                            <p style="font-size:13px;color:var(--text-muted);max-width:480px;margin:0 0 24px;line-height:1.6;">
                                The page encountered an unexpected error. This has been logged and the development team
                                can investigate. If this persists, please share reference <code style="background:var(--bg-tertiary);padding:2px 6px;border-radius:3px;font-size:12px;">@corrId</code>.
                            </p>
                            <div style="display:flex;gap:12px;">
                                <button class="btn btn-primary" @onclick="() => _pageErrorBoundary?.Recover()" style="padding:10px 24px;">
                                    <i class="fa-solid fa-rotate-right" style="margin-right:6px;"></i>Retry
                                </button>
                                <button class="btn btn-secondary" @onclick="() => Navigation.NavigateTo(RouteConstants.Guide)" style="padding:10px 24px;">
                                    <i class="fa-solid fa-house" style="margin-right:6px;"></i>Go to Dashboard
                                </button>
                            </div>
                            <details style="margin-top:32px;max-width:480px;text-align:left;">
                                <summary style="font-size:11px;color:var(--text-muted);cursor:pointer;">Technical details (for support)</summary>
                                <pre style="font-size:10px;color:var(--text-muted);background:var(--bg-secondary);padding:12px;border-radius:4px;margin-top:8px;max-height:200px;overflow:auto;white-space:pre-wrap;">@ex.ToString()</pre>
                            </details>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </div>
    </Found>
    <NotFound>
        <div class="app-layout" role="alert" aria-live="polite">
            <NavMenu />
            <div class="app-content">
                <div class="not-found">
                    <h2>Page not found</h2>
                    <p>The page you're looking for doesn't exist.</p>
                </div>
            </div>
        </div>
    </NotFound>
</Router>

    <StatusBar />

    @* Two deliberately UNGATED shell controls, in the two shapes that defeated round 7's markup
       census. They are kept, not fixed: they are the permanent proof that authorization stopped
       being a property of component source when InteractiveAppAdmission moved the boundary into
       the HTTP pipeline. Read Components/Shared/BoundaryCanary.razor before touching this line. *@
    <BoundaryCanary />
</div>

@code {
    /// <summary>
    /// May this circuit write the INSTALL's settings?
    ///
    /// <para>Plain <c>IsAuthorized</c>, not break-glass: round 1 scoped break-glass to Settings
    /// and Onboarding, and the one control here that carries it is the Settings shortcut above,
    /// which is the console route into the page that can undo a bad RBAC configuration. The
    /// first-run overlays are not that; they are switches, and a denied caller should see the
    /// shell without them.</para>
    ///
    /// <para>On an unconfigured install reached over loopback this is still true (bootstrap
    /// eligibility), so the real first-run path is unaffected.</para>
    /// </summary>
    private bool MayChangeInstallSettings => UserState != null && UserState.IsAuthorized("settings");

    /// <summary>
    /// True while the caller is on /servers — where the page opens its own Add Server dialog.
    /// Read on every render; <see cref="OnLocationChanged"/> forces one when the route moves.
    /// </summary>
    private bool OnServerManagementPage =>
        Navigation.ToBaseRelativePath(Navigation.Uri)
                  .TrimStart('/')
                  .StartsWith("servers", StringComparison.OrdinalIgnoreCase);

    private ErrorBoundary? _pageErrorBoundary { get; set; }
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private ILogger<MainLayout> Logger { get; set; } = null!;
    private bool showShortcuts = false;
    private bool _afterFirstRender = false;
    private bool _showOnboarding    = false;
    private bool _showWelcomeTourCta = false;
    private bool _showReleaseNotes  = false;
    private bool _updateAvailable   = false;
    private UpdateInfo? _updateInfo;
    private bool _maintenanceActive = false;
    private string _maintenanceUntilText = "";
    private System.Timers.Timer? _maintenanceTimer;

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private async Task GoForward()
    {
        await JS.InvokeVoidAsync("history.forward");
    }

    protected override async Task OnInitializedAsync()
    {
        // Resolve the current user's role for this circuit BEFORE any page renders.
        // WPF desktop mode: sets Admin synchronously (no network). Server mode:
        // fetches role from /auth/me. Without this, AppUserState.Role falls back
        // to Viewer and every Admin-gated page (Settings, Servers, AlertingConfig,
        // AuditLogViewer, ServerDocs, ServiceManagement) shows "restricted to Admin".
        await UserState.InitAsync();

        // Push a correlation ID into Serilog LogContext for this circuit/request
        _ = CorrelationAccessor.PushToLogContext();
        // Show onboarding wizard whenever there are no servers configured
        if (ConnectionManager.GetConnections().Count == 0)
        {
            _showOnboarding = true;
        }
        else
        {
            // Show release notes when version has changed since last seen (if user hasn't disabled it)
            var currentVersion = GetCurrentVersion();
            if (!string.IsNullOrEmpty(currentVersion)
                && UserSettings.GetLastSeenVersion() != currentVersion
                && UserSettings.GetShowReleaseNotesOnUpdate())
                _showReleaseNotes = true;
        }

        // Kick off a background update check; banner appears if a newer version is found
        AutoUpdate.OnUpdateAvailable += OnUpdateFound;
        AutoUpdate.StartBackgroundCheck();

        // Poll maintenance window state every 30 seconds
        RefreshMaintenanceState();
        _maintenanceTimer = new System.Timers.Timer(30_000);
        _maintenanceTimer.Elapsed += (_, _) => _ = InvokeAsync(() => { RefreshMaintenanceState(); StateHasChanged(); });
        _maintenanceTimer.AutoReset = true;
        _maintenanceTimer.Start();

        // OnServerManagementPage is read during render; without this the wizard would keep
        // rendering after a client-side navigation ONTO /servers, which is the overlap being fixed.
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void RefreshMaintenanceState()
    {
        var windows = ChannelService.GetAlertWindows();
        _maintenanceActive = windows.IsMaintenanceActive;
        if (!_maintenanceActive)
        {
            _maintenanceUntilText = "";
            return;
        }
        if (windows.IsManualMaintenanceActive && windows.MaintenanceActiveUntil.HasValue)
            _maintenanceUntilText = $" — all alerts suppressed until {windows.MaintenanceActiveUntil.Value:HH:mm}";
        else
            _maintenanceUntilText = " — scheduled window";
    }

    private static string GetCurrentVersion()
    {
        try
        {
            var path = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Config", "version.json");
            if (!File.Exists(path))
                path = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "config", "version.json");
            if (!File.Exists(path)) return "";
            var doc = System.Text.Json.JsonDocument.Parse(File.ReadAllText(path));
            return doc.RootElement.TryGetProperty("version", out var v) ? v.GetString() ?? "" : "";
        }
        catch { return ""; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _afterFirstRender = true;
            // Apply UX global classes to body
            try
            {
                var noAnim = !UserSettings.GetEnableAnimations();
                await JS.InvokeVoidAsync("eval", $"document.body.classList.toggle('no-animations', {noAnim.ToString().ToLower()});");
            } catch { /* pre-render */ }
            
            // Show welcome-tour CTA on first launch (or whenever the flag is
            // false). Only triggered AFTER any onboarding wizard has been
            // dismissed — otherwise the two overlap visually.
            if (!UserSettings.GetHasSeenWelcomeTour() && !_showOnboarding)
            {
                _showWelcomeTourCta = true;
            }
            StateHasChanged();
        }
        await Task.CompletedTask;
    }

    // The four handlers below each write an INSTALL-wide persisted flag. The render gates above
    // mean a denied caller never sees the control — and these guards mean the METHOD refuses even
    // so, because a control that is only absent from markup is one refactor from present.
    private void StartWelcomeTour()
    {
        if (!MayChangeInstallSettings) return;
        _showWelcomeTourCta = false;
        UserSettings.SetHasSeenWelcomeTour(true);
        Tour.Start();
        StateHasChanged();
    }

    private void DismissWelcomeTourCta()
    {
        if (!MayChangeInstallSettings) return;
        _showWelcomeTourCta = false;
        UserSettings.SetHasSeenWelcomeTour(true);
        StateHasChanged();
    }

    private void OnOnboardingComplete()
    {
        if (!MayChangeInstallSettings) return;
        _showOnboarding = false;
        UserSettings.SetOnboardingComplete(true);

        // After onboarding, check if a "What's new" notice is also pending
        // (happens on first-ever install where LastSeenVersion was never set)
        var currentVersion = GetCurrentVersion();
        if (!string.IsNullOrEmpty(currentVersion)
            && UserSettings.GetLastSeenVersion() != currentVersion
            && UserSettings.GetShowReleaseNotesOnUpdate())
            _showReleaseNotes = true;

        // Surface the welcome-tour CTA after onboarding too, if not yet seen.
        if (!UserSettings.GetHasSeenWelcomeTour())
            _showWelcomeTourCta = true;

        StateHasChanged();
    }

    private void OnReleaseNotesClosed(bool dontShowAgain)
    {
        if (!MayChangeInstallSettings) return;
        _showReleaseNotes = false;
        var version = GetCurrentVersion();
        if (!string.IsNullOrEmpty(version))
            UserSettings.SetLastSeenVersion(version);
        if (dontShowAgain)
            UserSettings.SetShowReleaseNotesOnUpdate(false);
        StateHasChanged();
    }

    private void OnUpdateFound(UpdateInfo info)
    {
        _updateInfo      = info;
        _updateAvailable = true;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AutoUpdate.OnUpdateAvailable -= OnUpdateFound;
        Navigation.LocationChanged -= OnLocationChanged;
        _maintenanceTimer?.Stop();
        _maintenanceTimer?.Dispose();
    }

    // ── Error-boundary correlation ────────────────────────────────────────────
    // The reference code shown in the error UI is held in a field rather than minted
    // inside ErrorContent: that fragment re-renders on every pass, so a fresh Guid per
    // render meant the code the user reads could differ from the one that was recorded.
    // A new code is minted only when a DIFFERENT exception instance arrives.
    private Exception? _lastLoggedError;
    private string _lastErrorCorrId = string.Empty;

    /// <summary>
    /// Records an error-boundary exception once (ILogger + browser console) and returns the
    /// correlation code to display. Repeat renders of the same exception reuse the code.
    /// </summary>
    private string TrackError(Exception ex)
    {
        if (!ReferenceEquals(_lastLoggedError, ex))
        {
            _lastLoggedError = ex;
            _lastErrorCorrId = Guid.NewGuid().ToString("N")[..8];
            // The durable record: without this the reference code existed only in the
            // rendered page, so a user quoting it had nothing to match it against.
            Logger.LogError(ex, "[MainLayout] Unhandled UI error, reference {CorrId}", _lastErrorCorrId);
            LogErrorToConsole(ex);
        }
        return _lastErrorCorrId;
    }

    // Best-effort mirror into the WebView2/browser console. TrackError has already made the
    // durable ILogger record; this is the developer-facing view only.
    private async void LogErrorToConsole(Exception ex)
    {
        try
        {
            await JS.InvokeVoidAsync("blazorErrorLogger.logError", ex.Message, ex.StackTrace);
        }
        catch (Exception jsEx)
        {
            // JS interop unavailable (server mode or WebView2 not ready) — non-fatal.
            // Carry the ORIGINAL exception through: the previous Console.WriteLine reported
            // only the interop failure, so on a headless host the page error itself was lost.
            Logger.LogWarning(jsEx, "[MainLayout] blazorErrorLogger unavailable; original error: {OriginalError}", ex.ToString());
        }
    }

    // ToggleThemeAsync removed 2026-07-19: it had no call site in this component's markup
    // (the .theme-toggle-btn button navigates to /settings) and invoked the toggleTheme JS
    // function that went with the retro-8bit theme.

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        // ? for shortcuts help
        if (args.Key == "?" && !args.CtrlKey && !args.AltKey)
        {
            showShortcuts = !showShortcuts;
            return;
        }

        // Esc to close dialogs
        if (args.Key == "Escape")
        {
            showShortcuts = false;
            return;
        }

        if (args.CtrlKey)
        {
            var key = args.Key;

            // Ctrl+R — Run/Scan on active page
            if (key is "r" or "R")
            {
                _ = ShortcutSvc.TriggerRun();
                return;
            }

            // Ctrl+P — PDF export on active page
            if (key is "p" or "P")
            {
                _ = ShortcutSvc.TriggerExportPdf();
                return;
            }

            // Ctrl+E — CSV export on active page
            if (key is "e" or "E")
            {
                _ = ShortcutSvc.TriggerExportCsv();
                return;
            }

            // Ctrl+K — Command palette. Goes through THIS circuit's shortcut bus; the old
            // CommandPalette.RequestOpen was a public static Action, so the slot was owned by
            // whichever circuit initialised last and one browser's Ctrl+K opened another's.
            if (key is "k" or "K")
            {
                ShortcutSvc.TriggerCommandPalette();
                return;
            }

            // Ctrl+1-9 for quick navigation
            string? route = key switch
            {
                "1" => "/",
                "2" => "/instance",
                "3" => "/checks",
                "4" => "/fullaudit",
                "5" => "/health",
                "6" => "/settings",
                "7" => "/dashboard-editor",
                "8" => "/servers",
                "h" or "H" => "/health",
                "q" or "Q" => "/checks",
                _ => null
            };

            if (route != null)
                Navigation.NavigateTo(route);
        }
    }
}
