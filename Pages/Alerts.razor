    private void ToggleDryRun(ChangeEventArgs e)
    {
        // Engine is a singleton, so this write lands process wide: Dry Run suppresses every
        // notification and every history write for every user of this install, not just this
        // circuit. Same blast radius as Start, Stop and Run Now, so the same permission.
        // Refuse BEFORE _dryRun moves, so the checkbox keeps rendering the engine's real state.
        if (!MayManageAlerts) { Toast.ShowWarning(ManageAlertsRefusal); return; }
        _dryRun = (bool)(e.Value ?? false);
        Engine.DryRun = _dryRun;
        Toast.ShowInfo(_dryRun
            ? "Dry Run enabled — alerts evaluate but no notifications or history writes"
            : "Dry Run disabled — alerts will notify and persist");
    }

    private void OnSeverityChanged(AlertDefinition alert, ChangeEventArgs e)
    {
        if (!MayManageAlerts) { Toast.ShowWarning(ManageAlertsRefusal); return; }
        // The engine routes on two levels only (AlertEvaluationService.RuntimeSeverity): an alert
        // declared "Critical" floors at Critical, everything else routes Warning. The catalogue and
        // both severity selects were collapsed to those two on 2026-08-26 so the label cannot
        // advertise a granularity the routing does not have. Warning is the safe default.
        alert.Severity = e.Value?.ToString() ?? "Warning";
        Definitions.UpdateAlert(alert);
    }

    // alerts-r2-10: the Definitions-tab warning/critical/frequency/next-delay/send-email inputs
    // used to write alert-definitions.json from INLINE @onchange lambdas with no permission check,
    // in the same row as a Severity select that IS Admin-only — a Viewer or Operator could raise
    // (silence) every threshold. An inline lambda also has no name, so RbacRound8AlertsHandlerGate's
    // by-name census and RbacPageGateCensus's per-handler net (which resolves a lambda's CALLED
    // names to their declarations, and Definitions.UpdateAlert has none locally) were both blind to
    // it — the gate-change-shapes-are-a-blind-spot lesson. Each write is now a NAMED handler gated
    // on manage_alerts exactly like OnSeverityChanged, refusing before it mutates, and surfacing a
    // failed write instead of a silent success (the alerts-r2-11 shape, applied to these five too).
    private void OnWarningThresholdChanged(AlertDefinition alert, ChangeEventArgs e)
    {
        if (!MayManageAlerts) { Toast.ShowWarning(ManageAlertsRefusal); return; }
        var previous = alert.Thresholds.Warning;
        alert.Thresholds.Warning = double.TryParse(e.Value?.ToString(), out var val) ? val : null;
        if (Definitions.UpdateAlert(alert) == StoreWriteOutcome.WriteFailed)
        {
            alert.Thresholds.Warning = previous;
            Toast.ShowError(AlertDefinitionWriteFailed);
        }
    }

