    private void SaveGlobalDefaults()
    {
        // Bound with @bind:after, a binding syntax the per-handler census could not see until
        // 2026-08-10. RetentionDays here decides when alert history is deleted.
        if (!MayManageAlerts) { Toast.ShowWarning(ManageAlertsRefusal); return; }
        // alerts-r2-11: RetentionDays here decides when alert history is deleted — a silent
        // WriteFailed here would toast success over a setting that reverts on restart.
        var outcome = Definitions.UpdateGlobalDefaults(_globalDefaults);
        if (outcome == StoreWriteOutcome.WriteFailed)
        {
            Toast.ShowError("Nothing was saved. The alert definitions file could not be written "
                + "(disk full, file locked, or permissions denied). Your global settings are not stored. Check the log, then try again.");
            return;
        }
        Toast.ShowSuccess("Global alert settings saved");
    }

