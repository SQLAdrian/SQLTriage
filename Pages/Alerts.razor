    private async Task RunNow()
    {
        // EvaluateAllAsync is one full cycle of the engine ToggleEngine starts: it enforces the
        // retention policy (deleting history), auto-acknowledges stale alerts, and evaluates every
        // enabled alert against every enabled server connection with notifications live.
        if (!MayManageAlerts) { Toast.ShowWarning(ManageAlertsRefusal); return; }
        Toast.ShowInfo("Running alert evaluation...");
        await Engine.EvaluateAllAsync();
        LoadData();
        Toast.ShowSuccess("Alert evaluation complete");
    }

    private void ToggleAlert(AlertDefinition alert, bool enabled)
    {
        if (!MayManageAlerts) { Toast.ShowWarning(ManageAlertsRefusal); return; }
        // alerts-r2-11: only reflect the toggle in the UI if the write actually landed. A
        // WriteFailed means the change never reached disk and would revert on restart, so the
        // checkbox must not move and the operator must be told, not shown a silent success.
        var outcome = Definitions.SetAlertEnabled(alert.Id, enabled);
        if (outcome == StoreWriteOutcome.WriteFailed)
        {
            Toast.ShowError("Nothing was saved. The alert definitions file could not be written "
                + "(disk full, file locked, or permissions denied). The alert is unchanged. Check the log, then try again.");
            return;
        }
        alert.Enabled = enabled;
    }

    private void EditAlert(AlertDefinition alert)
    {
        // Clone for editing, through the SAME serialisation that persists it.
        //
        // This used to be a hand-written property list, and a hand-written list is a census that
        // silently goes stale: SaveEdit hands the clone to UpdateAlert, which REPLACES the stored
        // definition with it and writes the file, so every property the list forgot was deleted
        // from disk the first time an operator opened that alert and pressed Save. It had already
        // forgotten canBaseline and requiresOnPrem, and it would have forgotten valueKind - which
        // would have quietly returned six alerts to comparing a since-startup counter total
        // against a per-second threshold (2026-08-23).
        //
        // A round-trip through the alert's own JSON contract cannot fall behind that contract:
        // whatever gets saved is exactly what gets cloned, including any property added later.
        _editingAlert = System.Text.Json.JsonSerializer.Deserialize<AlertDefinition>(
            System.Text.Json.JsonSerializer.Serialize(alert));
        if (_editingAlert == null) return;
        _editWarning = alert.Thresholds.Warning;
        _editCritical = alert.Thresholds.Critical;
        _editNextAlertDelayMinutes = alert.NextAlertDelayMinutes ?? alert.CooldownMinutes;
        _editEscalationMode = alert.EscalationThresholdEvents > 0 ? "events" : "time";
        _testQueryResult = null;
        _testQueryError = null;
        _showAllFields = false;
    }

    private void SaveEdit()
    {
        if (!MayManageAlerts) { Toast.ShowWarning(ManageAlertsRefusal); return; }
        if (_editingAlert == null) return;
        _editingAlert.Thresholds.Warning = _editWarning;
        _editingAlert.Thresholds.Critical = _editCritical;
        _editingAlert.NextAlertDelayMinutes = _editNextAlertDelayMinutes;
        _editingAlert.CooldownMinutes = _editNextAlertDelayMinutes; // keep legacy field in sync
        if (_editEscalationMode == "time") { _editingAlert.EscalationThresholdEvents = 0; _editingAlert.EscalationWindowMinutes = 0; }
        // alerts-r2-11: a WriteFailed leaves the definition unchanged on disk; do not close the
        // editor with a green "saved" over a write that never happened and would revert on restart.
        var outcome = Definitions.UpdateAlert(_editingAlert);
        if (outcome == StoreWriteOutcome.WriteFailed)
        {
            Toast.ShowError("Nothing was saved. The alert definitions file could not be written "
                + "(disk full, file locked, or permissions denied). Your edit is not stored. Check the log, then try again.");
            return;
        }
        _allAlerts = Definitions.GetAllAlerts();
        _editingAlert = null;
        Toast.ShowSuccess("Alert definition saved");
    }

    private void CancelEdit()
    {
        _editingAlert = null;
        _testQueryResult = null;
        _testQueryError = null;
    }

    private async Task TestQuery()
    {
        // This opens a connection to ConnectionManager.CurrentServer and executes the alert's
        // operator-supplied SQL on it. The verb net names only sw.Stop and trimmed.ImportRow here,
        // neither of which leaves the process, so the gate is on what the body actually does.
        if (!MayRunSessionDdl) { Toast.ShowWarning(RunScriptsRefusal); return; }
        if (_editingAlert == null || string.IsNullOrWhiteSpace(_editingAlert.Query)) return;

        var server = ConnectionManager.CurrentServer;
        if (server == null)
        {
            Toast.ShowWarning("No server selected — go to Servers and connect first");
            return;
        }

        _testingQuery = true;
        _testQueryResult = null;
        _testQueryError = null;
        StateHasChanged();

        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var connString = server.GetConnectionString(server.ServerNames, "master");
            var dt = new DataTable();

            await Task.Run(async () =>
            {
                using var conn = new SqlConnection(connString);
                await conn.OpenAsync();
                using var cmd = new SqlCommand(_editingAlert.Query, conn) { CommandTimeout = 15 };
                using var reader = await cmd.ExecuteReaderAsync();
                dt.Load(reader);
            });

            sw.Stop();
            _testQueryElapsed = sw.ElapsedMilliseconds < 1000
                ? $"{sw.ElapsedMilliseconds}ms"
                : $"{sw.Elapsed.TotalSeconds:F1}s";

            // Limit to 50 rows for display
            if (dt.Rows.Count > 50)
            {
                var trimmed = dt.Clone();
                for (int i = 0; i < 50; i++)
                    trimmed.ImportRow(dt.Rows[i]);
                _testQueryResult = trimmed;
                _testQueryElapsed += " (showing first 50)";
            }
            else
            {
                _testQueryResult = dt;
            }
        }
        catch (SqlException ex)
        {
            sw.Stop();
            _testQueryError = $"SQL Error {ex.Number}: {ex.Message}";
        }
        catch (Exception ex)
        {
            sw.Stop();
            _testQueryError = ex.Message;
        }
        finally
        {
            _testingQuery = false;
            StateHasChanged();
        }
    }

