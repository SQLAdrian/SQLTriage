<!--/* In the name of God, the Merciful, the Compassionate */-->
@page "/onboarding"
@using SQLTriage.Data
@using SQLTriage.Data.Models
@using SQLTriage.Data.Services
@inject ServerConnectionManager ConnectionManager
@inject IQuickCheckRunner QuickCheckRunner
@inject NavigationManager Navigation
@inject ToastService Toast
@inject RbacService RbacService
@inject UserSettingsService UserSettings
@inject AppUserState UserState
@inject AdminAuthService AdminAuth

<PageTitle>Welcome - SQLTriage</PageTitle>

@* This page MINTS THE FIRST ADMIN, and it shipped with no authorization check of any kind —
   no UserState, no IsAuthorized, nothing. Round 1 scoped the bootstrap hatch to loopback across
   21 gates and missed this one, which turned a dormant hole into a live one: round 1 also gave
   local passwords a working hash and a sign-in endpoint, so filling this form from the LAN wrote
   an admin with a real Argon2id hash, flipped localPassword.enabled true, and POST /auth/local
   then handed out /query, /server-configuration and /service-management — arbitrary T-SQL and
   sp_configure from the network, on a host holding connections to client production servers.
   Exercised end to end from 192.168.10.32 on 2026-08-01.

   Same break-glass scope as Settings, and it must sit ABOVE the step switch: gating step 0 alone
   leaves the page open at step 1 (which is where OnInitialized lands it as soon as any user
   exists) with "Detect Local Instances" and "Add Server Manually" both live. The `return` below
   ends the render for EVERY step. *@
@if (!UserState.IsAuthorizedWithBreakGlass("settings"))
{
    @if (UserState.BreakGlassState == AppUserState.BreakGlassPosture.LockedNeedsPassword)
    {
        @* A break-glass recovery password protects this loopback recovery surface. Render the
           AdminGuard unlock overlay instead of AccessDenied; unlocking re-renders and reveals
           onboarding without granting an admin session. *@
        <AdminGuard OnUnlocked="StateHasChanged" />
    }
    else
    {
        <div style="padding: 32px;">
            <AccessDenied RequiredRole="Admin" Message="Setting up this installation is restricted to Admin users." />
        </div>
    }
    return;
}

<div class="onboarding-container">
    <div class="onboarding-card">
        <div class="onboarding-header">
            <h1>Welcome to SQLTriage</h1>
            <p>Get a health snapshot of your SQL Server in under 60 seconds.</p>
        </div>

        @* ── Break-glass recovery password (adminguard-breakglass, 2026-09-01 — the MIDDLE policy).
           Prompt strongly once the admin exists; allow opt-out that PERSISTS a declined flag and then
           shows a loud, persistent warning. The password is the store-independent AdminGuard
           credential that gates the loopback recovery surfaces. CSS classes only — Onboarding's
           inline-style ratchet is frozen. ── *@
        @if (ShouldPromptRecovery)
        {
            <div class="onboarding-recovery-prompt">
                <h2>Set a recovery password</h2>
                <p>
                    <strong>Strongly recommended.</strong> If RBAC ever becomes unusable (a rotated
                    OAuth secret, a hand-edited config, a damaged user store), this password is how you
                    unlock the recovery surfaces from this machine. It is stored independently of the
                    RBAC user store, so it survives that damage.
                </p>
                <div class="form-group">
                    <label>Recovery password</label>
                    <input type="password" class="form-control" @bind="_recoveryPassword"
                           placeholder="Minimum 8 characters" autocomplete="new-password" />
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" class="form-control" @bind="_recoveryPasswordConfirm"
                           placeholder="Re-enter password" autocomplete="new-password" />
                </div>
                @if (!string.IsNullOrEmpty(_recoveryError))
                {
                    <div class="alert alert-error onboarding-recovery-error">@_recoveryError</div>
                }
                <div class="actions">
                    <button class="btn btn-primary" @onclick="SetRecoveryPassword">Set recovery password</button>
                    <button class="btn btn-link" @onclick="DeclineRecoveryPassword">Not now (I understand the recovery risk)</button>
                </div>
            </div>
        }
        else if (RecoveryDeclinedUnprotected)
        {
            <div role="alert" class="onboarding-recovery-warning">
                <strong><i class="fa-solid fa-unlock-keyhole"></i> Break-glass recovery is not protected.</strong>
                <p class="onboarding-recovery-warning-body">
                    No recovery password is set. You can set one any time in Settings &#8250; Security &amp; Access.
                </p>
            </div>
        }

        @* ── Step 0: Create Admin (first run only) ── *@
        @if (_step == 0)
        {
            <div class="onboarding-step">
                <h2>Step 1: Create Admin Account</h2>
                <p>Set up the administrator account for this installation.</p>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" class="form-control" @bind="_adminEmail" placeholder="admin@example.com" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" class="form-control" @bind="_adminPassword" placeholder="Minimum 12 characters" />
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" class="form-control" @bind="_adminPasswordConfirm" placeholder="Re-enter password" />
                </div>
                @if (!string.IsNullOrEmpty(_adminError))
                {
                    <div class="alert alert-error" style="margin-top: 8px;">@_adminError</div>
                }
                <div class="actions">
                    <button class="btn btn-primary" @onclick="CreateAdmin" disabled="@_creatingAdmin">
                        @(_creatingAdmin ? "Creating..." : "Create Admin & Continue")
                    </button>
                </div>
            </div>
        }

        @* ── Step 1: Detect SQL Servers ── *@
        else if (_step == 1)
        {
            <div class="onboarding-step">
                <h2>Step 2: Detect SQL Servers</h2>
                <p>We can auto-detect SQL Server instances on your network.</p>
                <button class="btn btn-primary" @onclick="DetectInstances" disabled="@_detecting">
                    @(_detecting ? "Detecting..." : "Detect Local Instances")
                </button>

                @if (_detectedInstances.Any())
                {
                    <div class="instance-list">
                        <p>Select an instance to connect:</p>
                        @foreach (var inst in _detectedInstances)
                        {
                            <div class="instance-item" @onclick="() => SelectInstance(inst)">
                                <i class="fa-solid fa-server"></i> @inst
                            </div>
                        }
                    </div>
                }

                <div class="or-divider">or</div>
                <button class="btn btn-secondary" @onclick="() => _step = 2">Add Server Manually</button>
            </div>
        }

        @* ── Step 2: Server Details + Credentials ── *@
        else if (_step == 2)
        {
            <div class="onboarding-step">
                <h2>Step 3: Server Connection</h2>
                <div class="form-group">
                    <label>Server Instance</label>
                    <input type="text" class="form-control" @bind="_selectedInstance" placeholder="localhost\SQLEXPRESS or 192.168.1.10" />
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="_useWindowsAuth" /> Use Windows Authentication
                    </label>
                </div>
                @if (!_useWindowsAuth)
                {
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" class="form-control" @bind="_sqlUsername" placeholder="sa" />
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" class="form-control" @bind="_sqlPassword" placeholder="SQL password" />
                    </div>
                }
                <label class="checkbox-label">
                    <input type="checkbox" @bind="_runQuickCheck" /> Run Quick Check immediately after connecting
                </label>
                <div class="actions">
                    <button class="btn btn-secondary" @onclick="() => _step = 1">Back</button>
                    <button class="btn btn-primary" @onclick="ConfirmAndConnect">Connect</button>
                </div>
            </div>
        }

        @* ── Step 3: Quick Check Progress ── *@
        else if (_step == 3)
        {
            <div class="onboarding-step">
                <h2>Running Quick Check...</h2>
                <div class="progress-bar-container">
                    <div class="progress-bar" style="width:@(_progressPercent)%"></div>
                </div>
                <p>@(_progressText)</p>
                <button class="btn btn-secondary btn-sm" @onclick="CancelCheck">Cancel</button>
            </div>
        }

        @* ── Skip option always visible ── *@
        @if (_step < 3)
        {
            <div style="text-align: center; margin-top: 16px;">
                <button class="btn btn-link" style="font-size: 12px; color: var(--text-muted);"
                        @onclick="SkipOnboarding">
                    Skip onboarding → go to dashboard
                </button>
            </div>
        }
    </div>
</div>

@code {
    private int _step = 0; // Start at 0 (admin creation)
    private bool _detecting = false;
    private List<string> _detectedInstances = new();
    private string _selectedInstance = "";
    private bool _runQuickCheck = true;
    private bool _useWindowsAuth = true;
    private string _sqlUsername = "";
    private string _sqlPassword = "";
    private double _progressPercent = 0;
    private string _progressText = "Starting...";
    private CancellationTokenSource? _cts;

    // Admin creation
    private string _adminEmail = "";
    private string _adminPassword = "";
    private string _adminPasswordConfirm = "";
    private string _adminError = "";
    private bool _creatingAdmin = false;

    /// <summary>
    /// The same gate as the markup, in code. The `return` in the template means an unauthorized
    /// circuit never renders a button and so never registers an event handler for one — but the
    /// mutating methods below mint admins and add server connections, and a gate that exists only
    /// in markup is one refactor away from being no gate at all. Cheap; keep it.
    /// </summary>
    private bool MayConfigure => UserState.IsAuthorizedWithBreakGlass("settings");

    // ── Break-glass recovery password (adminguard-breakglass) ──
    private string _recoveryPassword = "";
    private string _recoveryPasswordConfirm = "";
    private string _recoveryError = "";

    /// <summary>
    /// The recovery-password prompt only makes sense once the admin exists (so it is the END of the
    /// admin step), the install has no recovery password yet, and the caller may configure. The
    /// prompt shows until the operator SETS a password or DECLINES.
    /// </summary>
    private bool RecoveryEligible => MayConfigure && !AdminAuth.HasPassword && RbacService.GetUsers().Count > 0;
    private bool ShouldPromptRecovery => RecoveryEligible && !UserSettings.GetRecoveryPasswordPromptDeclined();
    private bool RecoveryDeclinedUnprotected => RecoveryEligible && UserSettings.GetRecoveryPasswordPromptDeclined();

    private void SetRecoveryPassword()
    {
        if (!MayConfigure) return;
        _recoveryError = "";
        if (_recoveryPassword != _recoveryPasswordConfirm)
        {
            _recoveryError = "The two passwords do not match.";
            return;
        }

        // AdminAuthService owns the length rule, the PBKDF2 hashing and the persistence.
        var error = AdminAuth.SetInitialPassword(_recoveryPassword);
        if (error is null)
        {
            _recoveryPassword = "";
            _recoveryPasswordConfirm = "";
            Toast.ShowSuccess("Recovery password set", "Break-glass recovery on this machine now requires it.");
        }
        else
        {
            _recoveryError = error;
        }
    }

    private void DeclineRecoveryPassword()
    {
        if (!MayConfigure) return;
        // Persist the decline so the prompt does not return on every visit; the loud warning does.
        UserSettings.SetRecoveryPasswordPromptDeclined(true);
    }

    protected override void OnInitialized()
    {
        if (!MayConfigure) return;

        // If users already exist, skip admin creation
        if (RbacService.GetUsers().Count > 0)
        {
            _step = 1;
        }
    }

    private void CreateAdmin()
    {
        if (!MayConfigure) return;
        _adminError = "";

        // This step creates a LOCAL password account, so the identity really is an email
        // address here — a Windows account has no password to set on this form. Windows and
        // domain accounts are added from Settings ▸ Access Control, which offers the provider.
        if (string.IsNullOrWhiteSpace(_adminEmail) || !_adminEmail.Contains("@"))
        {
            _adminError = "Enter an email address for the local administrator account. "
                        + "Windows and domain accounts are added later, from Settings ▸ Access Control.";
            return;
        }
        if (_adminPassword.Length < 12)
        {
            _adminError = "Password must be at least 12 characters.";
            return;
        }
        if (_adminPassword != _adminPasswordConfirm)
        {
            _adminError = "Passwords do not match.";
            return;
        }

        _creatingAdmin = true;
        try
        {
            var admin = new RbacUser
            {
                Email = _adminEmail.Trim(),
                DisplayName = _adminEmail.Trim(),
                Provider = AuthProviders.Local,
                Role = AppRoles.Admin,
                CreatedAt = DateTime.UtcNow,
                Enabled = true
            };
            // The store can refuse: rbac-users.json exists and did not load, so the empty list in
            // memory is not this install's accounts and writing one over it would delete them all.
            // Reported rather than swallowed — an onboarding that says "ready" over a refused write
            // hands the operator an account that is not there.
            var created = RbacService.AddUser(admin);
            if (created == StoreWriteOutcome.RefusedStoreUnreadable)
            {
                _adminError = "The account was not created: this install's user store exists and could not be read, "
                            + "so writing to it would delete the accounts already in it. "
                            + RbacService.DescribeStoreRecovery(forConfigStore: false);
                return;
            }
            if (created == StoreWriteOutcome.WriteFailed)
            {
                // Nothing wrong with the store — so none of the restore-the-file advice above
                // applies, and printing it would send the operator after a file that is fine.
                _adminError = "The account was not created: the user store could not be written. The disk may be "
                            + "full, the file locked, or permissions may deny it. Check the log for the exact "
                            + "error, then try again.";
                return;
            }

            // Match on the identity key, not the record Id. This line used to pass admin.Id
            // into a lookup that only compared Email; a GUID never matched, so it took the
            // not-found branch, logged a warning nobody read, and left the brand-new admin in
            // rbac-users.json with PasswordHash: null — an account that could never sign in.
            if (!RbacService.SetPassword(admin.Email, _adminPassword))
            {
                _adminError = "The account was created but the password could not be stored. "
                            + "Set it from Settings ▸ Access Control before enabling RBAC.";
                return;
            }

            // An account nobody can sign in with is worse than no account. Turn the local
            // password provider on in the same breath, so this admin is a real way in and the
            // lockout guard counts it as one.
            var config = RbacService.Config;
            if (!config.LocalPassword.Enabled)
            {
                // Same refusal, on the other store. `config` here is RbacService.Config, which in
                // the damaged state IS the defaults object — saving it would record this build's
                // guesses as the operator's configuration and overwrite the damaged file that is
                // the only evidence otherwise. Onboarding has no business acknowledging that on
                // their behalf, so it reports instead.
                var configured = RbacService.UpdateConfig(config);
                if (configured == StoreWriteOutcome.RefusedStoreUnreadable)
                {
                    _adminError = "The account was created, but local password sign-in could not be switched on: "
                                + "this install's access-control configuration exists and could not be read. Open "
                                + "Settings ▸ Security & Access, which will tell you how to repair it.";
                    return;
                }
                if (configured == StoreWriteOutcome.WriteFailed)
                {
                    _adminError = "The account was created, but local password sign-in could not be switched on: "
                                + "the access-control configuration could not be written (disk full, file locked, "
                                + "or permissions denied). The admin cannot sign in until it is. Check the log, "
                                + "then set it under Settings ▸ Security & Access.";
                    return;
                }
            }

            Toast.ShowSuccess("Admin created", $"Account {_adminEmail} is ready.");
            _step = 1;
        }
        catch (Exception ex)
        {
            _adminError = $"Failed to create admin: {ex.Message}";
        }
        finally
        {
            _creatingAdmin = false;
        }
    }

    private async Task DetectInstances()
    {
        if (!MayConfigure) return;
        _detecting = true;
        await Task.Yield();
        _detectedInstances = await Task.Run(() => SQLTriage.Data.Services.QuickCheckRunner.DetectLocalInstances());
        _detecting = false;
        if (!_detectedInstances.Any())
        {
            Toast.ShowInfo("No local SQL instances detected", "Add one manually.");
            _step = 2;
        }
    }

    private void SelectInstance(string instance)
    {
        if (!MayConfigure) return;
        _selectedInstance = instance;
        _step = 2;
    }

    private async Task ConfirmAndConnect()
    {
        if (!MayConfigure) return;
        if (string.IsNullOrWhiteSpace(_selectedInstance))
        {
            Toast.ShowWarning("Missing server", "Please select or enter a server instance.");
            return;
        }

        var conn = new ServerConnection
        {
            ServerNames = _selectedInstance,
            UseWindowsAuthentication = _useWindowsAuth,
            IsEnabled = true
        };
        if (!_useWindowsAuth)
        {
            conn.Username = _sqlUsername;
            conn.Password = _sqlPassword;
        }
        var addResult = ConnectionManager.AddConnection(conn);
        if (!addResult.Succeeded)
        {
            // Licence refusal on the very first server. Do NOT mark onboarding complete — the
            // operator has no working instance, and flagging it done would strand them on a
            // dashboard with nothing in it and no explanation.
            Toast.ShowWarning("Instance not added", addResult.Reason!);
            return;
        }

        UserSettings.SetOnboardingComplete(true);

        if (_runQuickCheck)
        {
            _step = 3;
            _cts = new CancellationTokenSource();
            var progress = new Progress<QuickCheckProgress>(p =>
            {
                _progressPercent = p.Percent;
                _progressText = $"{p.Completed} of {p.Total} checks — {p.CurrentCheckName}";
                StateHasChanged();
            });

            try
            {
                var result = await QuickCheckRunner.RunAsync(conn, _selectedInstance, progress, _cts.Token);
                Toast.ShowSuccess("Quick Check complete", $"{result.Summary.Passed}/{result.Summary.TotalChecks} passed");
                Navigation.NavigateTo(RouteConstants.GovernanceIndicative);
            }
            catch (OperationCanceledException)
            {
                Toast.ShowInfo("Quick Check cancelled", "");
            }
            catch (Exception ex)
            {
                Toast.ShowError("Quick Check failed", ex.Message);
            }
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private void SkipOnboarding()
    {
        if (!MayConfigure) return;
        UserSettings.SetOnboardingComplete(true);
        Navigation.NavigateTo("/");
    }

    private void CancelCheck()
    {
        _cts?.Cancel();
    }
}
