<!--/* In the name of God, the Merciful, the Compassionate */-->
@page "/servers"
<PageTitle>SQLTriage - Server Management</PageTitle>
@using Microsoft.Extensions.Logging
@inject ServerConnectionManager ConnectionManager
@inject SQLTriage.Data.Services.IServerContextService ServerContext
@inject SQLTriage.Data.Services.AppUserState UserState
@inject SQLTriage.Data.Services.BuildCatalogueService BuildCatalogue
@inject SQLTriage.Data.Services.LicensingEstimator LicensingEstimator
@inject AuditLogService AuditLog
@inject SQLTriage.Data.Services.ExecutiveHealthService HealthService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<Servers> Logger
@using Microsoft.Data.SqlClient
@using SQLTriage.Data
@using SQLTriage.Data.Models
@using SQLTriage.Data.Services

@if (!UserState.IsAuthorized("manage_servers"))
{
    <div style="padding: 32px;">
        <AccessDenied RequiredRole="Admin" Message="Server management is restricted to Admin users." />
    </div>
}
else
{

<div class="servers-page">
    <h2>Server Management</h2>

    @* pages-r1-03: "Connected" counted every connection whose PERSISTED IsConnected was true,
       including connections nothing had probed in this process. The green number now counts only
       statuses measured this session; anything not checked is its own number, and the caption
       states how much of the estate the two numbers cover. *@
    @{
        var totalServers   = Connections.Count;
        var connectedCount = Connections.Count(c => ConnectionStatusText.Classify(c) == ConnectionStatusKind.ConnectedNow);
        var offlineCount   = Connections.Count(c => ConnectionStatusText.Classify(c) == ConnectionStatusKind.DisconnectedNow);
        var uncheckedCount = Connections.Count(c => ConnectionStatusText.Classify(c) == ConnectionStatusKind.NotCheckedThisSession);
        var heroCaption    = ConnectionStatusText.DescribeHeroCaption(Connections);
    }
    <div class="servers-hero">
        <div class="servers-hero-stat">
            <span class="hero-number">@totalServers</span>
            <span class="hero-number-unit">@(totalServers == 1 ? "Server" : "Servers")</span>
        </div>
        <div class="servers-hero-stat servers-hero-stat--sub">
            <span class="hero-number" style="font-size:32px;color:var(--green);">@connectedCount</span>
            <span class="hero-number-unit">Connected</span>
        </div>
        @if (offlineCount > 0)
        {
            <div class="servers-hero-stat servers-hero-stat--sub">
                <span class="hero-number" style="font-size:32px;color:var(--red);">@offlineCount</span>
                <span class="hero-number-unit">Offline</span>
            </div>
        }
        @if (uncheckedCount > 0)
        {
            <div class="servers-hero-stat servers-hero-stat--sub">
                <span class="hero-number" style="font-size:32px;color:var(--text-muted);">@uncheckedCount</span>
                <span class="hero-number-unit">Not checked</span>
            </div>
        }
    </div>
    @if (heroCaption is not null)
    {
        <div class="servers-hero-caption" style="font-size:12px;color:var(--text-muted);margin:-8px 0 12px;">@heroCaption</div>
    }

    <div class="servers-toolbar">
        <button class="btn btn-primary" @onclick="ShowAddDialog"><i class="fa-solid fa-plus"></i> Add Server</button>
        <button class="btn btn-secondary" @onclick="RefreshAllConnections"><i class="fa-solid fa-rotate"></i> Refresh All</button>
        <button class="btn btn-danger" @onclick="DeleteAllDisconnected"><i class="fa-solid fa-trash"></i> Delete Disconnected</button>
    </div>

    @if (_allTags.Count > 0 || _allEnvironments.Count > 0)
    {
        <div class="servers-filter-bar">
            @if (_allEnvironments.Count > 0)
            {
                <div class="filter-group">
                    <span class="filter-label">Environment:</span>
                    <button class="filter-chip @(_filterEnvironment == null ? "active" : "")" @onclick="@(() => { _filterEnvironment = null; })">All</button>
                    @foreach (var env in _allEnvironments)
                    {
                        <button class="filter-chip @(_filterEnvironment == env ? "active" : "")" @onclick="@(() => { _filterEnvironment = _filterEnvironment == env ? null : env; })">@env</button>
                    }
                </div>
            }
            @if (_allTags.Count > 0)
            {
                <div class="filter-group">
                    <span class="filter-label">Tag:</span>
                    <button class="filter-chip @(_filterTag == null ? "active" : "")" @onclick="@(() => { _filterTag = null; })">All</button>
                    @foreach (var tag in _allTags)
                    {
                        <button class="filter-chip @(_filterTag == tag ? "active" : "")" @onclick="@(() => { _filterTag = _filterTag == tag ? null : tag; })">@tag</button>
                    }
                </div>
            }
        </div>
    }

    @if (StatusMessage != null)
    {
        <div class="status-message @(IsSuccess ? "success" : "error")" role="status">
            @StatusMessage
        </div>
    }

    <div class="servers-grid" style="display: flex; flex-direction: column; gap: 12px;">
        @foreach (var conn in _pagedConnections)
        {
            @* pages-r1-03: the card's colour and its dot came from persisted fields with no notion
               of when they were measured, so a green "connected" card rendered for an instance
               whose SQL service had been stopped for 39 days. A status nobody probed in this
               session renders as unchecked, with the age of the stored reading beside it. *@
            var statusKind = ConnectionStatusText.Classify(conn);
            <div class="server-card-row card-glass @(statusKind switch { ConnectionStatusKind.ConnectedNow => "connected", ConnectionStatusKind.DisconnectedNow => "disconnected", _ => "unverified" })" style="padding: 16px; border-radius: 8px; display: grid; grid-template-columns: 2fr 1fr 1.5fr 100px; align-items: center; gap: 16px;">
                <div class="sr-identity" style="display:flex; flex-direction:column; gap:6px;">
                    <div style="font-size: 16px; font-weight: 700; display:flex; align-items:center; gap:8px;">
                        @if (statusKind == ConnectionStatusKind.NotCheckedThisSession)
                        {
                            <i class="fa-solid fa-circle-question" style="color:var(--text-muted); font-size:12px;"></i>
                        }
                        else if (conn.SuccessfulServers != null && conn.SuccessfulServers.Count > 0)
                        {
                            var serverCount = conn.GetServerCount();
                            if (conn.SuccessfulServers.Count == serverCount)
                            {
                                <i class="fa-solid fa-circle" style="color:var(--green); font-size:12px;"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle-half-stroke" style="color:var(--orange); font-size:12px;"></i>
                            }
                        }
                        else
                        {
                            <i class="fa-solid fa-circle-xmark" style="color:var(--red); font-size:12px;"></i>
                        }
                        @conn.ServerNames
                    </div>
                    <div style="font-size:11px; color:var(--text-muted);">@ConnectionStatusText.DescribeRow(conn, DateTime.Now)</div>
                    <div style="display:flex; gap:8px; font-size:12px; color:var(--text-secondary);">
                        <span><i class="fa-solid fa-database"></i> @conn.Database</span>
                        @if (!string.IsNullOrEmpty(conn.Environment))
                        {
                            <span class="env-badge env-@(conn.Environment?.ToLower())">@conn.Environment</span>
                        }
                        @if (conn.Tags != null && conn.Tags.Count > 0)
                        {
                            <span style="display:flex; gap:4px;">
                                @foreach(var t in conn.Tags) { <span class="tag-pill" style="padding:2px 6px; font-size:10px;">@t</span> }
                            </span>
                        }
                    </div>
                </div>

                <div class="sr-health">
                    @if (conn.IsConnected && conn.SuccessfulServers?.Count > 0)
                    {
                        var srv = conn.SuccessfulServers.First();
                        @* Gate fix C4 (2026-08-05): this read score.Score, which is 0 in every
                           state where nothing was measured, so a connected server whose health
                           poll had not answered showed a bold red 0 in the server list. The row
                           renders the reason instead, from the same policy every other surface
                           reads, rather than a number or a blank. *@
                        if (_serverScores.TryGetValue(srv, out var score) && score.MeasuredScore.HasValue)
                        {
                            var shown = score.MeasuredScore.Value;
                            var color = shown >= 80 ? "var(--green)" : shown >= 60 ? "var(--orange)" : "var(--red)";
                            <div style="display:flex; flex-direction:column; align-items:center;">
                                <div style="font-size:20px; font-weight:800; color:@color; text-shadow: 0 0 8px @(color)40;">@shown</div>
                                <div style="font-size:10px; text-transform:uppercase; color:var(--text-secondary);">Health</div>
                            </div>
                        }
                        else
                        {
                            <div style="display:flex; flex-direction:column; align-items:center;"
                                 title="@EstateHealthPolicy.ServerBasis(_serverScores.TryGetValue(srv, out var unscored) ? unscored : null)">
                                <div style="font-size:20px; font-weight:800; color:var(--text-muted);">n/a</div>
                                <div style="font-size:10px; text-transform:uppercase; color:var(--text-secondary);">Health</div>
                            </div>
                        }
                    }
                </div>

                <div class="sr-patching" style="font-size:12px;">
                    @if (BuildCatalogue.IsAvailable && conn.SuccessfulServers?.Count > 0)
                    {
                        var srvName = conn.SuccessfulServers.First();
                        if (_buildStatusByServer.TryGetValue(srvName, out var bs) && bs != null)
                        {
                            var statusClass = bs.LifecycleStatus.ToString().ToLowerInvariant();
                            <div class="server-build-row @statusClass" @onclick="() => ShowPatchesModal(srvName, bs)" style="cursor:pointer; margin:0; padding:8px;" title="Click for missed-patch detail">
                                <span class="server-build-version">SQL @bs.MajorVersion</span>
                                <span class="server-build-patches">
                                    @if (bs.PatchesBehind == 0)
                                    {
                                        <i class="fa-solid fa-check"></i> <text>Current</text>
                                    }
                                    else
                                    {
                                        <text>@bs.PatchesBehind CUs behind</text>
                                    }
                                </span>
                            </div>
                        }
                        else if (_buildStatusByServer.ContainsKey(srvName))
                        {
                            <!-- Probe resolved but returned no build info (version not in the
                                 catalogue, or the facts probe failed) — a real, terminal outcome,
                                 not "still probing". Root cause of the stuck spinner: TryGetValue
                                 alone can't tell "probed, no data" (key present, value null) apart
                                 from "never probed" (key absent) — both fell into the spinner arm. -->
                            <div style="color:var(--text-muted);" title="Build/version info unavailable for this server">
                                <i class="fa-solid fa-circle-question"></i> Build unknown
                            </div>
                            @if (BuildCatalogue.IsStale)
                            {
                                <div style="color:var(--text-muted); font-size:10px; font-style:italic;"
                                     title="scripts/update-build-catalogue.py has not been re-run recently — newer SQL Server versions/builds may be missing">
                                    build catalogue is @BuildCatalogue.AgeInDays days old
                                </div>
                            }
                        }
                        else
                        {
                            <div style="color:var(--text-muted);"><i class="fa-solid fa-spinner fa-spin"></i> Probing...</div>
                        }
                    }
                </div>

                <div class="server-actions" style="justify-self: end;">
                    @if (conn.SuccessfulServers?.Count > 0)
                    {
                        var baselineSrv = conn.SuccessfulServers.First();
                        <button class="btn-icon" @onclick="() => GoToBaseline(baselineSrv)" title="Progress since baseline"><i class="fa-solid fa-flag-checkered"></i></button>
                    }
                    <button class="btn-icon" @onclick="() => TestConnection(conn)" title="Test"><i class="fa-solid fa-link"></i></button>
                    <button class="btn-icon" @onclick="() => EditConnection(conn)" title="Edit"><i class="fa-solid fa-pen"></i></button>
                    <button class="btn-icon" @onclick="() => DeleteConnection(conn)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                </div>
            </div>
        }

        @if (FilteredConnections.Any())
        {
            <div class="servers-pagination" style="display:flex; justify-content:center; gap:8px; margin-top:16px;">
                <button class="btn btn-secondary" disabled="@(_currentPage == 1)" @onclick="() => _currentPage--">Previous</button>
                <span style="align-self:center; color:var(--text-secondary); font-size:14px;">Page @_currentPage of @_totalPages</span>
                <button class="btn btn-secondary" disabled="@(_currentPage == _totalPages)" @onclick="() => _currentPage++">Next</button>
            </div>
        }

        @if (Connections.Count == 0)
        {
            <div class="empty-state">
                <p>No servers configured. Click "Add Server" to add your first server.</p>
                <button class="btn btn-primary" @onclick="ShowAddDialog"><i class="fa-solid fa-plus"></i> Add Your First Server</button>
            </div>
        }
    </div>

    <!-- Add/Edit Dialog -->
    @if (ShowDialog)
    {
        <div class="dialog-overlay" @onclick="CloseDialog">
            <div class="dialog-content" @onclick:stopPropagation="true">
                <h3>@(IsEditing ? "Edit Server" : "Add Server")</h3>

                @* A hand-off that was refused says so here, on the page it sent the operator to,
                   and the field below is left empty. Silence would read as "this is the name you
                   asked for" over whatever happened to be in the box. *@
                @if (!string.IsNullOrEmpty(_addPrefillRefusal))
                {
                    <div class="status-message error" role="alert" style="margin-bottom:12px;">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        The requested name was refused: @_addPrefillRefusal. Nothing has been filled in
                        for you — type the server name yourself if you still want to add it.
                    </div>
                }

                <div class="form-group">
                    <label>Server Name(s)</label>
                    <textarea @bind="EditingConnection.ServerNames" rows="4" placeholder="Enter server names, one per line (each line becomes a separate connection)"></textarea>
                    <small>Enter one server per line. Each line will create a separate connection entry.</small>
                </div>

                <div class="form-group">
                    <label>Database</label>
                    <input type="text" @bind="EditingConnection.Database" placeholder="master" />
                    <small>Use 'master' for quick checks, 'SQLWATCH' for dashboards (if SQLWATCH is installed)</small>
                </div>

                <div class="form-group">
                    <label>Authentication</label>
                    <div class="auth-options">
                        <label class="auth-option">
                            <input type="radio" name="authType" value="@AuthenticationTypes.Windows"
                                   checked="@(EditingAuthType == AuthenticationTypes.Windows)"
                                   @onchange="@(() => SetAuthType(AuthenticationTypes.Windows))" />
                            Windows Authentication
                        </label>
                        <label class="auth-option">
                            <input type="radio" name="authType" value="@AuthenticationTypes.SqlServer"
                                   checked="@(EditingAuthType == AuthenticationTypes.SqlServer)"
                                   @onchange="@(() => SetAuthType(AuthenticationTypes.SqlServer))" />
                            SQL Server Authentication
                        </label>
                        <label class="auth-option">
                            <input type="radio" name="authType" value="@AuthenticationTypes.EntraMFA"
                                   checked="@(EditingAuthType == AuthenticationTypes.EntraMFA)"
                                   @onchange="@(() => SetAuthType(AuthenticationTypes.EntraMFA))" />
                            Microsoft Entra MFA
                        </label>
                    </div>
                </div>

                @if (EditingAuthType == AuthenticationTypes.SqlServer)
                {
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" @bind="EditingConnection.Username" />
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" @bind="EditingPassword" />
                    </div>
                }
                else if (EditingAuthType == AuthenticationTypes.EntraMFA)
                {
                    <div class="form-group">
                        <label>Email / Username (optional)</label>
                        <input type="text" @bind="EditingConnection.Username" placeholder="user@domain.com" />
                        <small>Pre-fills the login hint. Leave blank to be prompted.</small>
                    </div>
                    <div class="form-group mfa-info">
                        <small><i class="fa-solid fa-lock"></i> A browser window will open for interactive MFA authentication when you connect.</small>
                    </div>
                }

                <div class="form-group">
                    <label>
                        <input type="checkbox" @bind="EditingConnection.TrustServerCertificate" />
                        Trust Server Certificate
                    </label>
                </div>

                <div class="form-group">
                    <label>Connection Timeout (seconds)</label>
                    <input type="number" @bind="EditingConnection.ConnectionTimeout" min="1" max="60" />
                </div>

                <div class="form-group">
                    <label>Environment</label>
                    <select @bind="EditingConnection.Environment">
                        <option value="">— None —</option>
                        <option value="Production">Production</option>
                        <option value="Staging">Staging</option>
                        <option value="Development">Development</option>
                        <option value="Test">Test</option>
                        <option value="QA">QA</option>
                        <option value="DR">DR</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Tags</label>
                    <input type="text" @bind="_editingTagsText" placeholder="e.g. finance, critical, east-us (comma-separated)" />
                    <small>Comma-separated tags for grouping and filtering servers</small>
                </div>

                @* Compile-time const, so this whole branch is pruned from the community build. *@
                @if (BuildModules.Portal)
                {
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="EditingConnection.PortalUrgentEvents" />
                            Report urgent events to the client portal
                        </label>
                        <small>Off by default. When on, this server's outages, recoveries and critical alerts are sent to the client portal. Health polling and the dashboards run either way.</small>
                    </div>
                }

                <div class="dialog-actions">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveConnection">Save</button>
                </div>
            </div>
        </div>
    }

    <!-- Delete Confirmation Dialog -->
    @if (ShowDeleteConfirm)
    {
        <div class="dialog-overlay" @onclick="CancelDelete">
            <div class="dialog-content" @onclick:stopPropagation="true">
                <h3>Confirm Delete</h3>
                <p>Are you sure you want to delete the server connection for:</p>
                <p><strong>@ConnectionToDelete?.ServerNames</strong></p>
                <div class="dialog-actions">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    }

    @if (_showPatchesModal && _modalStatus != null)
    {
        <div class="dialog-overlay" @onclick="ClosePatchesModal">
            <div class="dialog-content" @onclick:stopPropagation="true" style="max-width:680px;">
                <h3><i class="fa-solid fa-shield-halved"></i> Patch &amp; lifecycle &mdash; @_modalServerName</h3>

                <div class="patches-modal-summary">
                    <div class="patches-modal-row">
                        <span class="patches-modal-label">Installed:</span>
                        <span><strong>@_modalStatus.InstalledBuild</strong> @(_modalStatus.InstalledLabel ?? "") (@_modalStatus.InstalledReleaseDate?.ToString("yyyy-MM-dd"))</span>
                    </div>
                    <div class="patches-modal-row">
                        <span class="patches-modal-label">Latest:</span>
                        <span><strong>@_modalStatus.LatestBuild</strong> (@_modalStatus.LatestReleaseDate?.ToString("yyyy-MM-dd"))</span>
                    </div>
                    <div class="patches-modal-row">
                        <span class="patches-modal-label">Behind by:</span>
                        <span>@_modalStatus.PatchesBehind CUs · @_modalStatus.DaysBehind days · approx @_modalStatus.AgeYears years old</span>
                    </div>
                    <div class="patches-modal-row">
                        <span class="patches-modal-label">Support status:</span>
                        <span class="patches-modal-lifecycle patches-modal-lifecycle-@_modalStatus.LifecycleStatus.ToString().ToLowerInvariant()">@_modalStatus.LifecycleLabel</span>
                    </div>
                    @if (_modalStatus.MainstreamSupportEnds.HasValue)
                    {
                        <div class="patches-modal-row">
                            <span class="patches-modal-label">Mainstream ends:</span>
                            <span>@_modalStatus.MainstreamSupportEnds.Value.ToString("yyyy-MM-dd")</span>
                        </div>
                    }
                    @if (_modalStatus.ExtendedSupportEnds.HasValue)
                    {
                        <div class="patches-modal-row">
                            <span class="patches-modal-label">Extended ends:</span>
                            <span>@_modalStatus.ExtendedSupportEnds.Value.ToString("yyyy-MM-dd")</span>
                        </div>
                    }
                </div>

                <h4 style="margin-top:18px;">Risk story</h4>
                <p style="color:var(--text-secondary);font-size:13px;line-height:1.55;">
                    @PatchRiskStory(_modalStatus)
                </p>

                @if (_modalStatus.MissedPatchesSample.Count > 0)
                {
                    <h4 style="margin-top:18px;">Sample of missed CUs</h4>
                    <div class="patches-modal-list">
                        @foreach (var p in _modalStatus.MissedPatchesSample)
                        {
                            <div class="patches-modal-patch">
                                <span class="patches-modal-patch-build">@p.Build</span>
                                <span class="patches-modal-patch-label">@p.Label</span>
                                <span class="patches-modal-patch-date">@p.ReleaseDate?.ToString("yyyy-MM-dd")</span>
                                @if (!string.IsNullOrEmpty(p.Kb))
                                {
                                    <span class="patches-modal-patch-kb">@p.Kb</span>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="dialog-actions" style="margin-top:18px;">
                    <button class="btn btn-secondary" @onclick="ClosePatchesModal">Close</button>
                </div>
            </div>
        </div>
    }
</div>

} @* end RBAC else *@

@code {
    private List<ServerConnection> Connections = new();
    private Dictionary<string, ExecutiveHealthScore> _serverScores = new(StringComparer.OrdinalIgnoreCase);
    private int _currentPage = 1;
    private int _pageSize = 15;
    private int _totalPages => Math.Max(1, (int)Math.Ceiling(FilteredConnections.Count() / (double)_pageSize));
    private IEnumerable<ServerConnection> _pagedConnections => FilteredConnections.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);
    private Dictionary<string, bool> SqlWatchStatus = new();
    private Dictionary<string, bool> PerformanceMonitorStatus = new();
    private Dictionary<string, BuildStatus?> _buildStatusByServer = new(StringComparer.OrdinalIgnoreCase);
    private bool _showPatchesModal;
    private BuildStatus? _modalStatus;
    private string? _modalServerName;
    private string? StatusMessage;
    private bool IsSuccess;
    private bool ShowDialog;
    private bool IsEditing;
    private bool ShowDeleteConfirm;
    private ServerConnection? ConnectionToDelete;
    private ServerConnection EditingConnection = new();
    private string EditingAuthType = AuthenticationTypes.Windows;
    private string EditingPassword = "";
    private string _editingTagsText = "";
    private bool _isTestingAll = false;
    private string[] Instances = Array.Empty<string>();

    // Filtering
    private string? _filterEnvironment;
    private string? _filterTag;
    private HashSet<string> _allTags = new();
    private HashSet<string> _allEnvironments = new();

    private IEnumerable<ServerConnection> FilteredConnections => Connections.Where(c =>
        (_filterEnvironment == null || string.Equals(c.Environment, _filterEnvironment, StringComparison.OrdinalIgnoreCase)) &&
        (_filterTag == null || (c.Tags != null && c.Tags.Contains(_filterTag, StringComparer.OrdinalIgnoreCase))));

    private void SetAuthType(string authType)
    {
        EditingAuthType = authType;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        LoadConnections();
        _serverScores = await HealthService.GetAllHealthScoresAsync();
    }

    private void ShowPatchesModal(string serverName, BuildStatus status)
    {
        _showPatchesModal = true;
        _modalStatus = status;
        _modalServerName = serverName;
    }

    private void ClosePatchesModal()
    {
        _showPatchesModal = false;
        _modalStatus = null;
        _modalServerName = null;
    }

    private async Task ProbeServerBuildAsync(string serverName)
    {
        if (_buildStatusByServer.ContainsKey(serverName)) return;
        try
        {
            var facts = await LicensingEstimator.ProbeServerAsync(serverName);
            if (facts == null || string.IsNullOrEmpty(facts.ProductVersion))
            {
                _buildStatusByServer[serverName] = null;
                return;
            }
            _buildStatusByServer[serverName] = BuildCatalogue.Lookup(facts.ProductVersion);
        }
        catch
        {
            _buildStatusByServer[serverName] = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string PatchRiskStory(BuildStatus s)
    {
        var parts = new List<string>();
        if (s.LifecycleStatus == LifecycleStatusKind.OutOfSupport)
            parts.Add("Out of Microsoft support entirely — no security patches, no fixes, no escalation path with Microsoft.");
        else if (s.LifecycleStatus == LifecycleStatusKind.ExtendedSupportOnly)
            parts.Add("In Extended Support only — security patches still issued, but no feature work or design changes.");
        else if (s.LifecycleStatus == LifecycleStatusKind.MainstreamEndingSoon)
            parts.Add("Mainstream support ends within 12 months.");

        if (s.PatchesBehind > 0)
            parts.Add($"Missing {s.PatchesBehind} cumulative updates, including potentially security and performance fixes released over the last {s.DaysBehind} days.");
        if (s.AgeYears is > 5)
            parts.Add($"The installed version is approximately {s.AgeYears} years old.");

        if (parts.Count == 0)
            return "Build is current. Continue scheduled patching cadence.";

        return string.Join(" ", parts);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Cross-page hand-off: /servers?add=NAME opens THIS dialog pre-filled with a name
            // discovered elsewhere (today: a replication participant found by the Replication
            // Map). The discovering page writes nothing itself — every add still goes through
            // this dialog, one server at a time, saved by the operator into the guarded
            // server-connections store. The name is a pre-fill, not a commitment.
            //
            // Three outcomes, three behaviours. A REFUSED value is not an absent one: it opens
            // the dialog EMPTY and says why, in both the empty-catalogue and populated-catalogue
            // cases. It used to fall through to the ordinary first-add path, where the dialog
            // pre-fills itself from local bulk discovery — so an operator arriving from a
            // hand-off met a populated field, no refusal, and no way to know the names in front
            // of them were not the name they had asked for.
            var request = SQLTriage.Data.Services.ServerAddPrefill.Read(Navigation.Uri);
            if (request.Outcome == SQLTriage.Data.Services.AddPrefillOutcome.Accepted)
            {
                await ShowAddDialogCore(discoverLocalInstances: false);
                EditingConnection.ServerNames = request.Name;
                StateHasChanged();
                return;
            }
            if (request.Outcome == SQLTriage.Data.Services.AddPrefillOutcome.Refused)
            {
                _addPrefillRefusal = request.Reason;
                AuditLog.LogSecurityEvent(
                    "A /servers?add= pre-fill was refused and disclosed; the dialog was opened empty",
                    AuditSeverity.Warning,
                    new Dictionary<string, string> { ["Reason"] = request.Reason });
                await ShowAddDialogCore(discoverLocalInstances: false);
                EditingConnection.ServerNames = string.Empty;
                StateHasChanged();
                return;
            }

            // Auto-open dialog if no servers exist
            if (Connections.Count == 0)
            {
                await ShowAddDialog();
                StateHasChanged();
            }
            else if (!_isTestingAll)
            {
                _isTestingAll = true;
                await TestAllConnectionsSilently();

                // After connection tests resolve, probe each successful server for build status
                if (BuildCatalogue.IsAvailable)
                {
                    foreach (var conn in Connections)
                    {
                        foreach (var srv in conn.SuccessfulServers)
                        {
                            _ = ProbeServerBuildAsync(srv);
                        }
                    }
                }
            }
        }
    }

    private void LoadConnections()
    {
        Connections = ConnectionManager.GetConnections();
        RebuildFilterOptions();

    }

    private void RebuildFilterOptions()
    {
        _allTags = Connections.Where(c => c.Tags != null).SelectMany(c => c.Tags).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _allEnvironments = Connections.Where(c => !string.IsNullOrEmpty(c.Environment)).Select(c => c.Environment!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(e => e).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>Set when <c>/servers?add=</c> carried a value this page refused. Rendered in the
    /// dialog, so the refusal is visible on the surface the operator was sent to.</summary>
    private string? _addPrefillRefusal;

    private Task ShowAddDialog() => ShowAddDialogCore(discoverLocalInstances: true);

    /// <param name="discoverLocalInstances">False for a <c>?add=</c> arrival. The bulk local
    /// discovery pre-fill is the right default for someone who opened this dialog themselves and
    /// the wrong one for someone sent here asking for a specific server: a refused hand-off must
    /// not silently become a list of names nobody asked for.</param>
    private async Task ShowAddDialogCore(bool discoverLocalInstances)
    {
        // Pre-fill Server Name(s) with locally discovered SQL instances
        // when no servers are configured yet — saves a manual lookup for
        // the first-add case. Honest-UX: best-effort discovery; user
        // edits the list before Save. Registry returns instantly;
        // SqlDataSourceEnumerator (network broadcast) is capped at 2 s
        // so the dialog opens within ~2 s instead of the old 45 s.
        var prefilledNames = string.Empty;
        if (discoverLocalInstances && Connections.Count == 0 && OperatingSystem.IsWindows())
        {
            try
            {
                // Registry returns immediately; SqlDataSourceEnumerator (network
                // broadcast) is capped at 2 s. On timeout we still get the registry list.
                var locals = await SQLTriage.Data.Services.LocalSqlInstanceDiscoverer
                    .DiscoverLocalAsync(TimeSpan.FromSeconds(2));
                if (locals.Count > 0) prefilledNames = string.Join("\n", locals);
            }
            catch { /* swallow — UX defaulting only */ }
        }

        EditingConnection = new ServerConnection
        {
            ServerNames = prefilledNames,
            Database = "master",
            UseWindowsAuthentication = true,
            AuthenticationType = AuthenticationTypes.Windows,
            TrustServerCertificate = true,
            ConnectionTimeout = 15
        };
        EditingAuthType = AuthenticationTypes.Windows;
        EditingPassword = "";
        _editingTagsText = "";
        IsEditing = false;
        // A dialog the operator opened themselves is not answering any hand-off, so it must not
        // inherit a refusal notice from one.
        if (discoverLocalInstances) _addPrefillRefusal = null;
        ShowDialog = true;
    }

    private void EditConnection(ServerConnection conn)
    {
        EditingConnection = new ServerConnection
        {
            Id = conn.Id,
            ServerNames = conn.ServerNames,
            Database = conn.Database,
            UseWindowsAuthentication = conn.UseWindowsAuthentication,
            AuthenticationType = conn.AuthenticationType,
            Username = conn.Username,
            TrustServerCertificate = conn.TrustServerCertificate,
            ConnectionTimeout = conn.ConnectionTimeout,
            IsConnected = conn.IsConnected,
            IsEnabled = conn.IsEnabled,
            Environment = conn.Environment,
            PortalUrgentEvents = conn.PortalUrgentEvents,
            Tags = new List<string>(conn.Tags),
            SuccessfulServers = new List<string>(conn.SuccessfulServers),
            LastConnected = conn.LastConnected
        };
        EditingAuthType = conn.EffectiveAuthType;
        EditingPassword = "";
        _editingTagsText = conn.Tags != null ? string.Join(", ", conn.Tags) : "";
        IsEditing = true;
        ShowDialog = true;
    }

    private void CloseDialog()
    {
        ShowDialog = false;
        _addPrefillRefusal = null;
    }

    private async Task SaveConnection()
    {
        try
        {
            await Task.CompletedTask;
            if (string.IsNullOrWhiteSpace(EditingConnection.ServerNames))
            {
                StatusMessage = "Server name is required";
                IsSuccess = false;
                return;
            }

            // Sync auth type from radio selection
            EditingConnection.AuthenticationType = EditingAuthType;
            EditingConnection.UseWindowsAuthentication = EditingAuthType == AuthenticationTypes.Windows;

            // Parse tags from comma-separated text
            EditingConnection.Tags = string.IsNullOrWhiteSpace(_editingTagsText)
                ? new List<string>()
                : _editingTagsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

            // Set password if provided (SQL auth only)
            if (!string.IsNullOrEmpty(EditingPassword))
            {
                EditingConnection.SetPassword(EditingPassword);
            }

            // Split server names by newline to create separate connections
            var serverNames = EditingConnection.ServerNames
                .Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim())
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .ToList();

            if (serverNames.Count == 0)
            {
                StatusMessage = "Server name is required";
                IsSuccess = false;
                return;
            }

            if (IsEditing)
            {
                // For edit, update as single connection — no duplicate check needed
                var priorEnv = ConnectionManager.GetConnection(EditingConnection.Id)?.Environment;
                EditingConnection.ServerNames = string.Join("\n", serverNames);
                var updateResult = ConnectionManager.UpdateConnection(EditingConnection);
                if (!updateResult.Succeeded)
                {
                    // Licence refusal (or a vanished connection) — say so and stop. Never fall
                    // through to "updated successfully", which would be a lie.
                    StatusMessage = updateResult.Reason!;
                    IsSuccess = false;
                    return;
                }

                // Audit the environment change whenever it differs from the prior value
                var newEnv = EditingConnection.Environment;
                if (!string.Equals(priorEnv, newEnv, StringComparison.OrdinalIgnoreCase))
                {
                    AuditLog.LogConfigurationChange(
                        "ServerConnection",
                        "EnvironmentTagChanged",
                        string.IsNullOrEmpty(priorEnv) ? "(none)" : priorEnv,
                        string.IsNullOrEmpty(newEnv)   ? "(none)" : newEnv,
                        System.Environment.UserName);
                }

                StatusMessage = "Server connection updated successfully";
            }
            else
            {
                // Get all existing server names to check for duplicates
                var existingServerNames = Connections
                    .SelectMany(c => c.GetServerList())
                    .Select(s => s.ToLowerInvariant())
                    .ToHashSet();

                // Filter out servers that already exist
                var newServerNames = serverNames
                    .Where(s => !existingServerNames.Contains(s.ToLowerInvariant()))
                    .ToList();

                var skippedCount = serverNames.Count - newServerNames.Count;

                if (newServerNames.Count == 0)
                {
                    StatusMessage = skippedCount > 0
                        ? $"All {skippedCount} server(s) already exist - nothing to add"
                        : "Server name is required";
                    IsSuccess = skippedCount > 0;
                    return;
                }

                // For new, create separate connection for each server name on separate line
                var addedConnections = new List<ServerConnection>();

                if (newServerNames.Count == 1)
                {
                    // Single server - create one connection
                    EditingConnection.ServerNames = newServerNames[0];
                    var addResult = ConnectionManager.AddConnection(EditingConnection);
                    if (!addResult.Succeeded)
                    {
                        StatusMessage = addResult.Reason!;
                        IsSuccess = false;
                        return;
                    }
                    addedConnections.Add(EditingConnection);
                    StatusMessage = skippedCount > 0
                        ? $"Added 1 server ({skippedCount} skipped - already exists)"
                        : "Server connection added successfully";
                }
                else
                {
                    // Multiple servers on separate lines - create separate connections
                    string? refusal = null;
                    foreach (var serverName in newServerNames)
                    {
                        var newConn = new ServerConnection
                        {
                            ServerNames = serverName,
                            Database = EditingConnection.Database,
                            AuthenticationType = EditingConnection.AuthenticationType,
                            UseWindowsAuthentication = EditingConnection.UseWindowsAuthentication,
                            Username = EditingConnection.Username,
                            Password = EditingConnection.Password,
                            TrustServerCertificate = EditingConnection.TrustServerCertificate,
                            ConnectionTimeout = EditingConnection.ConnectionTimeout,
                            IsEnabled = EditingConnection.IsEnabled,
                            Environment = EditingConnection.Environment,
                            PortalUrgentEvents = EditingConnection.PortalUrgentEvents,
                            Tags = new List<string>(EditingConnection.Tags ?? new List<string>())
                        };
                        var addResult = ConnectionManager.AddConnection(newConn);
                        if (!addResult.Succeeded)
                        {
                            // The licence ran out PART WAY through the list. Keep what was added
                            // (removing it would be a surprise) and stop, then report exactly what
                            // landed and what did not. Reporting "Added N servers" here would be a
                            // lie the operator only discovers at report time.
                            refusal = addResult.Reason;
                            break;
                        }
                        addedConnections.Add(newConn);
                    }

                    if (refusal != null)
                    {
                        StatusMessage = addedConnections.Count == 0
                            ? refusal
                            : $"Added {addedConnections.Count} of {newServerNames.Count} servers, then stopped: {refusal}";
                        IsSuccess = false;
                        if (addedConnections.Count > 0) LoadConnections();
                        return;
                    }

                    StatusMessage = skippedCount > 0
                        ? $"Added {newServerNames.Count} servers ({skippedCount} skipped - already exist)"
                        : $"Added {newServerNames.Count} server connections";
                }

                IsSuccess = true;
                // On first add (nothing selected yet), make the new connection the
                // current server so the top-bar "Connected to:" reflects it immediately
                // instead of waiting for the next re-init / showing a transient (None).
                // Establish, not retarget: the intent recorded in the comment above is exactly what
                // ConnectionRetargetGrant.Establish permits, and the manager — which holds the
                // process-wide value, unlike this scoped service's CurrentServerId — enforces it.
                if (addedConnections.Count > 0 && string.IsNullOrEmpty(ServerContext.CurrentServerId))
                    await ServerContext.SetServerAsync(
                        addedConnections[0].Id, SQLTriage.Data.ConnectionRetargetGrant.Establish);
                LoadConnections();
                CloseDialog();

                // Auto-test every newly added connection
                foreach (var conn in addedConnections)
                    await TestConnection(conn);

                return;
            }

            IsSuccess = true;
            LoadConnections();
            CloseDialog();

            // Edit path — test the updated connection
            if (IsEditing)
            {
                await TestConnection(EditingConnection);
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error saving connection: {ex.Message}";
            IsSuccess = false;
        }
    }

    private void DeleteConnection(ServerConnection conn)
    {
        ConnectionToDelete = conn;
        ShowDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        ShowDeleteConfirm = false;
        ConnectionToDelete = null;
    }

    private void ConfirmDelete()
    {
        if (ConnectionToDelete != null)
        {
            var result = ConnectionManager.RemoveConnection(ConnectionToDelete.Id);
            // A locked licence refuses removal of a SEATED profile (remove-then-add would otherwise
            // rotate a seat onto a new box for free). Say why; never claim a delete that didn't happen.
            StatusMessage = result.Succeeded ? "Server connection deleted" : result.Reason!;
            IsSuccess = result.Succeeded;
            if (result.Succeeded) LoadConnections();
        }
        ShowDeleteConfirm = false;
        ConnectionToDelete = null;
    }

    private void GoToBaseline(string serverName)
        => Navigation.NavigateTo($"/servers/baseline?server={Uri.EscapeDataString(serverName)}");

    private async Task TestConnection(ServerConnection conn)
    {
        var isMfa = conn.EffectiveAuthType == AuthenticationTypes.EntraMFA;

        StatusMessage = isMfa
            ? "Testing connection — please complete authentication in the browser popup..."
            : "Testing connection...";
        IsSuccess = false;
        StateHasChanged();

        try
        {
            // Serialise MFA attempts so only one browser popup appears at a time
            if (isMfa) await MfaAuthenticationHelper.MfaAuthLock.WaitAsync();

            try
            {
                // pages-r2-07: there was no per-server try/catch here. The FIRST OpenAsync failure
                // unwound the whole loop into the outer catch, which persisted an EMPTY successful-
                // server list - discarding servers that had connected moments earlier and recording
                // a total failure over a proven partial success. Proved live at hunt time on a
                // '.\NEW2022;.\OLD2017' connection. Each server is now measured on its own, and the
                // "Connected to N of M" arm below - which was unreachable dead code - is real.
                var serverList = conn.GetServerList();
                var successfulServers = new List<string>();
                var failures = new List<ConnectionTestFailure>();
                var cancelled = false;

                foreach (var serverName in serverList)
                {
                    try
                    {
                        // Use master database for connection test to allow testing before SQLWATCH is deployed
                        var connectionString = conn.GetConnectionString(serverName, "master");
                        using var connection = new SqlConnection(connectionString);
                        await connection.OpenAsync();
                        successfulServers.Add(serverName);
                    }
                    catch (Exception ex) when (isMfa && MfaAuthenticationHelper.IsMfaCancelledException(ex))
                    {
                        // Cancelled: the remaining servers were never contacted, so nothing is
                        // persisted - a partial list would record untested servers as failures.
                        cancelled = true;
                        break;
                    }
                    catch (Exception ex)
                    {
                        failures.Add(new ConnectionTestFailure(serverName, ex.Message));
                    }
                }

                var report = new ConnectionTestReport(serverList.Count, successfulServers, failures, cancelled);

                // lane9-07: Complete is the gate on PERSISTENCE, and it now requires that at least
                // one server was planned. A connection whose ServerNames is whitespace used to
                // satisfy it vacuously (0 attempted of 0 planned), so this branch wrote
                // StatusMeasuredThisSession=true / IsConnected=false and the row rendered "Did not
                // answer - checked this session." for a connection nothing had contacted, under a
                // message saying exactly that nothing had been contacted.
                if (report.Complete)
                {
                    ConnectionManager.UpdateSuccessfulServers(conn.Id, successfulServers);
                    await CheckSqlWatchDatabase(conn);
                    await CheckPerformanceMonitorDatabase(conn);
                }
                LoadConnections();

                StatusMessage = ConnectionTestText.Describe(report);
                if (ConnectionTestText.DescribeAuthHint(report) is { } hint) StatusMessage += hint;
                IsSuccess = report.Complete && failures.Count == 0;
            }
            finally
            {
                if (isMfa) MfaAuthenticationHelper.MfaAuthLock.Release();
            }
        }
        catch (Exception ex)
        {
            // Only an unexpected failure OUTSIDE the per-server loop reaches here (the MFA lock,
            // the SQLWATCH/PerfMon follow-up reads). It is not evidence about any server, so the
            // stored status is left exactly as the loop above found it.
            StatusMessage = $"The connection test did not complete: {ex.Message}";
            IsSuccess = false;
            LoadConnections();
        }
    }


    /// <summary>
    /// Tests all connections silently on page load without showing status messages.
    /// Only non-MFA connections are tested automatically to avoid unexpected browser popups.
    /// </summary>
    private async Task TestAllConnectionsSilently()
    {
        var connsToTest = Connections
            .Where(c => c.IsEnabled && c.EffectiveAuthType != AuthenticationTypes.EntraMFA)
            .ToList();

        foreach (var conn in connsToTest)
        {
            try
            {
                var serverList = conn.GetServerList();
                var successfulServers = new List<string>();

                foreach (var serverName in serverList)
                {
                    try
                    {
                        // Use master database for connection test to allow testing before SQLWATCH is deployed
                        var connectionString = conn.GetConnectionString(serverName, "master");
                        using var connection = new SqlConnection(connectionString);
                        await connection.OpenAsync();
                        successfulServers.Add(serverName);
                    }
                    catch
                    {
                        // Individual server failed — don't stop testing others
                    }
                }

                // lane9-07: the same guard as the Test button, and this path is the one that
                // matters most - TestAllConnectionsSilently runs on EVERY /servers load, with no
                // click. A connection with no server names contacted nothing, so writing a result
                // for it would stamp "checked this session" on a probe that never happened and put
                // it in the red count automatically.
                if (serverList.Count > 0)
                    ConnectionManager.UpdateSuccessfulServers(conn.Id, successfulServers);
            }
            catch (Exception ex)
            {
                // pages-r2-07, same class as the Test button: this used to persist an EMPTY
                // successful-server list. Every per-server failure is already handled inside the
                // loop, so anything reaching here failed OUTSIDE a probe and is not evidence about
                // any server. The stored status is left alone rather than overwritten with a
                // failure nobody measured.
                Logger.LogWarning(ex, "[Servers] silent connection sweep failed for {ConnectionId} outside a server probe", conn.Id);
            }
        }

        LoadConnections();
        await CheckAllDatabaseStatuses();
        await InvokeAsync(StateHasChanged);
        _isTestingAll = false;
    }

    private async Task CheckSqlWatchDatabase(ServerConnection conn)
    {
        try
        {
            var serverList = conn.GetServerList();
            foreach (var serverName in serverList)
            {
                // Always use master database for testing to avoid connection failures
                // when SQLWATCH database doesn't exist yet
                var connectionString = conn.GetConnectionString(serverName, "master");
                using var connection = new SqlConnection(connectionString);
                await connection.OpenAsync();
                using var cmd = connection.CreateCommand();
                cmd.CommandText = "SELECT COUNT(*) FROM sys.databases WHERE name = 'SQLWATCH'";
                var result = (int)await cmd.ExecuteScalarAsync();
                SqlWatchStatus[conn.Id] = result > 0;
                break; // Check first server only
            }
        }
        catch
        {
            SqlWatchStatus[conn.Id] = false;
        }
    }

    private async Task RefreshAllConnections()
    {
        StatusMessage = "Refreshing all connections...";

        // Build list of all server connections to test (connection object + server name)
        var allServersToTest = new List<(ServerConnection conn, string serverName)>();
        foreach (var conn in Connections)
        {
            foreach (var serverName in conn.GetServerList())
            {
                allServersToTest.Add((conn, serverName));
            }
        }

        // pages-r2-08: the tally accumulates ACROSS batches and is keyed by connection Id, which
        // fixes both halves of the finding. The old code wrote each connection's whole successful-
        // server list once per batch, so a connection straddling the batch boundary lost its first
        // batch's successes; and it grouped a batch's results by server NAME, so two connections
        // sharing a name absorbed each other's results (proved live: one connection persisted the
        // same server twice and was then excluded from its own success gate). A connection is
        // written only once every server planned for it has answered or failed.
        var tally = new ConnectionProbeTally(allServersToTest.Select(x => (x.conn.Id, x.serverName)));

        // Process in batches of 10 servers in parallel
        const int batchSize = 10;
        const int refreshTimeout = 5; // 5 seconds timeout for refresh all
        
        for (int i = 0; i < allServersToTest.Count; i += batchSize)
        {
            var batch = allServersToTest.Skip(i).Take(batchSize).ToList();
            var tasks = batch.Select(async item =>
            {
                var (conn, serverName) = item;
                var isMfa = conn.EffectiveAuthType == AuthenticationTypes.EntraMFA;
                
                try
                {
                    if (isMfa) await MfaAuthenticationHelper.MfaAuthLock.WaitAsync();
                    
                    try
                    {
                        // Use master database for connection test with 5-second timeout
                        var connectionString = conn.GetConnectionString(serverName, "master");
                        // Override timeout to 5 seconds for refresh all
                        connectionString = connectionString.Replace("Connect Timeout=", "Connection Timeout=");
                        if (!connectionString.Contains("Connection Timeout=") && !connectionString.Contains("Connect Timeout="))
                        {
                            connectionString += $";Connection Timeout={refreshTimeout}";
                        }
                        else
                        {
                            // Replace existing timeout with 5 seconds
                            connectionString = System.Text.RegularExpressions.Regex.Replace(
                                connectionString, 
                                @"(Connection|Connect) Timeout=\d+", 
                                $"Connection Timeout={refreshTimeout}");
                        }
                        
                        using var connection = new SqlConnection(connectionString);
                        await connection.OpenAsync();
                        return (conn.Id, serverName, true);
                    }
                    finally
                    {
                        if (isMfa) MfaAuthenticationHelper.MfaAuthLock.Release();
                    }
                }
                catch
                {
                    return (conn.Id, serverName, false);
                }
            });

            var results = await Task.WhenAll(tasks);

            // Each result carries the connection it belongs to, so nothing is attributed by server
            // name. Only connections whose every planned server has now been recorded are written.
            foreach (var (connectionId, serverName, answered) in results)
                tally.Record(connectionId, serverName, answered);

            foreach (var finishedId in tally.DrainCompletedConnections())
                ConnectionManager.UpdateSuccessfulServers(finishedId, tally.SuccessesFor(finishedId).ToList());

            // Update UI periodically
            LoadConnections();
            await InvokeAsync(StateHasChanged);
        }

        LoadConnections();

        StatusMessage = tally.DescribeSweep();
        IsSuccess = tally.SucceededServers > 0;
    }

    private async Task CheckPerformanceMonitorDatabase(ServerConnection conn)
    {
        try
        {
            var serverList = conn.GetServerList();
            foreach (var serverName in serverList)
            {
                var connectionString = conn.GetConnectionString(serverName, "master");
                using var connection = new SqlConnection(connectionString);
                await connection.OpenAsync();
                using var cmd = connection.CreateCommand();
                cmd.CommandText = "SELECT COUNT(*) FROM sys.databases WHERE name = 'PerformanceMonitor'";
                var result = (int)await cmd.ExecuteScalarAsync();
                PerformanceMonitorStatus[conn.Id] = result > 0;
                break; // Check first server only
            }
        }
        catch
        {
            PerformanceMonitorStatus[conn.Id] = false;
        }
    }

    private async Task CheckAllDatabaseStatuses()
    {
        foreach (var conn in Connections.Where(c => c.SuccessfulServers.Count > 0))
        {
            await CheckSqlWatchDatabase(conn);
            await CheckPerformanceMonitorDatabase(conn);
        }
    }

    private void DeleteAllDisconnected()
    {
        // pages-r1-03: this deleted every connection whose PERSISTED IsConnected was false,
        // including connections nothing had probed in this process - a destructive action taken on
        // a reading nobody made. Only a status measured this session can send a connection here.
        var disconnectedConnections = Connections
            .Where(c => ConnectionStatusText.Classify(c) == ConnectionStatusKind.DisconnectedNow)
            .ToList();
        var uncheckedCount = Connections.Count(c => ConnectionStatusText.Classify(c) == ConnectionStatusKind.NotCheckedThisSession);

        if (disconnectedConnections.Count == 0)
        {
            StatusMessage = uncheckedCount > 0
                ? $"No connection failed a check in this session. {uncheckedCount} connection(s) have not been "
                  + "checked at all - run Refresh All first, so nothing is deleted on a stored reading."
                : "No disconnected servers to delete";
            IsSuccess = true;
            return;
        }

        int deleted = 0;
        string? refusal = null;
        foreach (var conn in disconnectedConnections)
        {
            var result = ConnectionManager.RemoveConnection(conn.Id);
            if (result.Succeeded) deleted++;
            else refusal ??= result.Reason;
        }

        LoadConnections();
        // Count what ACTUALLY went, not what was attempted: a locked licence can refuse some of
        // these, and claiming the full count would misreport the estate.
        StatusMessage = refusal == null
            ? $"Deleted {deleted} disconnected server(s)"
            : deleted == 0
                ? refusal
                : $"Deleted {deleted} of {disconnectedConnections.Count} disconnected server(s): {refusal}";
        IsSuccess = refusal == null;
    }
}