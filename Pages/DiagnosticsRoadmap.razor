    // ── Lifecycle ──
    protected override async Task OnInitializedAsync()
    {
        if (UserSettings.GetFastAppLoad()) await Task.Yield();
        await ScanOutputFolder();
        // Auto-select the preferred file per server (AuditFileSelection holds the rule).
        // This selects all servers across all domains on first load.
        if (_availableServers.Count > 0)
        {
            var preferred = _availableServers
                .GroupBy(s => s.SqlInstance, StringComparer.OrdinalIgnoreCase)
                .Select(g => AuditFileSelection.InPreferenceOrder(g).First())
                .ToList();
            foreach (var srv in _availableServers)
                srv.IsSelected = preferred.Any(p => ReferenceEquals(p, srv));
            await RecalculateWithFallbackAsync();
        }

        // Load schedule settings and start background timer
        LoadScheduleSettings();
        StartScheduleTimer();

        // Keyboard shortcuts
#if !SQLT_NO_REPORT_ROADMAP
        ShortcutSvc.OnExportPdfRequested += OnShortcutPdf;
#endif
        ShortcutSvc.OnExportCsvRequested += OnShortcutCsv;
    }

    public void Dispose()
    {
        _scheduleTimer?.Stop();
        _scheduleTimer?.Dispose();
#if !SQLT_NO_REPORT_ROADMAP
        ShortcutSvc.OnExportPdfRequested -= OnShortcutPdf;
#endif
        ShortcutSvc.OnExportCsvRequested -= OnShortcutCsv;
    }

#if !SQLT_NO_REPORT_ROADMAP
    private async Task OnShortcutPdf() => await InvokeAsync(ExportQuestPdf);
#endif
    private Task OnShortcutCsv()       { InvokeAsync(ExportCsv); return Task.CompletedTask; }

    private void LoadScheduleSettings()
    {
        var s = UserSettings.GetRoadmapSchedule();
        _scheduleEnabled       = s.Enabled;
        _scheduleType          = s.Type;
        _scheduleTime          = s.Time;
        _scheduleDayOfWeek     = s.DayOfWeek;
        _scheduleDayOfMonth    = s.DayOfMonth;
        _scheduleSplitByDomain = s.SplitByDomain;
        _scheduleLastRun       = s.LastRun;
    }

    private void SaveSchedule()
    {
        UserSettings.SaveRoadmapSchedule(_scheduleEnabled, _scheduleType, _scheduleTime,
            _scheduleDayOfWeek, _scheduleDayOfMonth, _scheduleSplitByDomain);
        _showScheduleModal = false;
        // Restart timer so new schedule takes effect immediately
        StartScheduleTimer();
    }

    private void StartScheduleTimer()
    {
        _scheduleTimer?.Stop();
        _scheduleTimer?.Dispose();
        // Check every 60 seconds whether the export is due
        _scheduleTimer = new System.Timers.Timer(60_000);
        _scheduleTimer.Elapsed += async (_, _) => await CheckScheduleDueAsync();
        _scheduleTimer.AutoReset = true;
        _scheduleTimer.Start();
    }

    private async Task CheckScheduleDueAsync()
    {
        if (!_scheduleEnabled || _exporting) return;

        var s   = UserSettings.GetRoadmapSchedule();
        var now = DateTime.Now;

        bool due = s.Type switch
        {
            "Daily"   => IsTimeReached(s.Time, now) && s.LastRun.ToLocalTime().Date < now.Date,
            "Weekly"  => now.DayOfWeek == (DayOfWeek)s.DayOfWeek
                         && IsTimeReached(s.Time, now)
                         && s.LastRun.ToLocalTime().Date < now.Date,
            "Monthly" => now.Day == Math.Min(s.DayOfMonth, DateTime.DaysInMonth(now.Year, now.Month))
                         && IsTimeReached(s.Time, now)
                         && s.LastRun.ToLocalTime().Date < now.Date,
            _ => false
        };

        if (!due) return;

        Logger.LogInformation("Scheduled roadmap PDF export triggered ({Type} at {Time})", s.Type, s.Time);
        UserSettings.UpdateRoadmapScheduleLastRun(DateTime.UtcNow);
        _scheduleLastRun = DateTime.UtcNow;

        // Temporarily apply split-by-domain setting from schedule config
        var prevSplit = _splitByDomain;
        _splitByDomain = s.SplitByDomain;

#if !SQLT_NO_REPORT_ROADMAP
        await InvokeAsync(async () => await ExportQuestPdf());
#endif

        _splitByDomain = prevSplit;
    }

    private static bool IsTimeReached(string hhMm, DateTime now)
    {
        if (!TimeSpan.TryParse(hhMm, out var t)) return false;
        return now.TimeOfDay >= t && now.TimeOfDay < t.Add(TimeSpan.FromMinutes(2));
    }

    // ── Output folder scan ──
    // ONE implementation, in AuditOutputScanner. This page used to repeat the discovery rule, the
    // header resolution and the date read; the sp_Blitz CSV changed shape on 2026-08-24 (its select
    // list now emits sp_Blitz's own twelve output-table columns so the Export Pack can read the
    // file), and a second copy of that reading is exactly what would have been left behind.
    private async Task ScanOutputFolder()
    {
        _loading        = true;
        _loadingMessage = "Scanning output folder for audit files…";
        _loadProgress   = 10;
        StateHasChanged();

        var scan = await AuditScanner.ScanAsync();

        // A CSV that named no server is NOT "no audit files found". It is a file this page cannot
        // attribute to an instance, and dropping it silently prints an empty-folder message over a
        // folder with a server's audit in it. Same rule as the unreadable-parse banner below: a
        // thing that could not be read says so, and is never absent.
        _unattributedOutputFiles = scan.Unreadable
            .Select(u => $"{Path.GetFileName(u.FilePath)}: {u.Reason}")
            .ToList();

        // A rescan re-reads the folder, so every earlier auto-selection note is about files this
        // scan has not judged yet.
        _autoSelectSkipped = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        _availableServers = scan.Files
            .Select(f => new AuditedServer
            {
                SqlInstance = f.SqlInstance,
                Domain      = f.Domain,
                AuditDate   = f.AuditDate,
                FilePath    = f.FilePath,
                FileType    = f.FileType,
            })
            .ToList();

        _loading      = false;
        _loadProgress = 100;
        StateHasChanged();
    }

    private async Task RefreshOutputFolder()
    {
        _availableServers.Clear();
        _maturityLevels.Clear();
        await ScanOutputFolder();
    }

    // ── Server toggle (multi-select) ──
    private async Task OnServerToggled(AuditedServer server, bool isChecked)
    {
        server.IsSelected = isChecked;
        // The operator has now chosen this file themselves. Whatever the automatic pick did with it
        // is history, and the page must not show a "scored something else instead" note beside a
        // refusal for the same file.
        if (isChecked) _autoSelectSkipped.Remove(server.FilePath);
        if (!isChecked)
        {
            server.CheckCounts.Clear();
            server.ParseOutcome = AuditParseOutcome.NotParsed;
            server.ParseFailureReason = "";
        }
        await RecalculateFromSelected();
    }

    // ── Load & parse a single audit file into server.CheckCounts ──
    // Delegates to the scanner's parse (see ScanOutputFolder) rather than repeating it.
    private async Task LoadServerData(AuditedServer server)
    {
        _loading        = true;
        _loadingMessage = $"Reading {(server.FileType == AuditFileType.SpBlitz ? "sp_Blitz" : "sp_triage")} for {server.SqlInstance}…";
        _loadProgress   = 20;
        StateHasChanged();

        var file = new AuditedFile
        {
            SqlInstance = server.SqlInstance,
            Domain      = server.Domain,
            AuditDate   = server.AuditDate,
            FilePath    = server.FilePath,
            FileType    = server.FileType,
        };

        await AuditScanner.LoadFiredChecksAsync(file);
        server.CheckCounts = file.FiredCheckCounts;
        server.ParseOutcome = file.ParseOutcome;
        server.ParseFailureReason = file.ParseFailureReason;

        _loadProgress = 100;
    }

    // Drops every derived number back to its unscored default. Used whenever there is nothing to
    // score and whenever scoring is REFUSED, so a suppressed run cannot leave the previous run's
    // headline, level or badge counts on screen or in an export.
    private void ClearScores()
    {
        _maturityLevels.Clear();
        _expandedLevels.Clear();
        _serverLevels = new Dictionary<string, (int, double)>();
        _totalFindings = _passedFindings = _totalItemsImpacted = 0;
        _overallLevel = 1;
        _achievedLevel = 0;
        _overallScore = _riskWeightedScore = 0;
        _criticalCount = _highCount = _mediumCount = 0;
        _headlineFinding = "";
        _topThreeActions = new List<string>();
    }

    // ── Recalculate, and when the APP picked a dead file, pick the live one instead ──
    //
    // THE DEFECT THIS EXISTS TO FIX (cold gate, 2026-08-26). Auto-selection ranked file TYPE above
    // everything, so one sp_triage export carrying no sp_Blitz section rows out-ranked a scoreable
    // sp_Blitz export for the same instance. The page then refused to score the dead file (right)
    // and withheld the live report sitting beside it (wrong), telling the operator to re-run an
    // audit that had already run. A normal Full Audit self-heals because it runs sp_Blitz first, so
    // sp_triage sees a populated table; a standalone or stale sp_triage export never ages out of
    // the preference, so the page stayed blank indefinitely.
    //
    // The fallback runs ONLY where the app chose the file: first load, and the domain toggle. It
    // tries the same preference order among the remaining files for that instance and takes the
    // first that parses. Every file it steps over is named on screen with its reason. A file the
    // operator selects by hand is never substituted: that path still fails closed.
    private async Task RecalculateWithFallbackAsync()
    {
        await RecalculateFromSelected();
        if (!_auditDataUnreadable) return;

        bool swapped = false;
        var dead = _availableServers
            .Where(s => s.IsSelected && s.ParseOutcome == AuditParseOutcome.Unreadable)
            .ToList();

        foreach (var unreadable in dead)
        {
            var alternates = AuditFileSelection.InPreferenceOrder(
                _availableServers.Where(s =>
                    !ReferenceEquals(s, unreadable)
                    && !s.IsSelected
                    && string.Equals(s.SqlInstance, unreadable.SqlInstance, StringComparison.OrdinalIgnoreCase)
                    && s.ParseOutcome != AuditParseOutcome.Unreadable));

            foreach (var alt in alternates)
            {
                if (alt.ParseOutcome == AuditParseOutcome.NotParsed) await LoadServerData(alt);
                if (alt.ParseOutcome != AuditParseOutcome.Parsed) continue;

                unreadable.IsSelected = false;
                alt.IsSelected        = true;
                swapped               = true;
                _autoSelectSkipped[unreadable.FilePath] =
                    $"{Path.GetFileName(unreadable.FilePath)}: {unreadable.ParseFailureReason}. "
                    + $"Scored {Path.GetFileName(alt.FilePath)} for {alt.SqlInstance} instead.";
                Logger.LogWarning(
                    "Auto-selection stepped over {Dead} ({Reason}) and scored {Live} for {Instance}.",
                    unreadable.FilePath, unreadable.ParseFailureReason, alt.FilePath, alt.SqlInstance);
                break;
            }
        }

        if (swapped)
        {
            await RecalculateFromSelected();
            return;
        }

        // Nothing to fall back to. The refusal stands, and a parse attempt above may have left the
        // spinner up.
        _loading = false;
        StateHasChanged();
    }

    // ── Aggregate all selected servers and recalculate maturity ──
    private async Task RecalculateFromSelected()
    {
        _auditDataUnreadable = false;
        _unreadableAuditFiles = new List<string>();

        var selected = _availableServers.Where(s => s.IsSelected).ToList();
        if (selected.Count == 0)
        {
            ClearScores();
            StateHasChanged();
            return;
        }

        _loading        = true;
        _loadingMessage = $"Loading {selected.Count} file(s)…";
        _loadProgress   = 5;
        StateHasChanged();

        // Load any files not yet loaded
        int loaded = 0;
        foreach (var srv in selected)
        {
            if (srv.ParseOutcome == AuditParseOutcome.NotParsed)
            {
                await LoadServerData(srv);
            }
            loaded++;
            _loadProgress = 10 + loaded * 60.0 / selected.Count;
            StateHasChanged();
        }

        // FAIL CLOSED ON AN UNREADABLE FILE. Scoring the readable subset and staying quiet about
        // the rest would print a number the operator would read as covering everything selected.
        _unreadableAuditFiles = selected
            .Where(s => s.ParseOutcome == AuditParseOutcome.Unreadable)
            .Select(s => $"{s.SqlInstance} ({Path.GetFileName(s.FilePath)}): {s.ParseFailureReason}")
            .ToList();
        _auditDataUnreadable = _unreadableAuditFiles.Count > 0;
        if (_auditDataUnreadable)
        {
            Logger.LogWarning(
                "Maturity scoring suppressed: {Count} selected audit file(s) could not be read. {Files}",
                _unreadableAuditFiles.Count, string.Join(" | ", _unreadableAuditFiles));
            ClearScores();
            _loading = false;
            StateHasChanged();
            return;
        }

        _loadProgress   = 80;
        _loadingMessage = "Calculating combined maturity scores…";
        StateHasChanged();

        await Task.Run(() =>
        {
            var checkMap = LoadRoadmapMapping();

            // Merged view (all selected servers combined)
            var mergedFiredIds = new HashSet<int>();
            foreach (var srv in selected)
                foreach (var id in srv.CheckCounts.Keys)
                    mergedFiredIds.Add(id);

            var mergedCounts = new Dictionary<int, int>();
            foreach (var srv in selected)
                foreach (var (id, count) in srv.CheckCounts)
                    mergedCounts[id] = mergedCounts.TryGetValue(id, out var c) ? c + count : count;

            CalculateMaturity(mergedFiredIds, mergedCounts);

            // Per-server levels (only meaningful when >1 selected)
            _serverLevels = new Dictionary<string, (int, double)>();
            if (selected.Count > 1)
            {
                foreach (var srv in selected)
                {
                    var firedIds = new HashSet<int>(srv.CheckCounts.Keys);
                    _serverLevels[srv.SqlInstance] = ComputeLevel(firedIds, checkMap);
                }
            }
        });

        _expandedLevels.Add(_overallLevel);
        _loading = false;
        StateHasChanged();
    }

    // ── Maturity calculation from sp_Blitz findings ──
    private void CalculateMaturity(HashSet<int> firedIds, Dictionary<int, int>? checkCounts = null)
    {
        // Load check definitions from roadmap-mapping.json (bundle-first).
        // checkId → (FindingName, Level, Roadmap/category)
        _roadmapDataMissing = false;
        var checkMap = LoadRoadmapMapping();
        (_businessTranslation, _effortEstimate, _relatedFindings, _nextAction) = LoadRoadmapExtras();

        // Items impacted = sum of counts for mapped+fired IDs only (excludes informational/unmapped)
        _totalItemsImpacted = 0;
        if (checkCounts != null)
            foreach (var (id, count) in checkCounts)
                if (checkMap.ContainsKey(id))
                    _totalItemsImpacted += count;

        // Per-level, per-roadmap pass/fail accumulators
        // level → roadmap → (passed, total, failed(checkId,name,tag), passed(name,tag), info(checkId,name,tag))
        // Severity-aware bucketing: a fired check with IsBad=true → failed. A fired check
        // with IsBad=false (e.g. "Non-Default Config: X Changed") → info bucket and counts
        // as a pass for scoring/level-gating, but renders with a neutral icon so the user
        // can still see it triggered.
        var levelCatResults = new Dictionary<int, Dictionary<string, (int passed, int total, List<(int,string,string)> failed, List<(string,string)> passedList, List<(int,string,string)> infoList)>>();
        for (int i = 1; i <= 5; i++)
            levelCatResults[i] = new Dictionary<string, (int, int, List<(int,string,string)>, List<(string,string)>, List<(int,string,string)>)>(StringComparer.OrdinalIgnoreCase);

        _totalFindings  = 0;
        _passedFindings = 0;

        foreach (var (checkId, info) in checkMap)
        {
            var (findingName, level, roadmap, tag, isBad) = info;
            if (level < 1 || level > 5) continue;

            var catDict = levelCatResults[level];
            if (!catDict.ContainsKey(roadmap))
                catDict[roadmap] = (0, 0, new List<(int,string,string)>(), new List<(string,string)>(), new List<(int,string,string)>());

            var (p, t, f, pl, il) = catDict[roadmap];
            bool fired = firedIds.Contains(checkId);

            _totalFindings++; t++;
            if (fired && isBad)
            {
                // Real problem — fail bucket.
                f.Add((checkId, findingName, tag));
            }
            else if (fired)
            {
                // Informational fire — neutral bucket; counts as a pass for scoring.
                p++; _passedFindings++;
                il.Add((checkId, findingName, tag));
            }
            else
            {
                // Not fired — clean pass.
                p++; _passedFindings++;
                pl.Add((findingName, tag));
            }

            catDict[roadmap] = (p, t, f, pl, il);
        }

        // Build maturity levels
        _maturityLevels = new List<MaturityLevel>();

        for (int lvl = 1; lvl <= 5; lvl++)
        {
            var def      = LevelDefinitions[lvl];
            var catDict  = levelCatResults[lvl];
            int levelPassed = 0, levelTotal = 0;
            var categories  = new List<CategoryProgress>();

            foreach (var (catName, r) in catDict)
            {
                var (p, t, failedList, passedList, infoList) = r;
                levelPassed += p;
                levelTotal  += t;
                categories.Add(new CategoryProgress
                {
                    Category     = catName,
                    Total        = t,
                    Passed       = p,
                    PassRate     = t > 0 ? p * 100.0 / t : 0.0,
                    FailedChecks = failedList,
                    PassedChecks = passedList,
                    InfoChecks   = infoList
                });
            }

            _maturityLevels.Add(new MaturityLevel
            {
                Level           = lvl,
                Name            = def.Name,
                Description     = def.Description,
                Recommendations = def.Recommendations,
                Categories      = categories.OrderByDescending(c => c.Total).ThenBy(c => c.PassRate).ToList(),
                TotalChecks     = levelTotal,
                PassedChecks    = levelPassed,
                PassRate        = SQLTriage.Data.Services.RoadmapReportRules.PassRate(levelPassed, levelTotal)
            });
        }

        // The ladder, from the one rule every artefact reads. _achievedLevel is what the client PDF's
        // cover dots fill from ("achieved through"); _overallLevel is the stage being worked on, which
        // is what the big badge and the current-level highlight mean. They were one variable read two
        // ways, so a server failing Foundation outright still printed a filled Foundation dot.
        _achievedLevel = SQLTriage.Data.Services.RoadmapReportRules.AchievedLevel(
            _maturityLevels
                .Select(l => (l.PassedChecks, l.TotalChecks, SQLTriage.Data.Services.RoadmapReportRules.DefaultTargetPercent))
                .ToList());
        _overallLevel = SQLTriage.Data.Services.RoadmapReportRules.CurrentStage(_achievedLevel);

        var totalAll  = _maturityLevels.Sum(l => l.TotalChecks);
        var passedAll = _maturityLevels.Sum(l => l.PassedChecks);
        _overallScore = totalAll > 0 ? passedAll * 100.0 / totalAll : 0;

        // ── Risk-weighted score ──────────────────────────────────────
        // The banding and the weights are RoadmapReportRules'. The comment that used to sit here said
        // Critical was Level 1 only, High was Level 2 and Medium was Level 3 and up, weighting L2 at 2.
        // The code beneath it banded L1+L2 as Critical, L3 as High, L4+L5 as Medium and weighted L2 at
        // 4, which is also what the tooltips and the PDF chips showed. Two statements of one rule, and
        // the prose one was wrong. There is now one, and the PDF prints the banding beside the counts.
        var failedByLevel = new Dictionary<int, int>();
        for (int i = 1; i <= 5; i++) failedByLevel[i] = 0;
        foreach (var (checkId, info) in checkMap)
        {
            if (firedIds.Contains(checkId) && info.IsBad)
            {
                int lvl = Math.Clamp(info.Level, 1, 5);
                failedByLevel[lvl]++;
            }
        }
        _criticalCount = _highCount = _mediumCount = 0;
        double weightedFails = 0;
        for (int lvl = 1; lvl <= 5; lvl++)
        {
            var count = failedByLevel[lvl];
            switch (SQLTriage.Data.Services.RoadmapReportRules.SeverityBand(lvl))
            {
                case "Critical": _criticalCount += count; break;
                case "High":     _highCount     += count; break;
                default:         _mediumCount   += count; break;
            }
            weightedFails += count * SQLTriage.Data.Services.RoadmapReportRules.RiskWeight(lvl);
        }
        double weightedTotal = totalAll > 0 ? totalAll * SQLTriage.Data.Services.RoadmapReportRules.MaxRiskWeight : 1;
        _riskWeightedScore = totalAll > 0 ? Math.Max(0, 100.0 * (1.0 - weightedFails / weightedTotal)) : 0;

        // ── Headline finding ────────────────────────────────────────
        var allFails = new List<(int Level, string Finding, int Count)>();
        foreach (var level in _maturityLevels)
            foreach (var cat in level.Categories)
                foreach (var fc in cat.FailedChecks)
                    allFails.Add((level.Level, fc.Name, checkCounts != null && checkCounts.TryGetValue(fc.CheckId, out var cnt) ? cnt : 1));
        if (allFails.Any())
        {
            var worst = allFails.OrderBy(f => f.Level).ThenByDescending(f => f.Count).First();
            var serverLabel = _availableServers.Count(s => s.IsSelected) == 1
                ? _availableServers.First(s => s.IsSelected).SqlInstance
                : $"{_availableServers.Count(s => s.IsSelected)} servers";
            _headlineFinding = $"{serverLabel} has {_criticalCount} critical, {_highCount} high, and {_mediumCount} medium findings. The most urgent issue at maturity Level {worst.Level} is: \"{worst.Finding}\" affecting {worst.Count} item(s).";
        }
        else
        {
            _headlineFinding = $"All {_totalFindings} checks passed across selected servers. No findings require action.";
        }

        // ── Top 3 actions ───────────────────────────────────────────
        var groupedFails = allFails.GroupBy(f => f.Finding).OrderByDescending(g => g.Count()).Take(3);
        _topThreeActions = groupedFails.Select(g => $"{g.Key} ({g.Count()} item(s) affected)").ToList();
        if (!_topThreeActions.Any())
            _topThreeActions = new List<string> { "No failed findings — all checks passed successfully." };
    }



    // ── Lightweight per-server level computation (no full maturity build) ──
    private static (int Level, double Score) ComputeLevel(HashSet<int> firedIds,
        Dictionary<int, (string FindingName, int Level, string Roadmap, string Tag, bool IsBad)> checkMap)
    {
        // level → (passed, total)
        var lvlStats = new Dictionary<int, (int passed, int total)>();
        for (int i = 1; i <= 5; i++) lvlStats[i] = (0, 0);

        foreach (var (checkId, info) in checkMap)
        {
            if (info.Level < 1 || info.Level > 5) continue;
            var (p, t) = lvlStats[info.Level];
            t++;
            // Pass when not fired, OR when fired but informational (IsBad=false).
            // Info-tagged fires don't penalise maturity — they're descriptive, not defective.
            if (!firedIds.Contains(checkId) || !info.IsBad) p++;
            lvlStats[info.Level] = (p, t);
        }

        // Same ladder as CalculateMaturity, from the same rule. It was a second copy, and the copies
        // disagreed on the one case that matters after a universe filter: a level with no checks in
        // it. This one read an empty level as 100% and passed it; the main one read it as 0% and
        // stopped there. Same data, two maturity levels, on two surfaces of one report.
        int level = SQLTriage.Data.Services.RoadmapReportRules.CurrentStage(
            SQLTriage.Data.Services.RoadmapReportRules.AchievedLevel(
                Enumerable.Range(1, 5)
                          .Select(i => (lvlStats[i].passed, lvlStats[i].total,
                                        SQLTriage.Data.Services.RoadmapReportRules.DefaultTargetPercent))
                          .ToList()));

        int totalAll  = lvlStats.Values.Sum(x => x.total);
        int passedAll = lvlStats.Values.Sum(x => x.passed);
        double score  = totalAll > 0 ? passedAll * 100.0 / totalAll : 0;
        return (level, score);
    }

    // ── Load check map from roadmap-mapping.json (checkId → findingName, level, roadmap, category tag, isBad) ──
    // IsBad = true  → real fail; a fired check penalises maturity.
    // IsBad = false → informational (e.g. "Non-Default Config: X Changed"); a fired check
    //                 is shown with a neutral icon and does NOT count as a fail.
    /// <summary>
    /// Reads roadmap-mapping.json text. Primary source is the encrypted bundle
    /// (gated config — no longer shipped plaintext on disk since v0.90.2); falls
    /// back to a plaintext Config/ file for dev builds where the bundle isn't
    /// mounted. Returns null when neither source is available so callers can
    /// surface an explicit "data unavailable" state instead of faking a score.
    /// </summary>
    private string? ReadRoadmapMappingJson()
    {
        var fromBundle = Bundle.GetText("Config/roadmap-mapping.json");
        if (!string.IsNullOrEmpty(fromBundle)) return fromBundle;

        var path = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Config", "roadmap-mapping.json");
        return File.Exists(path) ? File.ReadAllText(path) : null;
    }

    private Dictionary<int, (string FindingName, int Level, string Roadmap, string Tag, bool IsBad)> LoadRoadmapMapping()
    {
        var map  = new Dictionary<int, (string, int, string, string, bool)>();
        var json = ReadRoadmapMappingJson();
        if (string.IsNullOrEmpty(json)) { _roadmapDataMissing = true; return map; }
        try
        {
            var doc  = System.Text.Json.JsonDocument.Parse(json);
            if (!doc.RootElement.TryGetProperty("blitzCheckMap", out var arr))
            {
                // Same door, different key: the file loaded but carries no check map. An empty map
                // paints the identical misleading 100% the missing-file guard exists to prevent,
                // so it sets the same flag.
                Logger.LogWarning("roadmap-mapping.json has no blitzCheckMap property; maturity scores suppressed.");
                _roadmapDataMissing = true;
                return map;
            }
            foreach (var entry in arr.EnumerateArray())
            {
                var checkId  = entry.TryGetProperty("checkId",     out var ci) ? ci.GetInt32()         : -1;
                var name     = entry.TryGetProperty("findingName",  out var fn) ? fn.GetString() ?? "" : "";
                var roadmap  = entry.TryGetProperty("Roadmap",     out var rm) ? rm.GetString() ?? ""  : "";
                var category = entry.TryGetProperty("category",    out var cv) ? cv.GetString() ?? ""  : "";
                var level    = entry.TryGetProperty("level",       out var lv) ? lv.GetInt32()         : 0;
                // IsBad: stored as int 0/1 in the json — default to true (fail) if missing,
                // so checks added without the field keep the historical fail-on-fire behaviour.
                var isBad    = !entry.TryGetProperty("IsBad", out var ib) || ib.GetInt32() != 0;

                // Skip informational/hardware items — they don't contribute to maturity score
                if (category.Equals("Server Info",   StringComparison.OrdinalIgnoreCase) ||
                    category.Equals("Information",   StringComparison.OrdinalIgnoreCase) ||
                    category.Equals("Informational", StringComparison.OrdinalIgnoreCase))
                    continue;

                // THE UNIVERSE FILTER. A check no deployed script can emit is not a pass; it was
                // never assessed. Leaving it in the map made it a permanent free PASS in the
                // client PDF, the Action Plan CSV and the on-screen level cards, because all three
                // are projections of this map. ONE rule, shared with the sp_Blitz dashboard:
                // SQLTriage.Data.Services.CheckUniverse, which carries the provenance of every
                // excluded id and the test that derives the set from the vendored script.
                if (!SQLTriage.Data.Services.CheckUniverse.CanFire(checkId)) continue;

                if (level >= 1 && level <= 5)
                    map[checkId] = (name, level, roadmap, category, isBad);
            }
        }
        catch (Exception ex)
        {
            // Third door into the same misleading 100%. A malformed mapping file used to be
            // swallowed here and return a partial or empty map that scored as if every check
            // passed. Fail closed and say so.
            Logger.LogWarning(ex, "roadmap-mapping.json could not be parsed; maturity scores suppressed.");
            _roadmapDataMissing = true;
            return map;
        }

        // A well-formed file that yields nothing usable is the same defect wearing a fourth face.
        if (map.Count == 0)
        {
            Logger.LogWarning("roadmap-mapping.json produced an empty check map; maturity scores suppressed.");
            _roadmapDataMissing = true;
        }
        return map;
    }

    // ── Load supplementary fields from roadmap-mapping.json ──
    //
    // business_translation is WHY A FINDING MATTERS. next_action is WHAT TO DO. They are separate
    // fields and they were not read that way: the PDF bound business_translation to a property
    // called Remediation and printed it, unlabelled, in the fix slot under every failed check. So a
    // client read "Regular backups of databases and transactions are critical for achieving RPO and
    // RTO targets" as the instruction for what to do about databases with no backups.
    //
    // The real per-check text is thin, and this method says how thin rather than papering over it:
    // next_action is present on 18 of 334 entries, and 14 of those still carry an unresolved
    // <Owner> token. RoadmapReportRules.PerCheckAction refuses those, the count is logged, and no
    // per-check action is printed where the mapping has none to give. A blank is honest. Template
    // scaffolding in a client PDF is not, and neither is a category sentence wearing the label of a
    // per-check recommendation.
    private (Dictionary<int, string> BizTrans, Dictionary<int, string> Effort, Dictionary<int, int[]> Related,
             Dictionary<int, string> NextAction)
        LoadRoadmapExtras()
    {
        var biz    = new Dictionary<int, string>();
        var effort = new Dictionary<int, string>();
        var rel    = new Dictionary<int, int[]>();
        var next   = new Dictionary<int, string>();
        var json   = ReadRoadmapMappingJson();
        if (string.IsNullOrEmpty(json)) return (biz, effort, rel, next);
        var withPlaceholder = 0;
        try
        {
            var doc  = System.Text.Json.JsonDocument.Parse(json);
            if (!doc.RootElement.TryGetProperty("blitzCheckMap", out var arr)) return (biz, effort, rel, next);
            foreach (var entry in arr.EnumerateArray())
            {
                var checkId = entry.TryGetProperty("checkId", out var ci) ? ci.GetInt32() : -1;
                if (checkId < 0) continue;
                if (entry.TryGetProperty("business_translation", out var bt) && !string.IsNullOrEmpty(bt.GetString()))
                    biz[checkId] = bt.GetString()!;
                if (entry.TryGetProperty("effort_estimate", out var ee) && !string.IsNullOrEmpty(ee.GetString()))
                    effort[checkId] = ee.GetString()!;
                if (entry.TryGetProperty("next_action", out var na) && !string.IsNullOrWhiteSpace(na.GetString()))
                {
                    var resolved = SQLTriage.Data.Services.RoadmapReportRules.PerCheckAction(na.GetString());
                    if (resolved != null) next[checkId] = resolved;
                    else withPlaceholder++;
                }
                if (entry.TryGetProperty("related_finding_ids", out var rf))
                {
                    var ids = new List<int>();
                    foreach (var r in rf.EnumerateArray())
                        if (r.TryGetInt32(out var rid)) ids.Add(rid);
                    if (ids.Count > 0) rel[checkId] = ids.ToArray();
                }
            }
        }
        catch { }
        if (withPlaceholder > 0)
            Logger.LogWarning(
                "roadmap-mapping.json: {Count} next_action entries still carry an unresolved template placeholder and will print no per-check action. Fill them in the mapping source to ship them.",
                withPlaceholder);
        return (biz, effort, rel, next);
    }

    // ── CSV Action Plan Export — failed checks with priority, grouped by level ──
    private void ExportCsv()
    {
        // Same refusal as the screen and the PDF. An Action Plan CSV is a projection of
        // _maturityLevels, so exporting one from suppressed data would put the number back in front
        // of the client through a third door.
        if (_roadmapDataMissing || _auditDataUnreadable) return;
        if (!_maturityLevels.Any()) return;

        // Capture audit metadata so the CSV header carries the same
        // run-id / timestamps as a PDF generated alongside it.
        CaptureReportMetadata();

        var selectedServers = _availableServers.Where(s => s.IsSelected).ToList();
        var domains         = selectedServers.Select(s => s.Domain).Where(d => !string.IsNullOrEmpty(d)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var fileLabel       = selectedServers.Count == 1
            ? selectedServers[0].SqlInstance.Replace("\\", "_").Replace("/", "_")
            : domains.Count >= 1 ? $"{string.Join("-", domains)}_{selectedServers.Count}servers" : $"{selectedServers.Count}servers";
        if (fileLabel.Length > 60) fileLabel = fileLabel[..60];
        var fileName = $"RoadmapActionPlan_{fileLabel}_{_reportGeneratedUtc:yyyyMMdd_HHmmssZ}.csv";

        var outputDir = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "output");
        Directory.CreateDirectory(outputDir);
        var filePath  = System.IO.Path.Combine(outputDir, fileName);

        var sb = new System.Text.StringBuilder();

        // ── Report header (audit metadata) ──
        sb.AppendLine(CsvQuote($"SQLTriage — Diagnostics Maturity Roadmap — Action Plan"));
        sb.AppendLine(CsvQuote($"Run ID: {_reportRunId}"));
        sb.AppendLine(CsvQuote($"Generated (UTC): {_reportGeneratedUtc:yyyy-MM-ddTHH:mm:ssZ} ({_reportTimezoneId})"));
        sb.AppendLine(CsvQuote($"Tool: SQLTriage v{_reportToolVersion}"));
        sb.AppendLine(CsvQuote($"Operator: {_reportOperator}"));
        sb.AppendLine(CsvQuote($"Control mappings: {_reportControlMappings}"));
        sb.AppendLine(CsvQuote($"Servers: {string.Join("; ", selectedServers.Select(s => s.SqlInstance))}"));
        sb.AppendLine(CsvQuote($"Overall Level: L{_overallLevel} — {GetMaturityName(_overallLevel)}  |  Score: {_overallScore:N0}%  |  {_passedFindings}/{_totalFindings} checks passed  |  {_totalItemsImpacted} items impacted"));
        sb.AppendLine(CsvQuote($"Severity bands: {SQLTriage.Data.Services.RoadmapReportRules.SeverityBandCaption}"));
        sb.AppendLine();

        // ── Summary by level ──
        // Status comes from RoadmapReportRules, the same call the PDF's Executive Summary makes.
        // These two artefacts had separate rules and printed opposite verdicts for the same level of
        // the same run: with pass rates {L1 95, L2 70, L3 88, L4 85, L5 92} the PDF said L5 had met
        // its target and this file said L5 was NOT STARTED, both stamped with one run id. The target
        // ships as its own column so the status can be checked against the numbers beside it.
        sb.AppendLine("SUMMARY BY MATURITY LEVEL");
        sb.AppendLine("Level,Stage,Pass Rate,Passed,Total,Target,Status");
        foreach (var level in _maturityLevels)
        {
            var status = SQLTriage.Data.Services.RoadmapReportRules.LevelStatus(level.PassedChecks, level.TotalChecks);
            sb.AppendLine(string.Join(",", $"L{level.Level}", CsvQuote(level.Name),
                level.PassRate.ToString("N0") + "%", level.PassedChecks.ToString(), level.TotalChecks.ToString(),
                SQLTriage.Data.Services.RoadmapReportRules.DefaultTargetPercent + "%", status));
        }
        sb.AppendLine();

        // ── Action plan — failed checks ordered by priority ──
        // TWO COLUMNS, because there are two different things and one column carried both. The old
        // "Recommended Action" column was a six-way switch on the category tag, so CheckID 1
        // (Databases Not Being Backed Up) and CheckID 68 (DBCC CHECKDB Not Performed Recently) emitted
        // byte-identical text under a header that reads as per-check advice. The category sentence is
        // real and still here under its own name. The per-check column carries the mapping's
        // next_action and is blank where the mapping has none, which is most rows.
        sb.AppendLine("ACTION PLAN — FAILED CHECKS");
        sb.AppendLine("Priority,CheckID,Level,Stage,Category,CheckName,Tag,ServersImpacted,ServerCount,CategoryPassRate%,Check-Specific Action,Category Guidance,Why It Matters");

        int priority = 1, withoutCheckAction = 0;
        // Order: lowest level first (foundation before governed), then lowest pass rate category first
        foreach (var level in _maturityLevels.OrderBy(l => l.Level))
        {
            foreach (var cat in level.Categories.OrderBy(c => c.PassRate))
            {
                foreach (var (checkId, name, tag) in cat.FailedChecks)
                {
                    var serversWithCheck = selectedServers
                        .Where(s => s.CheckCounts.ContainsKey(checkId))
                        .Select(s => s.SqlInstance)
                        .ToList();
                    var checkAction = _nextAction.GetValueOrDefault(checkId) ?? "";
                    if (checkAction.Length == 0) withoutCheckAction++;
                    sb.AppendLine(string.Join(",",
                        priority++,
                        checkId,
                        $"L{level.Level}",
                        CsvQuote(level.Name),
                        CsvQuote(cat.Category),
                        CsvQuote(name),
                        CsvQuote(tag),
                        CsvQuote(string.Join("; ", serversWithCheck)),
                        serversWithCheck.Count,
                        cat.PassRate.ToString("N0") + "%",
                        CsvQuote(checkAction),
                        CsvQuote(GetCategoryGuidance(tag, level.Level)),
                        CsvQuote(_businessTranslation.GetValueOrDefault(checkId) ?? "")));
                }
            }
        }
        if (withoutCheckAction > 0)
            Logger.LogInformation(
                "Action plan CSV: {Count} of {Total} failed checks have no per-check action in roadmap-mapping.json; those cells are blank.",
                withoutCheckAction, priority - 1);

        System.IO.File.WriteAllText(filePath, sb.ToString(), System.Text.Encoding.UTF8);
        Logger.LogInformation("Action plan CSV exported: {File}", filePath);
        _ = Task.Run(() => System.Diagnostics.Process.Start("explorer.exe", $"/select,\"{filePath}\""));
    }

    /// <summary>
    /// Category-level guidance. Six sentences for six categories, so every failed check in a
    /// category gets the same one. That is fine under a column called Category Guidance and it was
    /// not fine under a column called Recommended Action, which is what it shipped under.
    /// </summary>
    private static string GetCategoryGuidance(string tag, int level) => tag switch
    {
        "Reliability"          => "Review backup, CHECKDB, and HA configuration",
        "Performance"          => "Investigate query plans, indexing, and resource waits",
        "Security"             => "Audit logins, permissions, and surface area configuration",
        "Configuration"        => "Review sp_configure and instance-level settings",
        "Monitoring/Alerting"  => "Configure SQL Agent alerts or a monitoring solution",
        "Availability"         => "Review AG/FCI health, listener, and synchronisation",
        _                      => level <= 2 ? "Address as high priority — blocking next maturity level" : "Schedule for next maintenance window"
    };

    private static string CsvQuote(string s)
    {
        if (!s.Contains(',') && !s.Contains('"') && !s.Contains('\n')) return s;
        return "\"" + s.Replace("\"", "\"\"") + "\"";
    }

    // QuestPDF export (server-side; no DOM mutation / browser print). Mirrors the prior selection
    // selection handling so split-by-domain produces one self-contained PDF per domain.
    // Roadmap PDF export. Gated out of community (Adrian's ruling 2026-07-21): the body — and its
    // RoadmapPdfBuilder.Build call — is #if-compiled out, so the builder never reaches the community
    // assembly. The method stays defined so the const-guarded button above still compiles.
    private async Task ExportQuestPdf()
    {
#if SQLT_NO_REPORT_ROADMAP
        await Task.CompletedTask;
        return;
#else
        if (_exporting || !_anySelected || _roadmapDataMissing || _auditDataUnreadable) return;
        _exporting = true;

        var prevExpanded     = new HashSet<int>(_expandedLevels);
        var originalSelected = _availableServers.Where(s => s.IsSelected).Select(s => s.FilePath).ToHashSet();
        StateHasChanged();
        try
        {
            if (_splitByDomain)
            {
                var domainList = _availableServers
                    .Where(s => s.IsSelected && !string.IsNullOrEmpty(s.Domain))
                    .Select(s => s.Domain).Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(d => d, StringComparer.OrdinalIgnoreCase).ToList();

                foreach (var domain in domainList)
                {
                    foreach (var srv in _availableServers)
                        srv.IsSelected = originalSelected.Contains(srv.FilePath) && srv.Domain.Equals(domain, StringComparison.OrdinalIgnoreCase);
                    await RecalculateFromSelected();
                    _expandedLevels = new HashSet<int> { 1, 2, 3, 4, 5 };
                    await BuildAndSaveQuestAsync(new List<string> { domain });
                }

                foreach (var srv in _availableServers)
                    srv.IsSelected = originalSelected.Contains(srv.FilePath);
                await RecalculateFromSelected();
            }
            else
            {
                _expandedLevels = new HashSet<int> { 1, 2, 3, 4, 5 };
                var domains = _availableServers.Where(s => s.IsSelected).Select(s => s.Domain)
                    .Where(d => !string.IsNullOrEmpty(d)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                await BuildAndSaveQuestAsync(domains);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "QuestPDF roadmap export failed");
            Toast.ShowError("PDF export failed", ex.Message);
        }
        finally
        {
            _expandedLevels = prevExpanded;
            _exporting = false;
            StateHasChanged();
        }
    }

    // Projects the current (recalculated) roadmap state into a RoadmapReport and renders it to
    // .\output via QuestPDF. Assumes the caller has set the desired selection + recalculated.
    private async Task BuildAndSaveQuestAsync(List<string> domains)
    {
        CaptureReportMetadata();

        var selectedServers = _availableServers.Where(s => s.IsSelected).ToList();
        if (selectedServers.Count == 0) return;

        var serverNames = selectedServers.Count == 1
            ? selectedServers[0].SqlInstance
            : domains.Count >= 1
                ? $"{string.Join(", ", domains)} ({selectedServers.Count} servers)"
                : $"{selectedServers.Count} servers";
        var runShort = (_reportRunId ?? "").Substring(0, Math.Min(8, _reportRunId?.Length ?? 0));

        var coverInstances = selectedServers.Select(s => s.SqlInstance).Where(n => !string.IsNullOrEmpty(n)).ToList();
        var coverDomains   = selectedServers.Select(s => s.Domain).Where(d => !string.IsNullOrEmpty(d))
                                            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(d => d).ToList();
        var coverSubtitle =
            coverInstances.Count == 0 ? string.Join(" · ", coverDomains) :
            coverInstances.Count <= 4 ? string.Join(" · ", coverInstances) :
            $"{coverInstances.Count} servers across {string.Join(", ", coverDomains)}";

        // Watermark when ANY in-scope server is non-production / unset.
        //
        // WHAT THE r2-03 FIX DOES AND DOES NOT REACH, so nobody reports it as more than it is.
        // RequiresWatermark now fails CLOSED: an empty environment list (the shape a hand-dropped CSV
        // produces, matching no configured connection) asks for the mark instead of dropping it. That
        // predicate is only ever consulted when the operator has switched the draft watermark ON.
        // UserSettingsService.ReportDraftWatermark defaults to FALSE, so on a default install this
        // whole line is false and no roadmap PDF carries a mark either way. The correction is real
        // and its effect is opt-in. Both halves have to be said together.
        var serverInstances    = selectedServers.Select(s => s.SqlInstance).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var serverEnvironments = ConnectionManager.GetConnections()
            .Where(cn => cn.GetServerList().Any(n => serverInstances.Contains(n)))
            .Select(cn => cn.Environment).ToList();
        var watermark = UserSettings.GetReportDraftWatermark()
                        && SQLTriage.Data.Models.ServerEnvironment.RequiresWatermark(serverEnvironments);

        var report = new SQLTriage.Data.Services.RoadmapReport
        {
            ServerLabel       = serverNames,
            GeneratedUtc      = _reportGeneratedUtc.ToString("yyyy-MM-ddTHH:mmZ"),
            TimezoneId        = _reportTimezoneId,
            RunId             = runShort,
            ColorBlind        = UserSettings.GetColorBlindMode(),
            Company           = UserSettings.GetReportCompanyName(),
            CoverSubtitle     = coverSubtitle,
            PreparedForDate   = _reportGeneratedUtc.ToString("dd MMMM yyyy"),
            OverallLevel      = _overallLevel,
            OverallLevelName  = GetMaturityName(_overallLevel),
            OverallScore      = _overallScore,
            RiskWeightedScore = _riskWeightedScore,
            ItemsImpacted     = _totalItemsImpacted,
            FindingsEvaluated = _totalFindings,
            FindingsPassed    = _passedFindings,
            ServersSelected   = selectedServers.Count,
            Headline          = _headlineFinding,
            Critical          = _criticalCount,
            High              = _highCount,
            Medium            = _mediumCount,
            TopActions        = _topThreeActions.ToList(),
            RunIdFull         = _reportRunId ?? "",
            GeneratedUtcIso   = _reportGeneratedUtc.ToString("yyyy-MM-ddTHH:mm:ssZ"),
            ToolVersion       = _reportToolVersion ?? "",
            Operator          = _reportOperator ?? "",
            ControlMappings   = _reportControlMappings ?? "",
            ServersInScope    = selectedServers.Select(s => s.SqlInstance).ToList(),
            Watermark         = watermark,
        };

        foreach (var lvl in _maturityLevels)
        {
            var rl = new SQLTriage.Data.Services.RoadmapLevel
            {
                Number = lvl.Level, Name = lvl.Name, Description = lvl.Description,
                PassedCount = lvl.PassedChecks, TotalCount = lvl.TotalChecks, PassRate = lvl.PassRate,
                // Explicit, so the PDF's status and the CSV's status are computed against the same
                // target rather than against a DTO default that could drift from the page's rule.
                Target = SQLTriage.Data.Services.RoadmapReportRules.DefaultTargetPercent,
            };
            foreach (var cat in lvl.Categories)
            {
                var rc = new SQLTriage.Data.Services.RoadmapCategory
                {
                    Name = cat.Category, PassedCount = cat.Passed, TotalCount = cat.Total,
                };
                foreach (var f in cat.FailedChecks)
                    rc.Failed.Add(new SQLTriage.Data.Services.RoadmapFinding
                    {
                        Name = f.Name, Tag = f.Tag,
                        // Two fields, two slots, labelled. business_translation is why it matters and
                        // was printed unlabelled where the reader looks for the fix; next_action is the
                        // fix and was not printed at all.
                        Impact      = _businessTranslation.GetValueOrDefault(f.CheckId),
                        Action      = _nextAction.GetValueOrDefault(f.CheckId),
                        Effort      = _effortEstimate.GetValueOrDefault(f.CheckId),
                        Related     = _relatedFindings.GetValueOrDefault(f.CheckId),
                    });
                foreach (var f in cat.InfoChecks)
                    rc.Info.Add(new SQLTriage.Data.Services.RoadmapFinding { Name = f.Name, Tag = f.Tag });
                foreach (var f in cat.PassedChecks)
                    rc.PassedItems.Add(new SQLTriage.Data.Services.RoadmapFinding { Name = f.Name, Tag = f.Tag });
                rl.Categories.Add(rc);
            }
            report.Levels.Add(rl);
        }

        var bytes = await Task.Run(() => SQLTriage.Data.Services.RoadmapPdfBuilder.Build(report));

        var fileLabel = serverNames.Replace("\\", "_").Replace("/", "_").Replace(", ", "-").Replace(" ", "");
        if (fileLabel.Length > 50) fileLabel = fileLabel[..50];
        var dir  = System.IO.Path.Combine(AppContext.BaseDirectory, "output");
        System.IO.Directory.CreateDirectory(dir);
        var path = System.IO.Path.Combine(dir, $"RoadmapReport_{fileLabel}_{_reportGeneratedUtc:yyyyMMdd_HHmmssZ}_{runShort}.pdf");
        await System.IO.File.WriteAllBytesAsync(path, bytes);
        Logger.LogInformation("Roadmap PDF exported (QuestPDF): {Path}", path);

        // Integrity manifest. The attestation page tells the recipient a sibling .manifest.json
        // carries this PDF's SHA-256 so they can verify the bytes they hold.
        //
        // reports-r2-07 (2026-08-27): the write is best-effort by construction — the PDF is on disk
        // before the hash is computed, so the manifest cannot be written first. What was wrong is
        // what happened next: the catch logged a warning nobody reads and the toast said "PDF
        // exported" either way, so an operator handed a client a PDF whose own attestation promised
        // a verification file that was never written. The failure is now told to the operator, in
        // the same place the success is, and the attestation no longer asserts the file exists.
        var manifestWritten = false;
        string? manifestError = null;
        try
        {
            _reportBytesSha256 = ComputeFileSha256(path);
            var manifest = new
            {
                runId            = _reportRunId,
                generatedUtc     = _reportGeneratedUtc.ToString("o"),
                timezone         = _reportTimezoneId,
                toolVersion      = _reportToolVersion,
                @operator        = _reportOperator,
                controlMappings  = _reportControlMappings,
                artefact         = System.IO.Path.GetFileName(path),
                sha256           = _reportBytesSha256,
                watermarkApplied = watermark,
                environments     = serverEnvironments.Select(e => string.IsNullOrEmpty(e) ? "(none)" : e).Distinct().OrderBy(e => e).ToList(),
                servers          = selectedServers.Select(s => new { s.SqlInstance, s.Domain, s.AuditDate }),
            };
            var manifestJson = System.Text.Json.JsonSerializer.Serialize(manifest, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            await System.IO.File.WriteAllTextAsync(System.IO.Path.ChangeExtension(path, ".manifest.json"), manifestJson);
            manifestWritten = true;
        }
        catch (Exception ex)
        {
            manifestError = ex.Message;
            Logger.LogWarning(ex, "Failed to write report manifest (non-fatal)");
        }

        if (manifestWritten)
        {
            Toast.ShowSuccess("PDF exported", System.IO.Path.GetFileName(path));
        }
        else
        {
            // The PDF is real and on disk, so this is not an error toast. The integrity file the
            // PDF's own attestation refers to is not, and the operator is the only person who can
            // still act on that before the report leaves the building.
            Toast.ShowWarning("PDF exported without its integrity manifest",
                $"{System.IO.Path.GetFileName(path)} was written. Its .manifest.json was not, so a "
                + "recipient cannot verify this PDF's SHA-256. "
                + (manifestError ?? "No reason was reported."));
        }
#endif
    }

