    // When true, the next run reloads the check catalog from the v2 corpus bundle
    // first — picks up a corpus regeneration without an app restart (the
    // catalog is otherwise read once at startup by CheckRepositoryService).
    private bool _forceFresh;

    // Cancellation source for the in-flight run. Cancelled by the Stop button;
    // the executor checks the token between checks and aborts SQL reads cleanly.
    private CancellationTokenSource? _runCts;

    private void StopRun() => _runCts?.Cancel();

    // ── Corpus DEMO allocation (signed in the bundle; metered by DemoRunLedger) ──
    // Snapshot shown on the page so the operator sees their community allowance.
    private SQLTriage.Data.Services.Licensing.DemoRunDecision? _demoStatus;
    private bool _demoUnlimited = true;          // true on a full bundle / DevBridge → no banner
    private bool _demoMultiAllowed = true;       // false when N==1 → "Run all servers" is gated

    private void RefreshDemoStatus()
    {
        _demoStatus       = DemoLedger.Status();
        _demoUnlimited    = _demoStatus.Unlimited;
        _demoMultiAllowed = _demoStatus.Unlimited || _demoStatus.Allowance > 1;
    }

    // Pre-computed banner copy (no inline formatting in markup — RZ1006 discipline).
    // The ENTITLEMENT sentence and the EXHAUSTED sentence both come from the ledger, which words
    // them from the allocation's provenance. This property used to build its own copy and opened
    // every variant with "Community version:", which is false for a paid Full licence minted at a
    // small allocation — the exact claim that cost a client. Add copy to the seam, not here.
    private string DemoBannerText
    {
        get
        {
            var s = _demoStatus;
            if (s is null || s.Unlimited) return string.Empty;

            var remaining = Math.Max(0, s.Allowance - s.InstancesUsed);
            if (remaining > 0)
                return $"{DemoLedger.DescribeAllowance()} — {remaining} remaining in this window. " +
                       "Raw Diagnostics and Vulnerability Assessment are unlimited.";

            // Allowance spent: the ledger's own refusal copy already carries the provenance-correct
            // lead and the next-unlock time, so render it rather than paraphrasing it.
            return s.BlockReason ?? DemoLedger.DescribeAllowance();
        }
    }

    // ISO-8601 (UTC) instant the next demo slot frees — the seed for the client-side countdown.
    // Non-null ONLY when the allowance is spent (remaining <= 0) and the ledger reported an unlock
    // time. UnlocksUtc is UTC (ledger arithmetic off DateTime.UtcNow), so "o" emits a Z-suffixed
    // string JavaScript's Date.parse handles directly.
    private string? DemoUnlockUtcIso =>
        _demoStatus is { Unlimited: false } s
        && (s.Allowance - s.InstancesUsed) <= 0
        && s.UnlocksUtc is { } u
            ? u.ToString("o", System.Globalization.CultureInfo.InvariantCulture)
            : null;

    // Registers ONE global 1-second ticker that updates every .demo-countdown[data-unlock-utc]
    // element's .demo-countdown-value text in place. Purely client-side: no Blazor re-render, no
    // SignalR/WebView round-trip, so a blocked banner counts down live without any server chatter.
    // Idempotent (guards window.__sqltDemoCountdown), so re-registering on a later render is a no-op.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("eval", DemoCountdownTickerJs);
    }

    private const string DemoCountdownTickerJs = @"
(function(){
  if (window.__sqltDemoCountdown) return;
  var p = function(n){ return (n<10?'0':'')+n; };
  var fmt = function(ms){
    if (ms <= 0) return 'now — refresh to run';
    var s = Math.floor(ms/1000), h = Math.floor(s/3600), m = Math.floor((s%3600)/60), x = s%60;
    return (h>0 ? h+'h ' : '') + (h>0 ? p(m) : m) + 'm ' + p(x) + 's';
  };
  window.__sqltDemoCountdown = setInterval(function(){
    var els = document.querySelectorAll('.demo-countdown[data-unlock-utc]');
    for (var i=0;i<els.length;i++){
      var el = els[i], t = Date.parse(el.getAttribute('data-unlock-utc'));
      var out = el.querySelector('.demo-countdown-value');
      if (out && !isNaN(t)) out.textContent = fmt(t - Date.now());
    }
  }, 1000);
})();";

    // Decide whether the requested corpus run is admissible against the demo allowance.
    // Returns false + a human reason when blocked. Diagnostics/VA never call this.
    //
    // Delegates WHOLLY to IDemoRunLedger.TryAdmitRun — the one admission rule shared with the CLI
    // (`--audit`) lane. This method previously re-derived the over-allocation check and paraphrased
    // the refusal, so the two lanes could give a client two different accounts of one licence.
    private bool TryAdmitDemoRun(IReadOnlyList<string> instances, out string blockReason)
    {
        var admission = DemoLedger.TryAdmitRun(instances);
        blockReason = admission.Allowed ? string.Empty : (admission.BlockReason ?? string.Empty);
        return admission.Allowed;
    }

    private async Task RunChecks()
    {
        if (!UserState.IsAuthorized("execute_checks"))
        {
            Toast.ShowWarning("Insufficient permissions. Operator role required to run checks.");
            return;
        }
        if (_forceFresh)
        {
            await CheckRepo.LoadChecksAsync();
            InvalidateCategoryChips();   // the reloaded catalog may carry different categories
            State.AddDiagEntry($"=== Catalog reloaded: {CheckRepo.Checks.Count} checks ===", "info");
        }
        CheckExecutor.ClearAllResults();
        _runCts?.Dispose();
        _runCts = new CancellationTokenSource();
        var ct = _runCts.Token;
        State.IsRunning       = true;
        State.Progress        = 0;
        State.ProgressMessage = "Starting...";
        State.Results.Clear();
        State.ServerSummaries.Clear();
        // The old run's coverage sentence goes out with the old run's rows; the new one is written
        // below, once the new run's exclusion has actually been measured.
        State.CategoryExclusionNotice = null;
        State.RunCompletenessNotice = null;
        State.ClearDiagLog();
        State.ExecutionTime   = DateTime.Now;
        State.ServersTested   = 0;
        State.NotifyStateChanged();

        var overallStart = DateTime.UtcNow;
        State.AddDiagEntry("=== Audit Assessment started ===", "info");

        try
        {
            var targets = new List<(ServerConnection Connection, string Server)>();

            if (View.RunAllServers)
            {
                foreach (var conn in EnabledConnections)
                    foreach (var server in conn.GetServerList())
                        targets.Add((conn, server));
            }
            else
            {
                var connection = ConnectionManager.GetConnection(View.SelectedConnectionId);
                if (connection == null)
                {
                    State.StatusMessage = "Connection not found.";
                    State.StatusClass   = "error";
                    State.AddDiagEntry("ERROR: Connection not found", "error");
                    return;
                }
                foreach (var server in connection.GetServerList())
                    targets.Add((connection, server));
            }

            if (targets.Count == 0)
            {
                State.StatusMessage = "No servers to check.";
                State.StatusClass   = "error";
                State.AddDiagEntry("ERROR: No servers to check", "error");
                return;
            }

            // ── Corpus DEMO gate ──────────────────────────────────────────────
            // The community bundle meters corpus runs to N distinct instances / 24h (signed in
            // the bundle; tier-agnostic; full bundle ships N=0 = unlimited → no-op). Diagnostics
            // and VA are NOT gated — only this corpus run. Block BEFORE any target executes.
            var demoInstances = targets.Select(t => t.Server)
                                       .Distinct(StringComparer.OrdinalIgnoreCase)
                                       .ToList();
            if (!TryAdmitDemoRun(demoInstances, out var demoBlock))
            {
                State.StatusMessage = demoBlock;
                State.StatusClass   = "warning";
                State.AddDiagEntry($"DEMO LIMIT: {demoBlock}", "warning");
                Toast.ShowWarning(demoBlock);
                return;
            }

            State.AddDiagEntry($"Targets: {targets.Count} server(s)", "info");

            // ── Per-run category exclusion ───────────────────────────────────
            // Snapshot the chip state ONCE, here, against the catalog as it stands now, and let
            // the one predicate feed both the diagnostic counts below and the executor call in
            // RunOneTarget — a second, separately-derived rule is how a log and a run come to
            // disagree. The disclosure sentence is built from the SAME measurement, so no surface
            // can describe this run's coverage differently from another.
            //
            // Interactive page only, on purpose: ScheduledTaskEngine and the CLI audit host call
            // the UNFILTERED CheckExecutionService.ExecuteChecksAsync overload, so a chip on this
            // dashboard cannot narrow an unattended run.
            var selection = CategoryRunFilter.Apply(CheckRepo.GetEnabledChecks(), _excludedCategories);
            Func<SqlCheck, bool> filter = selection.Predicate;

            // Adrian's ruling, 2026-08-05: a category-filtered run stays on screen and exportable
            // with its disclosure, and does NOT write the server's persisted latest-run record —
            // that record keeps meaning "full assessment", and Checks, RemediationTuner,
            // ComplianceMap/Tree and /audit's cold start all read it with no notion of coverage.
            // Carried to the executor as an explicit option off THIS page's selection: the decision
            // is the category exclusion's, and nothing downstream may infer it from the predicate,
            // which QuickCheckRunner also uses for runs that must keep persisting.
            var persistThisRun = !selection.ExcludesAnyCategory;
            if (!persistThisRun)
                State.AddDiagEntry(
                    "This run is category-filtered, so it will not be saved as this server's latest run. "
                    + "The previous full assessment stays on record.", "warning");

            var checksToRun = selection.ChecksToRun;
            // The coverage sentence is NOT written here. Before anything executes, the only honest
            // thing to say is what the run INTENDS to skip — which is what the diagnostics get, in
            // future tense. The notice that sits beside the results is written after the run, from
            // the rows the run produced (MeasuredDisclosure, below): a run that is cancelled or
            // loses a server skips more than the filter did, and the plan's arithmetic would state
            // a smaller loss than the grid under it demonstrates.
            if (selection.PlannedSummary != null)
                State.AddDiagEntry(selection.PlannedSummary, "warning");
            State.AddDiagEntry($"Checks to execute per server: {checksToRun.Count}", "info");
            State.AddDiagEntry(
                $"Concurrent queries per instance: {_auditConcurrencyOverride?.ToString() ?? $"{_auditConcurrencyDefault} (Settings default)"}",
                "info");

            foreach (var g in checksToRun.GroupBy(c => c.Category).OrderBy(g => g.Key))
                State.AddDiagEntry($"  Category '{g.Key}': {g.Count()} checks", "info");
            foreach (var g in checksToRun.GroupBy(c => c.Severity).OrderBy(g => g.Key))
                State.AddDiagEntry($"  Severity '{g.Key}': {g.Count()} checks", "info");
            foreach (var g in checksToRun.GroupBy(c => c.ExecutionType ?? "scalar").OrderBy(g => g.Key))
                State.AddDiagEntry($"  ExecutionType '{g.Key}': {g.Count()} checks", "info");

            var allResults    = new List<CheckResult>();
            int totalTargets  = targets.Count;
            int completedTargets = 0;
            var resultsLock = new object();

            // Per-target work. Shared-state mutations (summaries, results, progress) are
            // guarded by resultsLock so the parallel path is safe; CheckExecutor throttles
            // per-instance queries to _auditConcurrencyOverride (or the saved Settings default
            // when it is null) and rents from the shared pool.
            async Task RunOneTarget(ServerConnection conn, string server)
            {
                lock (resultsLock)
                {
                    State.ProgressMessage = $"Checking {server}...";
                    State.AddDiagEntry($"--- Connecting to {server} ---", "info");
                }
                State.NotifyStateChanged();

                try
                {
                    var summary = await CheckExecutor.ExecuteChecksAsync(conn, server, filter, ct, _auditConcurrencyOverride, persistRun: persistThisRun);
                    // THIS run's rows, not the best current picture of the instance. GetResults tops
                    // its capped hot cache up from the persisted latest-run store and then from
                    // SQLite, so it can hand a narrow run rows no part of that run executed. The
                    // reproduction is staged in LastRunResultsIsolationTests: with a 58-row previous
                    // run on disk, GetResults answers 58 rows for an instance whose current run
                    // covered 13 Encryption checks — 45 of them from the categories the notice
                    // directly below the grid says did not run.
                    // GetLastRunResults returns what this call executed and nothing else.
                    var serverResults = CheckExecutor.GetLastRunResults(server);
                    // F6: only mention accepted when present, so the common zero case stays terse.
                    var acceptedNote = summary.Accepted > 0 ? $", {summary.Accepted} accepted" : "";
                    lock (resultsLock)
                    {
                        State.ServerSummaries.Add(summary);
                        State.AddDiagEntry($"--- {server} complete: {summary.Passed} pass, {summary.Failed} fail{acceptedNote}, {summary.Errors} err ({summary.Duration.TotalSeconds:F1}s) ---", "info");
                        allResults.AddRange(serverResults);
                    }
                    Toast.ShowInfo($"Audit Assessment: {server} — {summary.Passed} pass, {summary.Failed} fail{acceptedNote} ({summary.Duration.TotalSeconds:F1}s)");
                }
                catch (OperationCanceledException)
                {
                    lock (resultsLock)
                        State.AddDiagEntry($"--- {server} cancelled ---", "warning");
                }
                catch (Exception ex)
                {
                    lock (resultsLock)
                    {
                        State.AddDiagEntry($"ERROR on {server}: {ex.Message}", "error");
                        State.ServerSummaries.Add(new CheckExecutionSummary
                        {
                            InstanceName  = server,
                            StartedAt     = DateTime.UtcNow,
                            CompletedAt   = DateTime.UtcNow,
                            // The checks this run was going to execute, not the whole catalog: on a
                            // category-filtered run the catalog count would report errors for checks
                            // the run never intended to attempt.
                            Errors        = checksToRun.Count
                        });
                    }
                }

                lock (resultsLock)
                {
                    completedTargets++;
                    State.Progress      = (int)((double)completedTargets / totalTargets * 100);
                    State.ServersTested = completedTargets;
                }
                State.NotifyStateChanged();
            }

            if (_parallelMode && targets.Count > 1)
            {
                // Start each server concurrently, staggered by the configured delay.
                var tasks = new List<Task>();
                for (int i = 0; i < targets.Count; i++)
                {
                    var (conn, server) = targets[i];
                    var startDelay = TimeSpan.FromSeconds(_parallelDelaySeconds * i);
                    tasks.Add(Task.Run(async () =>
                    {
                        if (startDelay > TimeSpan.Zero) await Task.Delay(startDelay, ct);
                        if (ct.IsCancellationRequested) return;
                        await RunOneTarget(conn, server);
                    }, ct));
                }
                // Stagger tasks cancelled mid-delay surface OCE here; per-target
                // failures are already caught inside RunOneTarget, so swallow only
                // the cancellation and keep whatever partial results completed.
                try { await Task.WhenAll(tasks); }
                catch (OperationCanceledException) { }
            }
            else
            {
                foreach (var (conn, server) in targets)
                {
                    if (ct.IsCancellationRequested) break;
                    await RunOneTarget(conn, server);
                }
            }

            State.Results = allResults;
            State.HasRun  = true;

            // ── The coverage sentence, written now, from what this run produced ──────────
            // "Completed" is measured, not assumed: not cancelled, AND every planned target
            // actually reported rows. A target that threw (unreachable server) leaves a summary
            // with no results, and that is a coverage shortfall the category filter did not cause
            // and must not be allowed to describe. MeasuredDisclosure returns the plain sentence
            // when the run did what it planned, and an honest one when it did not.
            //
            // The empty plan is the exception, and it is a real state: unticking every category
            // leaves nothing to execute, so no target is asked to report and zero rows is the
            // CORRECT outcome. Judging that run by "did every target report rows" printed "though
            // the run did not complete" beside its own "No checks were executed" status. Completion
            // is therefore gated on the PLAN SIZE, and the planned target count handed to the
            // disclosure is zero for an empty plan — no target went silent, none was asked.
            var targetsWithRows = allResults.Select(r => r.InstanceName)
                                            .Where(n => !string.IsNullOrWhiteSpace(n))
                                            .Distinct(StringComparer.OrdinalIgnoreCase)
                                            .Count();
            var planIsEmpty  = checksToRun.Count == 0;
            var runCompleted = !ct.IsCancellationRequested && (planIsEmpty || targetsWithRows == totalTargets);
            // The planned targets, not the ones that answered: a target that reported nothing forms
            // no group in allResults, so without this count it drops out of the floor entirely and
            // the healthy server's coverage speaks for a server that ran zero checks.
            var plannedTargets = planIsEmpty ? 0 : totalTargets;
            State.CategoryExclusionNotice = selection.MeasuredDisclosure(allResults, runCompleted, plannedTargets);
            if (State.CategoryExclusionNotice != null)
                State.AddDiagEntry(State.CategoryExclusionNotice, "warning");
            // Completeness, from the SAME two counts, and stated whether or not a category filter was
            // applied. MeasuredDisclosure is null whenever nothing was excluded, so before this an
            // UNFILTERED run that was cancelled (or that lost a server) produced a PDF header of
            // counts indistinguishable from a complete assessment's.
            State.RunCompletenessNotice = QuickCheckStateService.DescribeRunCompleteness(
                ct.IsCancellationRequested, plannedTargets, targetsWithRows);
            if (State.RunCompletenessNotice != null)
                State.AddDiagEntry(State.RunCompletenessNotice, "warning");

            // Claim the demo slot only for instances that ACTUALLY produced results — a
            // cancelled/failed instance that never ran must not burn the operator's allowance.
            // RecordRun is idempotent for an already-claimed instance and a no-op when unlimited.
            foreach (var inst in allResults.Select(r => r.InstanceName)
                                           .Where(n => !string.IsNullOrWhiteSpace(n))
                                           .Distinct(StringComparer.OrdinalIgnoreCase))
            {
                DemoLedger.RecordRun(inst!);
            }
            RefreshDemoStatus();

            // #88 follow-up: an interactive re-scan must fire the same StillFailing sweep the
            // scheduled path does (App.xaml.cs AssessmentRunCompleted) and the ledger-load re-eval
            // (ChangeLedger.razor). Keyed on the result's InstanceName stamp — the same value stored
            // change-items carry as ServerName — so a manual audit flags overdue handed-off items
            // whose check still fails. Isolated & best-effort: never blocks or faults the run.
            foreach (var inst in allResults.Select(r => r.InstanceName)
                                           .Where(n => !string.IsNullOrWhiteSpace(n))
                                           .Distinct(StringComparer.OrdinalIgnoreCase))
            {
                try
                {
                    var instResults = CheckExecutor.GetResults(inst!, int.MaxValue);
                    if (instResults.Count > 0)
                        await ChangeItems.EvaluateFollowUpsAsync(inst!, instResults);
                }
                catch (Exception ex)
                {
                    State.AddDiagEntry($"Follow-up sweep skipped for {inst}: {ex.Message}", "warning");
                }
            }

            var totalDuration     = DateTime.UtcNow - overallStart;
            State.ExecutionDuration = $"{totalDuration.TotalSeconds:F1}s";
            State.Categories = State.Results.Select(r => r.Category).Distinct().OrderBy(c => c).ToList();

            if (ct.IsCancellationRequested)
            {
                State.StatusMessage = $"Audit Assessment cancelled — {State.Results.Count} partial result(s) from {State.ServersTested} server(s).";
                State.StatusClass   = "warning";
                State.AddDiagEntry("=== Cancelled by user ===", "warning");
            }
            else if (State.Results.Count > 0)
            {
                // 2026-07-21 (persona board, FIX 2): this line reported 317 passed / 46 failed /
                // 2 errors for a 575-check run and simply omitted the 45 Partial — 45 results of
                // the run the user had just executed, absent from its own completion summary.
                // Partial is stated whenever it occurred; when it did not, the sentence is
                // byte-identical to what it always was (no clause claiming "0 partial").
                var partialClause = WarnCount > 0 ? $", {WarnCount} partial" : "";
                State.StatusMessage = $"Audit Assessment completed: {PassedCount} passed, {FailedCount} failed{partialClause}, {ErrorCount} errors across {State.ServersTested} server(s)";
                State.StatusClass   = FailedCount > 0 || ErrorCount > 0 ? "warning" : "success";
            }
            else
            {
                State.StatusMessage = "No checks were executed. Make sure checks are enabled in the check corpus";
                State.StatusClass   = "warning";
            }

            State.AddDiagEntry($"=== Complete: {State.Results.Count} total results in {State.ExecutionDuration} ===", "info");

            var overallDuration = DateTime.UtcNow - overallStart;
            var anyFailures = FailedCount > 0 || ErrorCount > 0;
            AuditLog.LogScriptExecution("QuickCheck", string.Join(",", targets.Select(t => t.Server)),
                !anyFailures, overallDuration,
                anyFailures ? $"{FailedCount} failed, {ErrorCount} errors" : null);

            await AutoExportQuickCheckResults();
        }
        catch (Exception ex)
        {
            State.StatusMessage = $"Error running checks: {ex.Message}";
            State.StatusClass   = "error";
            State.AddDiagEntry($"FATAL ERROR: {ex.Message}", "error");
            System.Diagnostics.Debug.WriteLine($"[QuickCheck] Error: {ex}");
        }
        finally
        {
            State.IsRunning       = false;
            State.Progress        = 100;
            State.ProgressMessage = "Complete";
            _runCts?.Dispose();
            _runCts = null;
            State.NotifyStateChanged();
        }
    }

    private string GetRowClass(CheckResult result)
    {
        if (!string.IsNullOrEmpty(result.ErrorMessage)) return "row-error";
        // Ruling #4 (2026-07-20): WARN rides Passed=true, so without this arm a "could not fully
        // assess" row would carry the green row-passed tint behind its Partial badge.
        if (IsWarnVerdict(result)) return "row-warn";
        return result.Passed ? "row-passed" : "row-failed";
    }

    private string GetSeverityClass(string severity) =>
        severity?.ToLower() switch
        {
            "critical" => "severity-critical",
            "warning"  => "severity-warning",
            "info"     => "severity-info",
            _          => "severity-default"
        };
}

