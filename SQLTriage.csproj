    <!-- sql-checks.json was retired in commit 100965c and fully removed 2026-05-26 (D5). -->

    <!-- ── config.default\ : OPERATOR-EDITABLE, seeded first-run-only ───────────────────────── -->
    <!-- DiagnosticScriptRunner.cs:129 writes this file back after an operator changes a script's
         configuration. ScriptConfigurationMigrator adds newly-shipped entries at load without
         touching anything already there, so a first-run-only seed does not starve it of new checks. -->
    <Content Update="Config\script-configurations.json">
