{
  "version": "1.0",
  "alerts": [
    {
      "id": "io_error",
      "name": "SQL I/O Error",
      "description": "SQL Server has encountered an I/O error on a database file",
      "category": "logging",
      "enabled": true,
      "severity": "Critical",
      "thresholds": {
        "warning": 1
      },
      "unit": "event",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 300,
      "query": "SELECT SUM(num_of_bytes_read + num_of_bytes_written) AS value FROM sys.dm_io_virtual_file_stats(NULL, NULL) WHERE io_stall_queued_read_ms > 0 OR io_stall_queued_write_ms > 0",
      "queryMode": "io_error_check",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": false,
      "requiresOnPrem": false
    },
    {
      "id": "disk_space_low",
      "name": "Disk Space Low",
      "description": "A disk volume used by SQL Server has low free space",
      "category": "storage",
      "enabled": true,
      "severity": "Warning",
      "thresholds": {
        "warning": 5120,
        "critical": 2048
      },
      "unit": "megabytes",
      "operator": "less_than",
      "durationSeconds": 0,
      "frequencySeconds": 300,
      "query": "SELECT MIN(available_bytes / 1048576) AS value FROM sys.dm_os_volume_stats(DB_ID(), 1)",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": true
    },
    {
      "id": "database_space_full",
      "name": "Database Space Full",
      "description": "A database data file is running out of space",
      "category": "storage",
      "enabled": true,
      "severity": "Critical",
      "thresholds": {
        "warning": 85,
        "critical": 90
      },
      "unit": "percent",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 300,
      "query": "SELECT TOP 1 CAST(FILEPROPERTY(name, 'SpaceUsed') AS FLOAT) * 100.0 / NULLIF(size, 0) AS value FROM sys.database_files WHERE type = 0 ORDER BY CAST(FILEPROPERTY(name, 'SpaceUsed') AS FLOAT) / NULLIF(size, 0) DESC",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": false
    },
    {
      "id": "log_space_full",
      "name": "Transaction Log Full",
      "description": "A transaction log file is running out of space",
      "category": "storage",
      "enabled": true,
      "severity": "Critical",
      "thresholds": {
        "warning": 80,
        "critical": 90
      },
      "unit": "percent",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 300,
      "query": "SELECT TOP 1 CAST(FILEPROPERTY(name, 'SpaceUsed') AS FLOAT) * 100.0 / NULLIF(size, 0) AS value FROM sys.database_files WHERE type = 1 ORDER BY CAST(FILEPROPERTY(name, 'SpaceUsed') AS FLOAT) / NULLIF(size, 0) DESC",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": false
    },
    {
      "id": "filegroup_space",
      "name": "Filegroup Space Full",
      "description": "A filegroup is running out of allocated space",
      "category": "storage",
      "enabled": true,
      "severity": "Warning",
      "thresholds": {
        "warning": 85,
        "critical": 90
      },
      "unit": "percent",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 300,
      "query": "SELECT TOP 1 SUM(CAST(FILEPROPERTY(f.name, 'SpaceUsed') AS FLOAT)) * 100.0 / NULLIF(SUM(CAST(f.size AS FLOAT)), 0) AS value FROM sys.database_files f WHERE f.type = 0 GROUP BY f.data_space_id ORDER BY SUM(CAST(FILEPROPERTY(f.name, 'SpaceUsed') AS FLOAT)) * 100.0 / NULLIF(SUM(CAST(f.size AS FLOAT)), 0) DESC",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": false
    },
    {
      "id": "vlf_count",
      "name": "Virtual Log File Count",
      "description": "Excessive VLFs in a transaction log degrade recovery and log operations",
      "category": "storage",
      "enabled": true,
      "severity": "Warning",
      "thresholds": {
        "warning": 500,
        "critical": 1000
      },
      "unit": "count",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 3600,
      "cooldownMinutes": 60,
      "query": "SELECT COUNT(*) AS value FROM sys.dm_db_log_info(DB_ID())",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": false,
      "requiresOnPrem": false
    },
    {
      "id": "io_stall_time",
      "name": "I/O Stall Time",
      "description": "Average I/O stall time is high, indicating disk performance issues",
      "category": "performance",
      "enabled": true,
      "severity": "Warning",
      "thresholds": {
        "warning": 50,
        "critical": 100
      },
      "unit": "milliseconds",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 60,
      "query": "SELECT MAX(CASE WHEN num_of_reads + num_of_writes > 0 THEN (io_stall) / (num_of_reads + num_of_writes) ELSE 0 END) AS value FROM sys.dm_io_virtual_file_stats(NULL, NULL)",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": false
    },
    {
      "id": "disk_latency_read",
      "name": "Disk Read Latency",
      "description": "Average disk read latency is high",
      "category": "storage",
      "enabled": true,
      "severity": "Warning",
      "thresholds": {
        "warning": 30,
        "critical": 50
      },
      "unit": "milliseconds",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 60,
      "query": "SELECT MAX(CASE WHEN num_of_reads > 0 THEN io_stall_read_ms / num_of_reads ELSE 0 END) AS value FROM sys.dm_io_virtual_file_stats(NULL, NULL)",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": false
    },
    {
      "id": "disk_latency_write",
      "name": "Disk Write Latency",
      "description": "Average disk write latency is high",
      "category": "storage",
      "enabled": true,
      "severity": "Warning",
      "thresholds": {
        "warning": 30,
        "critical": 50
      },
      "unit": "milliseconds",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 60,
      "query": "SELECT MAX(CASE WHEN num_of_writes > 0 THEN io_stall_write_ms / num_of_writes ELSE 0 END) AS value FROM sys.dm_io_virtual_file_stats(NULL, NULL)",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": false
    },
    {
      "id": "tempdb_contention",
      "name": "TempDB Contention",
      "description": "TempDB allocation page latch contention detected",
      "category": "tempdb",
      "enabled": true,
      "severity": "Warning",
      "thresholds": {
        "warning": 50,
        "critical": 100
      },
      "unit": "milliseconds",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 60,
      "query": "SELECT SUM(wait_time_ms) / NULLIF(SUM(waiting_tasks_count), 0) AS value FROM sys.dm_os_wait_stats WHERE wait_type LIKE 'PAGELATCH%' AND wait_type NOT LIKE '%IO%'",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": true
    },
    {
      "id": "processor_under_utilization",
      "name": "Processor Under-Utilization",
      "description": "Total processor utilization is abnormally low, may indicate service issues",
      "category": "performance",
      "enabled": true,
      "severity": "Warning",
      "thresholds": {
        "warning": 10
      },
      "unit": "percent",
      "operator": "less_than",
      "durationSeconds": 300,
      "frequencySeconds": 60,
      "query": "SELECT record.value('(./Record/SchedulerMonitorEvent/SystemHealth/ProcessUtilization)[1]', 'int') AS value FROM (SELECT TOP 1 CONVERT(XML, record) AS record FROM sys.dm_os_ring_buffers WHERE ring_buffer_type = N'RING_BUFFER_SCHEDULER_MONITOR' ORDER BY timestamp DESC) AS x",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": true
    },
    {
      "id": "agent_job_long_running",
      "name": "SQL Agent Job Long Running",
      "description": "A SQL Agent job has been running significantly longer than its average duration",
      "category": "availability",
      "enabled": true,
      "severity": "Warning",
      "thresholds": {
        "warning": 200,
        "critical": 500
      },
      "unit": "percent_of_average",
      "operator": "greater_than",
      "durationSeconds": 0,
      "frequencySeconds": 300,
      "query": "SELECT MAX(DATEDIFF(SECOND, ja.start_execution_date, GETDATE())) AS value FROM msdb.dbo.sysjobactivity ja WHERE ja.start_execution_date IS NOT NULL AND ja.stop_execution_date IS NULL AND ja.session_id = (SELECT MAX(session_id) FROM msdb.dbo.sysjobactivity)",
      "alwaysAlert": false,
      "primaryChannel": null,
      "sendEmail": false,
      "includeInDailySummary": false,
      "escalate": false,
      "escalationThresholdEvents": 0,
      "escalationWindowMinutes": 0,
      "escalationAfterMinutes": 0,
      "escalationChannel": null,
      "nextAlertDelayMinutes": 0,
      "baselineDeviationPercent": 0,
      "baselineQueryId": null,
      "baselineSeries": null,
      "canBaseline": true,
      "requiresOnPrem": false
    }
  ]
}
